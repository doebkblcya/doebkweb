---
import type { UIStrings } from "../types/i18n";
interface Props { t: UIStrings; currentPath: string; }
const { t, currentPath } = Astro.props;
const lang = Astro.currentLocale || "zh";
const modes = ["light", "dark", "auto"] as const;
---
<div class="settings">
  <button id="settings-toggle" class="settings-toggle" aria-label={t.common.settings} aria-haspopup="dialog">
    {t.common.settings}
  </button>
  <dialog id="settings-dialog" aria-labelledby="settings-title">
    <h2 id="settings-title">{t.common.settings}</h2>
    <p class="settings-label">{t.theme.appearance}</p>
    <div class="settings-options">{modes.map(mode => <button class="theme-chip" data-mode={mode} aria-pressed="false">{t.theme[mode]}</button>)}</div>
    <p class="settings-label">{t.common.language}</p>
    <div class="settings-options">
      <a href={currentPath.replace(/^\/(zh|en)(?=\/|$)/, "/zh")} aria-current={lang === "zh" ? "true" : undefined}>中文</a>
      <a href={currentPath.replace(/^\/(zh|en)(?=\/|$)/, "/en")} aria-current={lang === "en" ? "true" : undefined}>English</a>
    </div>
  </dialog>
</div>
<script>
  const dialog = document.querySelector<HTMLDialogElement>("#settings-dialog")!;
  const toggle = document.querySelector<HTMLButtonElement>("#settings-toggle")!;
  const system = matchMedia("(prefers-color-scheme: dark)");
  // The native dialog's top layer is independent of the mobile drawer transform.
  toggle.addEventListener("click", () => dialog.showModal());
  dialog.addEventListener("click", event => {
    if (event.target !== dialog) return;
    const rect = dialog.getBoundingClientRect();
    if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
  });
  function applyTheme() {
    let stored: string | null = null;
    try { stored = localStorage.getItem("doebk-theme"); } catch { /* storage unavailable */ }
    const mode = stored === "light" || stored === "dark" ? stored : "auto";
    const theme = mode === "auto" ? (system.matches ? "dark" : "light") : mode;
    document.documentElement.dataset.themeMode = mode;
    document.documentElement.dataset.theme = theme;
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute("content", theme === "dark" ? "#000000" : "#fcfcfd");
    dialog.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(button => button.setAttribute("aria-pressed", String(button.dataset.mode === mode)));
  }
  dialog.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(button => button.addEventListener("click", () => {
    try { localStorage.setItem("doebk-theme", button.dataset.mode!); } catch { /* use the current choice without persistence */
      document.documentElement.dataset.themeMode = button.dataset.mode;
      document.documentElement.dataset.theme = button.dataset.mode === "auto" ? (system.matches ? "dark" : "light") : button.dataset.mode;
      dialog.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(item => item.setAttribute("aria-pressed", String(item === button)));
      return;
    }
    applyTheme();
  }));
  system.addEventListener("change", applyTheme);
  window.addEventListener("storage", applyTheme);
  window.addEventListener("pageshow", () => { if (dialog.open) dialog.close(); applyTheme(); });
  applyTheme();
</script>
<style>
  .settings-toggle { display: flex; align-items: center; width: 100%; min-height: 2.75rem; padding: 0; text-align: left; font-size: var(--text-sm); color: var(--color-text-secondary); cursor: pointer; border: 0; border-top: 1px solid var(--color-border-light); background: transparent; transition: color 150ms ease, background 150ms ease; }
  .settings-toggle:hover, .settings-toggle:focus-visible { color: var(--color-accent); background: var(--color-bg-muted); }
  dialog { width: min(25rem, calc(100vw - 2.5rem)); margin: auto; padding: 1.75rem; color: var(--color-text-primary); background: var(--color-bg-page); border: 1px solid var(--color-border); }
  :global(body:has(#settings-dialog[open])) { overflow: hidden; }
  #settings-title { font-size: 1.5rem; }
  .settings-label { margin: 1.5rem 0 0.75rem; color: var(--color-text-tertiary); font-size: var(--text-sm); }
  .settings-options { display: flex; gap: 0.5rem; }
  .settings-options button, .settings-options a { flex: 1; padding: 0.65rem 0.5rem; border: 1px solid var(--color-border-light); color: var(--color-text-secondary); background: transparent; text-align: center; text-decoration: none; cursor: pointer; }
  .settings-options [aria-pressed="true"], .settings-options [aria-current="true"] { color: var(--color-accent); border-color: currentColor; }
  @media (prefers-reduced-motion: reduce) { .settings-toggle { transition: none; } }
</style>
