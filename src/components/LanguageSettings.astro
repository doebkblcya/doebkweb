---
import type { UIStrings } from "../types/i18n";

interface Props {
  t: UIStrings;
  currentPath: string;
}

const { t, currentPath } = Astro.props;
const currentLang = Astro.currentLocale || "zh";

const options = [
  { lang: "zh", label: "中文" },
  { lang: "en", label: "English" },
];
---

<div class="lang-settings" id="lang-settings">
  <button class="lang-toggle" aria-label="语言设置" aria-expanded="false">
    <svg class="gear-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <circle cx="12" cy="12" r="3"/>
      <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
    </svg>
    <span class="lang-toggle-label">{t.common.settings}</span>
  </button>

  <ul class="lang-dropdown">
    {options.map((opt) => {
      const targetPath = currentPath.replace(`/${currentLang}/`, `/${opt.lang}/`);
      return (
        <li>
          <a
            href={targetPath}
            hreflang={opt.lang}
            class={`lang-option${opt.lang === currentLang ? " is-current" : ""}`}
          >
            {opt.label}
          </a>
        </li>
      );
    })}
  </ul>
</div>

<script>
  (function () {
    var container = document.getElementById("lang-settings");
    if (!container) return;
    // Guard on the DOM element itself so re-insertion re-initializes
    if (container.dataset.langReady === "1") return;
    container.dataset.langReady = "1";

    var toggle = container.querySelector(".lang-toggle");

      toggle?.addEventListener("click", function () {
        var open = container.classList.toggle("open");
        toggle.setAttribute("aria-expanded", String(open));
      });

      // Close on outside click
      document.addEventListener("click", function (e) {
        if (container && !container.contains(e.target)) {
          container.classList.remove("open");
          toggle?.setAttribute("aria-expanded", "false");
        }
      });
  })();
</script>

<style>
  .lang-settings {
    position: relative;
  }

  /* ── Toggle button ──────────────────────────── */
  .lang-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-3) var(--space-3);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius-md);
    transition:
      color 200ms,
      background-color 200ms;
  }

  .lang-toggle:hover {
    color: var(--color-text-primary);
    background: var(--color-accent-subtle);
  }

  .gear-icon {
    flex-shrink: 0;
    opacity: 0.65;
    transition: opacity 200ms;
  }

  .lang-toggle:hover .gear-icon {
    opacity: 1;
  }

  .lang-toggle-label {
    transition: opacity 250ms 100ms;
  }

  /* ── Dropdown ───────────────────────────────── */
  .lang-dropdown {
    position: absolute;
    bottom: 100%;
    left: 0;
    margin-bottom: var(--space-2);
    min-width: 8rem;
    padding: var(--space-1);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    transform: translateY(4px);
    pointer-events: none;
    transition:
      opacity 200ms,
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .open .lang-dropdown {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .lang-option {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius-md);
    transition:
      color 150ms,
      background-color 150ms;
  }

  .lang-option:hover {
    color: var(--color-text-primary);
    background: var(--color-accent-subtle);
  }

  .lang-option.is-current {
    color: var(--color-accent);
  }
</style>
