---
import type { UIStrings } from "../types/i18n";

interface Props {
  t: UIStrings;
  currentPath: string;
}

const { t, currentPath } = Astro.props;
const currentLang = Astro.currentLocale || "zh";

const langOptions = [
  { lang: "zh", label: "中文" },
  { lang: "en", label: "English" },
];
---

<div class="lang-settings" id="lang-settings">
  <button class="lang-toggle" aria-label={t.common.settings} aria-expanded="false">
    <svg class="gear-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="3"/>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
    </svg>
  </button>
</div>

<!-- Settings modal — rendered at root level for centered overlay -->
<div class="settings-overlay" id="settings-overlay" hidden>
  <div class="settings-modal" id="settings-modal">
    <!-- Language -->
    <div class="settings-section">
      <span class="settings-label">语言</span>
      <div class="settings-row">
        {langOptions.map((opt) => {
          const targetPath = currentPath.replace(`/${currentLang}/`, `/${opt.lang}/`);
          return (
            <a
              href={targetPath}
              hreflang={opt.lang}
              class={`settings-chip${opt.lang === currentLang ? " is-active" : ""}`}
            >
              {opt.label}
            </a>
          );
        })}
      </div>
    </div>

    <!-- Appearance:三段式 浅色/深色/自动。is-active 由 __vt_setTheme → syncThemeUI 维护 -->
    <div class="settings-section theme-section">
      <span class="settings-label">{t.theme.appearance}</span>
      <div class="settings-row">
        {["light", "dark", "auto"].map((mode) => (
          <button
            type="button"
            class="settings-chip theme-chip"
            data-mode={mode}
            onclick={`window.__vt_setTheme('${mode}')`}
          >
            {t.theme[mode as keyof typeof t.theme] as string}
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var container = document.getElementById("lang-settings");
    if (!container) return;
    if (container.dataset.langReady === "1") return;
    container.dataset.langReady = "1";

    var toggle = container.querySelector<HTMLButtonElement>(".lang-toggle");
    var overlay = document.getElementById("settings-overlay");

    function open() {
      if (!overlay || !toggle) return;
      overlay.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
    }

    function close() {
      if (!overlay || !toggle) return;
      overlay.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
    }

    toggle?.addEventListener("click", function () {
      if (overlay) overlay.hidden ? open() : close();
    });

    // Close on backdrop click
    overlay?.addEventListener("click", function (e) {
      if (e.target === overlay) close();
    });

    // Close on Escape
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && overlay && !overlay.hidden) close();
    });
  })();
</script>

<style>
  .lang-settings {
    position: relative;
  }

  /* ── Toggle button ──────────────────────────── */
  .lang-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin: 0 auto;
    border: none;
    background: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    color: var(--color-text-tertiary);
    transition: color 200ms, background 200ms;
  }

  .lang-toggle:hover {
    color: var(--color-text-primary);
    background: var(--color-accent-subtle);
  }

  /* ── Overlay ────────────────────────────────── */
  .settings-overlay {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 200ms ease-out;
    pointer-events: none;
  }

  .settings-overlay:not([hidden]) {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Modal card ─────────────────────────────── */
  .settings-modal {
    width: 18rem;
    padding: var(--space-6);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    transform: scale(0.95) translateY(8px);
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .settings-overlay:not([hidden]) .settings-modal {
    transform: scale(1) translateY(0);
  }

  /* ── Sections ───────────────────────────────── */
  .settings-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .theme-section {
    margin-top: var(--space-5);
  }

  .settings-label {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-primary);
    flex-shrink: 0;
  }

  .settings-row {
    display: flex;
    gap: 2px;
  }

  /* ── Chips ──────────────────────────────────── */
  .settings-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-1) var(--space-3);
    border: none;
    background: none;
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    font-family: inherit;
    color: var(--color-text-secondary);
    text-decoration: none;
    cursor: pointer;
    transition: color 150ms, background 150ms;
  }

  .settings-chip:hover {
    color: var(--color-text-primary);
    background: var(--color-accent-subtle);
  }

  .settings-chip.is-active {
    color: var(--color-accent);
    font-weight: 600;
    background: var(--color-accent-subtle);
  }
</style>
