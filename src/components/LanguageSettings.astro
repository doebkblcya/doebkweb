---
import type { UIStrings } from "../types/i18n";

interface Props {
  t: UIStrings;
  currentPath: string;
}

const { t, currentPath } = Astro.props;
const currentLang = Astro.currentLocale || "zh";

const langOptions = [
  { lang: "zh", label: "中文" },
  { lang: "en", label: "English" },
];
---

<div class="lang-settings" id="lang-settings">
  <!-- inline onclick(VT-safe):侧栏每页重建,元素级 addEventListener 会绑到旧元素导致新元素点不了 -->
  <button class="lang-toggle" aria-label={t.common.settings} aria-expanded="false" onclick="window.__vt_toggleSettings()">
    <svg class="gear-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="3"/>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
    </svg>
  </button>
</div>

<!-- Settings modal — rendered at root level for centered overlay。
     onclick 关闭遮罩;弹窗内部 stopPropagation 防冒泡误关 -->
<div class="settings-overlay" id="settings-overlay" hidden onclick="window.__vt_closeSettings()">
  <div class="settings-modal" id="settings-modal" onclick="event.stopPropagation()">
    <!-- Language -->
    <div class="settings-section">
      <span class="settings-label">语言</span>
      <div class="settings-row">
        {langOptions.map((opt) => {
          const targetPath = currentPath.replace(`/${currentLang}/`, `/${opt.lang}/`);
          return (
            <a
              href={targetPath}
              hreflang={opt.lang}
              class={`settings-chip${opt.lang === currentLang ? " is-active" : ""}`}
            >
              {opt.label}
            </a>
          );
        })}
      </div>
    </div>

    <!-- Appearance:三段式 浅色/深色/自动。is-active 由 __vt_setTheme → syncThemeUI 维护 -->
    <div class="settings-section theme-section">
      <span class="settings-label">{t.theme.appearance}</span>
      <div class="settings-row">
        {["light", "dark", "auto"].map((mode) => (
          <button
            type="button"
            class="settings-chip theme-chip"
            data-mode={mode}
            onclick={`window.__vt_setTheme('${mode}')`}
          >
            {t.theme[mode as keyof typeof t.theme] as string}
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  import { animate, spring } from "motion";

  // 齿轮/遮罩点击经 inline onclick 走 window 函数(VT-safe,CLAUDE.md 约定):
  // 侧栏每页重建,元素级 addEventListener 绑在旧元素上,新元素点击无监听
  declare global {
    interface Window {
      __vt_toggleSettings: () => void;
      __vt_closeSettings: () => void;
      __vt_settingsKeydown: (e: KeyboardEvent) => void;
    }
  }

  (function () {
    var container = document.getElementById("lang-settings");
    if (!container) return;
    if (container.dataset.langReady === "1") return;
    container.dataset.langReady = "1";

    // window 函数每次取最新 DOM(即使脚本未重跑,首载版本也操作当前元素)
    function getOverlay() { return document.getElementById("settings-overlay"); }
    function getModal() { return document.getElementById("settings-modal"); }
    function getToggle() {
      var ls = document.getElementById("lang-settings");
      return ls ? ls.querySelector<HTMLButtonElement>(".lang-toggle") : null;
    }

    // 弹窗 pop:modal 的 opacity/scale/y 由 Motion spring 驱动(可中断,快速开关直接转向)。
    // CSS 只留基础态值与 :not([hidden]) 目标值、无 transition(见 .settings-modal 样式注释);
    // 动画结束清 inline 落回 CSS 目标值。overlay 背景淡入仍由 CSS transition 负责。
    var MODAL_SPRING = { type: spring, stiffness: 380, damping: 32, reduceMotion: true };
    var modalAnim: ReturnType<typeof animate> | null = null;

    function open() {
      var overlay = getOverlay();
      var toggle = getToggle();
      if (!overlay || !toggle) return;
      overlay.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
      var modal = getModal();
      if (modal) {
        if (modalAnim) modalAnim.stop();
        // 显式初值:CSS :not([hidden]) 无 transition 已瞬时到终值(scale 1/opacity 1),
        // Motion 读当前值会读到终值导致 from==to 无动画——先设 inline 初值再动画
        modal.style.opacity = "0";
        modal.style.transform = "scale(0.95) translateY(8px)";
        modalAnim = animate(modal, { opacity: 1, scale: 1, y: 0 }, MODAL_SPRING);
        modalAnim.finished.then(function () {
          if (modal && overlay && !overlay.hidden) { modal.style.opacity = ""; modal.style.transform = ""; }
        }).catch(function () {});
      }
    }

    function close() {
      var overlay = getOverlay();
      var toggle = getToggle();
      if (!overlay || !toggle) return;
      toggle.setAttribute("aria-expanded", "false");
      var modal = getModal();
      if (modal) {
        if (modalAnim) modalAnim.stop();
        modalAnim = animate(modal, { opacity: 0, scale: 0.95, y: 8 }, MODAL_SPRING);
        modalAnim.finished.then(function () {
          // 动画结束再隐藏 overlay(若期间被重开则 finished 已中断,不会走到这里)
          if (overlay) overlay.hidden = true;
          if (modal) { modal.style.opacity = ""; modal.style.transform = ""; }
        }).catch(function () {});
      } else {
        overlay.hidden = true;
      }
    }

    // inline onclick 入口:齿轮 toggle,遮罩关闭
    window.__vt_toggleSettings = function () {
      var overlay = getOverlay();
      if (!overlay) return;
      overlay.hidden ? open() : close();
    };
    window.__vt_closeSettings = function () {
      close();
    };

    // Close on Escape(remove-before-add:侧栏每次切页重建,脚本重跑,防监听器累积)
    if (window.__vt_settingsKeydown) document.removeEventListener("keydown", window.__vt_settingsKeydown);
    window.__vt_settingsKeydown = function (e: KeyboardEvent) {
      var overlay = getOverlay();
      if (e.key === "Escape" && overlay && !overlay.hidden) close();
    };
    document.addEventListener("keydown", window.__vt_settingsKeydown);
  })();
</script>

<style>
  .lang-settings {
    position: relative;
  }

  /* ── Toggle button ──────────────────────────── */
  .lang-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin: 0 auto;
    border: none;
    background: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    color: var(--color-text-tertiary);
    transition: color 200ms, background 200ms;
  }

  .lang-toggle:hover {
    color: var(--color-text-primary);
    background: var(--color-accent-subtle);
  }

  /* ── Overlay ────────────────────────────────── */
  .settings-overlay {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 200ms ease-out;
    pointer-events: none;
  }

  .settings-overlay:not([hidden]) {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Modal card ─────────────────────────────── */
  .settings-modal {
    width: 18rem;
    padding: var(--space-6);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    transform: scale(0.95) translateY(8px);
    /* opacity/transform 由 Motion spring 驱动(JS inline),
       本块为基础态值、下块为打开态目标值,均无 transition */
  }

  .settings-overlay:not([hidden]) .settings-modal {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  /* ── Sections ───────────────────────────────── */
  .settings-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .theme-section {
    margin-top: var(--space-5);
  }

  .settings-label {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-primary);
    flex-shrink: 0;
  }

  .settings-row {
    display: flex;
    gap: 2px;
  }

  /* ── Chips ──────────────────────────────────── */
  .settings-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-1) var(--space-3);
    border: none;
    background: none;
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    font-family: inherit;
    color: var(--color-text-secondary);
    text-decoration: none;
    cursor: pointer;
    transition: color 150ms, background 150ms;
  }

  .settings-chip:hover {
    color: var(--color-text-primary);
    background: var(--color-accent-subtle);
  }

  .settings-chip.is-active {
    color: var(--color-accent);
    font-weight: 600;
    background: var(--color-accent-subtle);
  }
</style>
