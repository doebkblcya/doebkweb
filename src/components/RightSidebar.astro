---
import type { UIStrings } from "../types/i18n";
import ProfileBrief from "./ProfileBrief.astro";
import MusicPlayer from "./MusicPlayer.astro";

interface Props {
  t: UIStrings;
}

const { t } = Astro.props;
---

<aside class="right-sidebar" id="right-sidebar">
  <div class="right-sidebar-inner">
    <ProfileBrief t={t} />
    <MusicPlayer />
  </div>
</aside>

<script>
  const sidebar = document.getElementById("right-sidebar");
  const root = document.documentElement;
  let timeout: ReturnType<typeof setTimeout>;

  function expand() {
    clearTimeout(timeout);
    sidebar?.classList.remove("collapsed");
    root.style.setProperty("--right-sidebar-width", "16rem");
  }

  function collapse() {
    timeout = setTimeout(() => {
      sidebar?.classList.add("collapsed");
      root.style.setProperty("--right-sidebar-width", "4rem");
    }, 300);
  }

  sidebar?.addEventListener("mouseenter", expand);
  sidebar?.addEventListener("mouseleave", collapse);

  // Start collapsed
  sidebar?.classList.add("collapsed");
  root.style.setProperty("--right-sidebar-width", "4rem");
</script>

<style>
  .right-sidebar {
    --sidebar-collapsed: 4rem;
    --sidebar-expanded: 16rem;

    position: fixed;
    top: 0;
    right: 0;
    width: var(--sidebar-expanded);
    height: 100vh;
    z-index: 100;
    display: flex;
    flex-direction: column;
    padding: var(--space-6) var(--space-4);
    border-left: 1px solid var(--color-border-light);
    background: var(--color-bg-page);
    transition: width 400ms cubic-bezier(0.22, 0.61, 0.36, 1);
    overflow: hidden;
    white-space: nowrap;
  }

  .right-sidebar.collapsed {
    width: var(--sidebar-collapsed);
    padding: var(--space-6) var(--space-2);
  }

  .right-sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  @media (max-width: 768px) {
    .right-sidebar {
      display: none;
    }
  }
</style>
