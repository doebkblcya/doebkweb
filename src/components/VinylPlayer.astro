---
interface Props {
  flatTracks: string;
  r2Base: string;
}
const { flatTracks: flatTracksJson, r2Base } = Astro.props;
---

<div class="vinyl-app" id="vinyl-app" data-astro-transition-persist="vinyl-player">
  <!-- Trigger: mini disc -->
  <button class="vinyl-trigger" id="vinyl-trigger" aria-label="音乐">
    <div class="mini-disc" id="mini-disc">
      <div class="mini-disc-art" id="mini-disc-art"></div>
    </div>
  </button>

  <!-- Expanded panel -->
  <div class="vinyl-panel" id="vinyl-panel">
    <div class="panel-inner">
      <!-- Album cover disc -->
      <div class="player-disc-wrap" id="player-disc-wrap">
        <!-- Tonearm(absolute 相对 wrap:百分比定位,唱片缩小时自动等比,pivot 保持在唱片右缘外侧) -->
        <div class="tonearm" id="tonearm">
          <svg width="120" height="180" viewBox="0 0 120 180" fill="none">
            <!-- Pivot base at top-right of disc -->
            <rect x="85" y="22" width="30" height="20" rx="5" fill="#636366"/>
            <rect x="90" y="16" width="20" height="9" rx="3" fill="#7a7a7e"/>
            <!-- Counterweight -->
            <circle cx="100" cy="32" r="9" fill="#48484a"/>
            <!-- Arm: from pivot extending down-left toward record surface -->
            <line x1="100" y1="35" x2="24" y2="148" stroke="#aeaeb2" stroke-width="5" stroke-linecap="round"/>
            <!-- Headshell at record end -->
            <g transform="translate(10, 135) rotate(-10)">
              <rect x="0" y="0" width="30" height="14" rx="3" fill="#1d1d1f"/>
              <rect x="4" y="3" width="22" height="2.5" rx="1" fill="#333"/>
              <!-- Stylus needle pointing onto record -->
              <line x1="22" y1="14" x2="24" y2="20" stroke="#86868b" stroke-width="1.5" stroke-linecap="round"/>
            </g>
          </svg>
        </div>

        <div class="player-disc" id="player-disc">
          <!-- Groove rings -->
          <div class="disc-grooves"></div>
          <!-- Cover label area -->
          <div class="disc-cover-art" id="disc-cover-art">
            <div class="cover-placeholder" id="cover-placeholder">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round">
                <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="2" x2="12" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/>
              </svg>
            </div>
          </div>
          <!-- Label ring -->
          <div class="disc-label-ring"></div>
        </div>
      </div>

      <!-- Now playing info -->
      <div class="player-info">
        <h3 class="player-track-title" id="player-track-title">未在播放</h3>
        <p class="player-album-name" id="player-album-name"></p>
        <p class="player-artist" id="player-artist"></p>
      </div>

      <!-- Action buttons -->
      <div class="player-actions visible" id="player-actions">
        <!-- Transport controls — show only when album loaded -->
        <span class="actions-group" id="actions-transport">
          <button class="action-btn" id="btn-prev" title="上一首">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="18,4 6,12 18,20"/><rect x="4" y="4" width="2" height="16"/></svg>
          </button>
          <button class="action-btn action-btn-play" id="btn-playpause" title="播放">
            <svg class="icon-play" id="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="6,3 20,12 6,21"/></svg>
            <svg class="icon-pause" id="icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
          </button>
          <button class="action-btn" id="btn-next" title="下一首">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="6,4 18,12 6,20"/><rect x="18" y="4" width="2" height="16"/></svg>
          </button>
        </span>
        <span class="actions-sep" id="actions-sep"></span>
        <!-- Info buttons — show only when album loaded -->
        <span class="actions-group" id="actions-info">
          <button class="action-btn" id="btn-playlist" title="播放列表">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
              <circle cx="4" cy="6" r="1.5" fill="currentColor" stroke="none"/><circle cx="4" cy="12" r="1.5" fill="currentColor" stroke="none"/><circle cx="4" cy="18" r="1.5" fill="currentColor" stroke="none"/>
            </svg>
          </button>
          <button class="action-btn" id="btn-review" title="札记">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
          </button>
        </span>
        <span class="actions-sep" id="actions-sep2"></span>
        <!-- Volume -->
        <span class="volume-wrap" id="volume-wrap">
          <button class="action-btn" id="btn-volume" title="音量">
            <svg id="icon-volume-high" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
            </svg>
            <svg id="icon-volume-low" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:none">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
            </svg>
            <svg id="icon-volume-mute" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:none">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/>
            </svg>
          </button>
          <input type="range" class="volume-slider" id="volume-slider" min="0" max="100" value="80" />
        </span>
        <!-- Shelf button — distinct, always visible in panel -->
        <a class="action-btn" id="btn-shelf" href="/zh/music/" title="专辑架">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <rect x="2" y="2" width="20" height="20" rx="2"/>
            <circle cx="8" cy="8" r="2"/><circle cx="16" cy="8" r="2"/>
            <circle cx="8" cy="16" r="2"/><circle cx="16" cy="16" r="2"/>
          </svg>
          <span>专辑架</span>
        </a>
      </div>

      <!-- Track list panel -->
      <div class="player-tracks" id="player-tracks">
        <ul class="track-list" id="track-list">
          <!-- Populated by JS -->
        </ul>
      </div>

      <!-- Review panel -->
      <div class="player-review" id="player-review">
        <p class="review-text" id="review-text"></p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ flatTracksJson, r2Base }}>
  (function () {
    // ═══════════════════════════════════════════════════════
    //  All music state lives on #audio (the only persisted element).
    //  VinylPlayer is a pure rendering layer — it reads from
    //  #audio on init and writes to #audio on user actions.
    // ═══════════════════════════════════════════════════════

    var R2_BASE = r2Base;
    var flatTracks = JSON.parse(flatTracksJson);

    // ── UI-only state (persists across pages, reset on home) ──
    var panelOpen = false;
    var tracksOpen = false;
    var reviewOpen = false;

    // ── State accessors (read from #audio, the single source of truth) ──
    function _audio() { return document.getElementById("audio"); }
    function _playing() { var a = _audio(); return a && !a.paused; }
    function _idx() { var a = _audio(); if (!a || !a.dataset.vpIdx) return 0; return parseInt(a.dataset.vpIdx, 10) || 0; }
    function _albumCtx() {
      var a = _audio();
      if (!a || !a.dataset.vpAlbum) return null;
      return {
        name: a.dataset.vpAlbum,
        artist: a.dataset.vpArtist || "",
        cover: a.dataset.vpCover || "",
        tracks: flatTracks.filter(function (t) { return t.album === a.dataset.vpAlbum; }),
        meta: null,
      };
    }
    function _tracks() { var ctx = _albumCtx(); return ctx ? ctx.tracks : flatTracks; }

    // ── DOM refs (always fresh) ──────────────────────────
    function els() {
      return {
        audio:      document.getElementById("audio"),
        trigger:    document.getElementById("vinyl-trigger"),
        panel:      document.getElementById("vinyl-panel"),
        playerDisc: document.getElementById("player-disc"),
        discCoverArt:  document.getElementById("disc-cover-art"),
        miniDisc:   document.getElementById("mini-disc"),
        miniDiscArt:   document.getElementById("mini-disc-art"),
        tonearm:    document.getElementById("tonearm"),
        albumName:  document.getElementById("player-album-name"),
        artist:     document.getElementById("player-artist"),
        trackTitle: document.getElementById("player-track-title"),
        actionsTransport: document.getElementById("actions-transport"),
        actionsSep:     document.getElementById("actions-sep"),
        actionsInfo:    document.getElementById("actions-info"),
        btnPrev:        document.getElementById("btn-prev"),
        btnPlaypause:   document.getElementById("btn-playpause"),
        iconPlay:       document.getElementById("icon-play"),
        iconPause:      document.getElementById("icon-pause"),
        btnNext:        document.getElementById("btn-next"),
        btnPlaylist:    document.getElementById("btn-playlist"),
        btnReview:      document.getElementById("btn-review"),
        btnVolume:      document.getElementById("btn-volume"),
        volumeWrap:     document.getElementById("volume-wrap"),
        volumeSlider:   document.getElementById("volume-slider"),
        iconVolHigh:    document.getElementById("icon-volume-high"),
        iconVolLow:     document.getElementById("icon-volume-low"),
        iconVolMute:    document.getElementById("icon-volume-mute"),
        btnShelf:       document.getElementById("btn-shelf"),
        trackList:      document.getElementById("track-list"),
        playerTracks:   document.getElementById("player-tracks"),
        playerReview:   document.getElementById("player-review"),
        reviewText:     document.getElementById("review-text"),
      };
    }

    // ── Helpers ─────────────────────────────────────────
    function buildUrl(track) {
      if (track.url) return track.url;
      var album = track.album || (_albumCtx() && _albumCtx().name) || "";
      return R2_BASE + "/" + encodeURIComponent(album) + "/" + encodeURIComponent(track.file);
    }
    function escHtml(s) {
      return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }

    // ── UI mutators ─────────────────────────────────────
    function updateInfo(i) {
      var e = els(), tracks = _tracks(), t = tracks[i];
      if (!t || !e.trackTitle) return;
      e.trackTitle.textContent = t.title;
      var ctx = _albumCtx();
      if (ctx && e.albumName) e.albumName.textContent = ctx.name;
      else if (e.albumName) e.albumName.textContent = t.album || "";
      if (ctx && e.artist) e.artist.textContent = ctx.artist;
      else if (e.artist) e.artist.textContent = "";
    }

    function setCover(url) {
      var e = els();
      if (!e.discCoverArt || !e.miniDiscArt) return;
      if (url) {
        e.discCoverArt.style.backgroundImage = "url(" + url + ")";
        e.discCoverArt.classList.add("has-cover");
        e.miniDiscArt.style.backgroundImage = "url(" + url + ")";
        e.miniDiscArt.classList.add("has-cover");
      } else {
        e.discCoverArt.style.backgroundImage = "";
        e.discCoverArt.classList.remove("has-cover");
        e.miniDiscArt.style.backgroundImage = "";
        e.miniDiscArt.classList.remove("has-cover");
      }
    }

    function setReview(text) {
      var e = els();
      if (!e.reviewText) return;
      if (text) {
        e.reviewText.textContent = text;
        if (e.btnReview) e.btnReview.style.display = "inline-flex";
      } else {
        e.reviewText.textContent = "";
        if (e.btnReview) e.btnReview.style.display = "none";
      }
    }

    function renderTrackList() {
      var e = els(), tracks = _tracks();
      if (!e.trackList) return;
      if (tracks.length === 0) { e.trackList.innerHTML = ""; return; }
      var ctx = _albumCtx();
      e.trackList.innerHTML = tracks.map(function (t, i) {
        return '<li class="track-item"><button class="track-btn" data-index="' + i + '">' +
          '<span class="track-num">' + String(i + 1).padStart(2, "0") + '</span>' +
          '<span class="track-body"><span class="track-title"><span class="tt-runner">' +
          '<span class="tt-item">' + escHtml(t.title) + '</span><span class="tt-item">' + escHtml(t.title) + '</span>' +
          '</span></span>' +
          (ctx ? '' : '<span class="track-album">' + escHtml(t.album || "") + '</span>') +
          '</span><span class="track-status"><span class="track-eq">' +
          '<span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span>' +
          '</span></span></button></li>';
      }).join("");
      updateTrackUI();
    }

    function applyPlayingState(state) {
      var e = els();
      if (e.playerDisc) e.playerDisc.classList.toggle("spinning", state);
      if (e.tonearm) e.tonearm.classList.toggle("on-record", state);
      if (e.miniDisc) e.miniDisc.classList.toggle("spinning", state);
      if (e.iconPlay) e.iconPlay.style.display = state ? "none" : "block";
      if (e.iconPause) e.iconPause.style.display = state ? "block" : "none";
      if (e.btnPlaypause) e.btnPlaypause.setAttribute("title", state ? "暂停" : "播放");
      updateTrackUI();
    }

    function updateTrackUI() {
      var e = els();
      if (!e.trackList) return;
      var p = _playing(), cur = _idx();
      var btns = e.trackList.querySelectorAll(".track-btn");
      for (var i = 0; i < btns.length; i++) {
        var idx = parseInt(btns[i].dataset.index || "-1", 10);
        btns[i].classList.toggle("is-active", idx === cur && p);
      }
    }

    function showAlbumUI() {
      var e = els();
      // 容器 span 一并恢复(flex 行内零宽 item 会占 gap 把其余按钮顶偏)
      if (e.actionsInfo) e.actionsInfo.style.display = "flex";
      if (e.volumeWrap) e.volumeWrap.style.display = "flex";
      if (e.actionsTransport) e.actionsTransport.style.display = "flex";
      if (e.actionsSep) e.actionsSep.style.display = "inline-block";
      if (e.btnPlaylist) e.btnPlaylist.style.display = "inline-flex";
      if (e.btnVolume) e.btnVolume.style.display = "inline-flex";
      if (e.volumeSlider) e.volumeSlider.style.display = "block";
      var sep2 = document.getElementById("actions-sep2");
      if (sep2) sep2.style.display = "inline-block";
      // btnReview is controlled by setReview(), not shown unconditionally
    }

    // ── Volume ────────────────────────────────────────
    function syncVolumeUI() {
      var e = els(), a = _audio();
      var vol = a ? a.volume : 0.8;
      var muted = a ? a.muted : false;
      if (e.volumeSlider) e.volumeSlider.value = String(Math.round(vol * 100));
      if (e.iconVolHigh) e.iconVolHigh.style.display = (!muted && vol > 0.5) ? "block" : "none";
      if (e.iconVolLow) e.iconVolLow.style.display = (!muted && vol <= 0.5 && vol > 0) ? "block" : "none";
      if (e.iconVolMute) e.iconVolMute.style.display = (muted || vol === 0) ? "block" : "none";
    }

    function _wireVolume() {
      var e = els(), a = _audio(); if (!a) return;
      // 默认音量 0.7，localStorage["doebk-volume"] 持久化用户调整（与主题存储模式一致）
      var vol = 0.7;
      try {
        var saved = localStorage.getItem("doebk-volume");
        if (saved !== null) {
          var sv = parseFloat(saved);
          if (!Number.isNaN(sv) && sv >= 0 && sv <= 1) vol = sv;
        }
      } catch { /* 隐私模式 */ }
      a.volume = vol;
      if (e.volumeSlider) {
        e.volumeSlider.addEventListener("input", function () {
          var v = parseInt(e.volumeSlider.value, 10) / 100;
          if (a) { a.volume = v; a.muted = false; }
          try { localStorage.setItem("doebk-volume", String(v)); } catch { /* 忽略 */ }
          syncVolumeUI();
        });
      }
      if (e.btnVolume) {
        e.btnVolume.addEventListener("click", function (ev) {
          ev.stopPropagation();
          if (a) { a.muted = !a.muted; }
          syncVolumeUI();
        });
      }
      syncVolumeUI();
    }

    // ── Panel controls ──────────────────────────────────
    function toggleTracks() {
      var e = els();
      tracksOpen = !tracksOpen;
      if (e.playerTracks) e.playerTracks.classList.toggle("open", tracksOpen);
      if (e.btnPlaylist) e.btnPlaylist.classList.toggle("is-active", tracksOpen);
      if (tracksOpen && reviewOpen) toggleReview();
    }
    function toggleReview() {
      var e = els();
      reviewOpen = !reviewOpen;
      if (e.playerReview) e.playerReview.classList.toggle("open", reviewOpen);
      if (e.btnReview) e.btnReview.classList.toggle("is-active", reviewOpen);
      if (reviewOpen && tracksOpen) toggleTracks();
    }
    function closeSubPanels() { if (tracksOpen) toggleTracks(); if (reviewOpen) toggleReview(); }
    // 面板弹入/收起:opacity+scale 由 Motion spring 驱动(可中断,快速开关直接转向)。
    // 动画实现挂 window.__vt_panelAnimate(独立 script 块)——本 script 带 define:vars
    // 会被内联输出,无法 import 包;动画结束后清 inline 落回 CSS 值。
    // CSS 已移除这两属性的 transition(见 .vinyl-panel 样式注释),.open class 负责
    // visibility 瞬时切换与 max-height 限高。
    function runPanelAnim(panel, open) {
      var anim = window.__vt_panelAnimate;
      if (!anim) return;
      anim(panel, open).finished.then(function () {
        if (panel) { panel.style.opacity = ""; panel.style.transform = ""; }
      }).catch(function () {});
    }

    function openPanel() {
      var e = els();
      panelOpen = true;
      if (e.panel) {
        e.panel.classList.add("open");
        // 显式初值:CSS .open 无 transition 已瞬时到终值(opacity 1),
        // Motion 读当前值会读到终值导致 from==to 无动画——先设 inline 初值再动画
        e.panel.style.opacity = "0";
        runPanelAnim(e.panel, true);
      }
      if (e.trigger) e.trigger.classList.add("hidden");
      applyPlayingState(_playing());
      var ctx = _albumCtx();
      if (ctx) { setCover(ctx.cover); renderTrackList(); }
    }
    function closePanel() {
      var e = els();
      panelOpen = false;
      if (e.panel) {
        // 先播收起动画,结束后移除 .open(class 移除后 visibility 回 hidden,
        // CSS 基础态 opacity 0/scale 0.3 与动画终值一致,无跳变)
        var anim = window.__vt_panelAnimate;
        if (anim) {
          anim(e.panel, false).finished.then(function () {
            if (e.panel && !panelOpen) e.panel.classList.remove("open");
          }).catch(function () {});
        } else {
          e.panel.classList.remove("open");
        }
      }
      if (e.trigger) e.trigger.classList.remove("hidden");
      closeSubPanels();
    }

    // ── Load & play ─────────────────────────────────────
    function loadTrack(i) {
      var tracks = _tracks(), t = tracks[i];
      if (!t) return;
      var a = _audio(); if (!a) return;
      a.dataset.vpIdx = String(i);
      a.src = buildUrl(t);
      updateInfo(i);
      a.dispatchEvent(new CustomEvent("track-change", {
        detail: { albumName: t.album || (_albumCtx() && _albumCtx().name) || "", trackTitle: t.title, trackIndex: i },
        bubbles: false,
      }));
    }
    function play() {
      var a = _audio(); if (!a) return;
      if (!a.src) { var tr = _tracks(); if (tr.length) loadTrack(0); }
      a.play().catch(function () {});
    }

    // ── Click handlers ──────────────────────────────────
    function handleVinylClick(e) {
      var E = els();
      // Trigger
      if (e.target.closest("#vinyl-trigger")) { e.stopPropagation(); panelOpen ? closePanel() : openPanel(); return; }
      // Play/pause
      if (e.target.closest("#btn-playpause")) { e.stopPropagation(); if (!E.audio || !E.audio.src) return; _playing() ? E.audio.pause() : E.audio.play().catch(function(){}); return; }
      // Prev
      if (e.target.closest("#btn-prev")) { e.stopPropagation(); var tr = _tracks(); if (tr.length) { var p = _idx() > 0 ? _idx() - 1 : tr.length - 1; loadTrack(p); play(); } return; }
      // Next
      if (e.target.closest("#btn-next")) { e.stopPropagation(); var tr2 = _tracks(); if (tr2.length) { var n = (_idx() + 1) % tr2.length; loadTrack(n); play(); } return; }
      // Track btn
      var tb = e.target.closest(".track-btn");
      if (tb) { var idx = parseInt(tb.dataset.index || "0", 10); if (idx === _idx()) { _playing() ? E.audio.pause() : E.audio.play().catch(function(){}); } else { loadTrack(idx); play(); } return; }
      // Shelf
      if (e.target.closest("#btn-shelf")) { e.preventDefault(); e.stopPropagation(); var sf = document.getElementById("shelf"); if (sf) { if (panelOpen) closePanel(); sf.scrollIntoView({behavior:"smooth"}); } else { if (panelOpen) closePanel(); var href = els().btnShelf ? els().btnShelf.getAttribute("href") : "/zh/music/"; window.location.href = href; } return; }
      // Playlist
      if (e.target.closest("#btn-playlist")) { e.stopPropagation(); toggleTracks(); return; }
      // Review
      if (e.target.closest("#btn-review")) { e.stopPropagation(); toggleReview(); return; }
    }
    function handleDocClick(e) {
      if (!panelOpen) return;
      var E = els();
      if (!E.panel || !E.trigger) return;
      if (!E.panel.contains(e.target) && !E.trigger.contains(e.target)) closePanel();
    }

    // ── Audio event listeners ────────────────────────────
    var _onAudioPlay, _onAudioPause, _onAudioEnded, _onAlbumChange, _onTrackChange;

    function wireAudio() {
      var a = _audio(); if (!a) return;

      _onAudioPlay   = function () { applyPlayingState(true); };
      _onAudioPause  = function () { applyPlayingState(false); };
      _onAudioEnded  = function () { var tr = _tracks(); if (tr.length) { loadTrack((_idx() + 1) % tr.length); play(); } };
      _onAlbumChange = function (ev) {
        var d = ev.detail;
        var ad = _audio(); if (!ad) return;
        ad.dataset.vpAlbum = d.albumName;
        ad.dataset.vpArtist = d.artist;
        ad.dataset.vpCover  = d.cover;
        setCover(d.cover); setReview(d.review || null); renderTrackList();
        var e = els();
        if (e.albumName) e.albumName.textContent = d.albumName;
        if (e.artist) e.artist.textContent = d.artist;
        if (e.trackTitle) e.trackTitle.textContent = "";
        showAlbumUI();
        loadTrack(0); play();
        if (!panelOpen) openPanel();
      };
      _onTrackChange = function (ev) {
        var d = ev.detail;
        if (typeof d.trackIndex === "number" && d.trackIndex >= 0) { updateInfo(d.trackIndex); updateTrackUI(); }
      };

      a.addEventListener("play", _onAudioPlay);
      a.addEventListener("pause", _onAudioPause);
      a.addEventListener("ended", _onAudioEnded);
      a.addEventListener("album-change", _onAlbumChange);
      a.addEventListener("track-change", _onTrackChange);
    }

    // ── Init ─────────────────────────────────────────────
    function init() {
      var app = document.getElementById("vinyl-app");
      if (!app || app.dataset.vinylReady === "1") return;
      app.dataset.vinylReady = "1";

      wireAudio();
      document.addEventListener("click", handleVinylClick);
      document.addEventListener("click", handleDocClick);

      // ── Track title hover scroll ──────────────────────
      // 悬停溢出的曲名启动左滚（marquee 双份文本无缝循环），移出停止
      document.addEventListener("mouseover", function (e) {
        var title = e.target.closest ? e.target.closest(".track-title") : null;
        if (!title) return;
        // 溢出判断用第一份 .tt-item（双份结构下 track-title.scrollWidth 是双份总宽，会误判）
        var item = title.querySelector(".tt-item");
        var overflows = !!(item && item.scrollWidth > title.clientWidth);
        title.classList.toggle("is-scroll", overflows);
      });
      document.addEventListener("mouseout", function (e) {
        var title = e.target.closest ? e.target.closest(".track-title") : null;
        if (!title) return;
        var related = e.relatedTarget;
        if (related && related.closest && related.closest(".track-title") === title) return; // 标题内部移动不停止
        title.classList.remove("is-scroll");
      });

      // Default: no album — transport/review/playlist hidden
      // 容器 span 也隐藏:零宽 flex item 在行内占 gap,会把唯一可见的专辑架按钮顶偏
      var e = els();
      if (e.actionsInfo) e.actionsInfo.style.display = "none";
      if (e.volumeWrap) e.volumeWrap.style.display = "none";
      if (e.actionsTransport) e.actionsTransport.style.display = "none";
      if (e.actionsSep) e.actionsSep.style.display = "none";
      if (e.btnPlaylist) e.btnPlaylist.style.display = "none";
      if (e.btnReview) e.btnReview.style.display = "none";
      if (e.btnVolume) e.btnVolume.style.display = "none";
      if (e.volumeSlider) e.volumeSlider.style.display = "none";
      var sep2 = document.getElementById("actions-sep2");
      if (sep2) sep2.style.display = "none";
      setCover("");
      setReview(null);
      renderTrackList();

      // Restore album UI from audio state
      var a = _audio();
      if (a && a.dataset.vpAlbum) {
        setCover(a.dataset.vpCover || "");
        if (e.albumName) e.albumName.textContent = a.dataset.vpAlbum;
        if (e.artist) e.artist.textContent = a.dataset.vpArtist || "";
        showAlbumUI();
      }

      _wireVolume();
      applyPlayingState(_playing());
    }

    init();
  })();
</script>

<!-- 面板弹入/收起 spring 动画 —— 独立 script 块:
     主 script 带 define:vars 会被内联输出(无法 import 包),动画实现放这里挂 window。
     主 script 同步先执行,用户点击时本函数已就绪;未定义时主 script 退化为瞬时 class 切换 -->
<script>
  import { animate } from "motion";

  declare global {
    interface Window {
      __vt_panelAnimate?: (panel: HTMLElement, open: boolean) => ReturnType<typeof animate>;
    }
  }

  window.__vt_panelAnimate = function (panel, open) {
    return animate(
      panel,
      open ? { opacity: 1 } : { opacity: 0 },
      // 纯渐变(tween):打开 220ms easeOutExpo + 100ms 延迟(等迷你碟 120ms 退场,错开重叠);
      // 关闭 180ms,更快(Apple 惯例:关闭快于打开)
      open
        ? { duration: 0.22, ease: [0.16, 1, 0.3, 1], delay: 0.1, reduceMotion: true }
        : { duration: 0.18, ease: "easeOut", reduceMotion: true }
    );
  };
</script>

