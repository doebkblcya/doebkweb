---
import type { UIStrings } from "../types/i18n";

interface Props {
  t: UIStrings;
}

const { t } = Astro.props;
---

<footer class="footer">
  <div class="footer-inner">
    <span class="copyright">&copy; {new Date().getFullYear()} {t.site.title}</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border-light);
    padding: var(--space-6) clamp(1.5rem, 5vw, 5rem);
  }

  .footer-inner {
    max-width: var(--max-width-wide);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .copyright {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    color: var(--color-text-tertiary);
  }
</style>
