---
import type { UIStrings } from "../types/i18n";
import LanguageSettings from "./LanguageSettings.astro";
interface Props { t: UIStrings; currentPath: string; }
const { t, currentPath } = Astro.props;
const lang = Astro.currentLocale || "zh";
const path = currentPath.replace(/^\/[a-z]{2}\//, "/");
const items = [
  { label: t.nav.home, href: "/" },
  { label: t.nav.about, href: "/about/" },
  { label: t.nav.docs, href: "/docs/" },
  { label: t.nav.music, href: "/music/" },
  { label: t.nav.photos, href: "/photos/" },
];
---
<aside class="sidebar" id="sidebar">
  <nav class="sidebar-nav" aria-label={t.nav.menu}>
    <ul class="nav-list">
      {items.map(item => {
        const active = item.href === "/" ? path === "/" : path.startsWith(item.href);
        return <li><a href={`/${lang}${item.href}`} class:list={["nav-item", { "is-active": active }]} aria-current={active ? "page" : undefined}>{item.label}</a></li>;
      })}
    </ul>
  </nav>
  <LanguageSettings t={t} currentPath={currentPath} />
</aside>
<button class="nav-trigger" id="nav-trigger" aria-label={t.nav.menu} aria-expanded="false" aria-controls="sidebar">
  <span></span><span></span><span></span>
</button>
<div class="nav-mask" id="nav-mask" aria-hidden="true"></div>
<script>
  const sidebar = document.querySelector<HTMLElement>("#sidebar")!;
  const trigger = document.querySelector<HTMLButtonElement>("#nav-trigger")!;
  const mask = document.querySelector<HTMLElement>("#nav-mask")!;
  const mobile = matchMedia("(max-width: 640px)");
  let open = false;
  function setOpen(value: boolean) {
    open = value && mobile.matches;
    sidebar.classList.toggle("is-open", open);
    sidebar.inert = mobile.matches && !open;
    trigger.setAttribute("aria-expanded", String(open));
    mask.classList.toggle("is-visible", open);
    document.body.classList.toggle("nav-lock", open);
    const content = document.querySelector<HTMLElement>(".content-area");
    if (content) content.inert = open;
  }
  trigger.addEventListener("click", () => {
    setOpen(!open);
    if (open) sidebar.querySelector<HTMLAnchorElement>("a")?.focus();
  });
  mask.addEventListener("click", () => { setOpen(false); trigger.focus(); });
  sidebar.querySelectorAll(".nav-item").forEach(link => link.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", event => {
    if (!open || document.querySelector("dialog[open]")) return;
    if (event.key === "Escape") { setOpen(false); trigger.focus(); }
    if (event.key === "Tab") {
      const nodes = [trigger, ...[...sidebar.querySelectorAll<HTMLElement>('a, button')].filter(node => node.getClientRects().length > 0)];
      const index = nodes.indexOf(document.activeElement as HTMLElement);
      if (index === -1 || (!event.shiftKey && index === nodes.length - 1) || (event.shiftKey && index === 0)) {
        event.preventDefault();
        nodes[event.shiftKey ? nodes.length - 1 : 0].focus();
      }
    }
  });
  mobile.addEventListener("change", () => setOpen(false));
  window.addEventListener("pageshow", () => setOpen(false));
  setOpen(false);
</script>
<style>
  .sidebar { position: fixed; inset: 0 auto 0 0; z-index: 100; width: 11rem; height: 100vh; height: 100dvh; display: flex; flex-direction: column; justify-content: space-between; padding: 1.75rem 1.5rem calc(1.75rem + env(safe-area-inset-bottom, 0px)); border-right: 1px solid var(--color-border-light); background: var(--color-bg-page); }
  .sidebar-nav { display: flex; align-items: center; flex: 1; }
  .nav-list { width: 100%; border-top: 1px solid var(--color-border-light); }
  .nav-list li { border-bottom: 1px solid var(--color-border-light); }
  .nav-item { display: flex; align-items: center; min-height: 2.75rem; position: relative; color: var(--color-text-secondary); text-decoration: none; font-size: var(--text-sm); transition: color 150ms ease, background 150ms ease; }
  .nav-item:hover, .nav-item:focus-visible { color: var(--color-accent); background: var(--color-bg-muted); }
  .nav-item.is-active { color: var(--color-accent); }
  .nav-item.is-active::before { content: ""; position: absolute; top: 0; bottom: 0; left: -1.5rem; border-left: 2px solid currentColor; }
  .nav-trigger { position: fixed; top: 0.75rem; left: 0.75rem; z-index: 120; width: 2.75rem; height: 2.75rem; display: none; flex-direction: column; align-items: center; justify-content: center; gap: 5px; border: 1px solid var(--color-border); background: var(--color-bg-page); cursor: pointer; }
  .nav-trigger span { width: 1.25rem; height: 1px; background: var(--color-text-primary); }
  .nav-mask { position: fixed; inset: 0; z-index: 95; background: rgb(0 0 0 / 35%); opacity: 0; pointer-events: none; transition: opacity 180ms ease; }
  .nav-mask.is-visible { opacity: 1; pointer-events: auto; }
  :global(body.nav-lock) { overflow: hidden; }
  @media (max-width: 640px) {
    .nav-trigger { display: flex; }
    .sidebar { padding-top: 4.5rem; transform: translateX(-100%); transition: transform 200ms ease; }
    .sidebar.is-open { transform: translateX(0); }
  }
  :global(body:not(.has-sidebar)) .nav-trigger, :global(body:not(.has-sidebar)) .nav-mask { display: none; }
  @media (prefers-reduced-motion: reduce) { .sidebar, .nav-mask, .nav-item { transition: none; } }
</style>
