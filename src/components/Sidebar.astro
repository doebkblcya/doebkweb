---
import type { UIStrings } from "../types/i18n";
import LanguageSettings from "./LanguageSettings.astro";

interface Props {
  t: UIStrings;
  currentPath: string;
}

const { t, currentPath } = Astro.props;

const navItems: { label: string; href: string }[] = [
  { label: t.nav.home,   href: "/" },
  { label: t.nav.about,  href: "/about/" },
  { label: t.nav.docs,   href: "/docs/" },
  { label: t.nav.music,  href: "/music/" },
  { label: t.nav.photos, href: "/photos/" },
];

const lang = Astro.currentLocale || "zh";

function isActive(itemHref: string): boolean {
  const path = currentPath.replace(/^\/[a-z]{2}\//, "/");
  if (itemHref === "/") return path === "/";
  return path.startsWith(itemHref);
}
---

<aside class="sidebar" id="sidebar" transition:persist="sidebar">
  <nav class="sidebar-nav" aria-label="Main navigation">
    <ul class="nav-list" id="nav-list">
      <div class="nav-slider" id="nav-slider"></div>
      {navItems.map((item) => (
        <li>
          <a
            href={`/${lang}${item.href}`}
            class={`nav-item${isActive(item.href) ? " is-active" : ""}`}
          >
              <span class="nav-label">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="sidebar-bottom">
    <LanguageSettings t={t} currentPath={currentPath} />
  </div>
</aside>

<script>
  (function () {
    var sidebar = document.getElementById("sidebar");
    if (!sidebar) return;
    if (sidebar.dataset.sidebarReady === "1") return;
    sidebar.dataset.sidebarReady = "1";

    var slider = document.getElementById("nav-slider") as HTMLElement | null;
    var navList = document.getElementById("nav-list") as HTMLElement | null;

    function getItemOffset(item: HTMLElement) {
      if (!slider) return 0;
      return item.offsetTop + (item.offsetHeight - slider.offsetHeight) / 2;
    }

    function moveSliderTo(item: Element | null) {
      if (!slider || !item) return;
      slider.style.transform = "translateY(" + getItemOffset(item as HTMLElement) + "px)";
    }

    function moveToActive() {
      if (!navList) return;
      var active = navList.querySelector(".nav-item.is-active");
      if (active) moveSliderTo(active);
    }

    moveToActive();

    // Hover: slider follows cursor
    navList?.addEventListener("mouseover", function (e) {
      var target = e.target instanceof Element ? e.target : null;
      var item = target ? target.closest(".nav-item") : null;
      if (item) moveSliderTo(item);
    });

    navList?.addEventListener("mouseleave", function () {
      moveToActive();
    });

    document.addEventListener("astro:after-swap", function () {
      var sb = document.getElementById("sidebar");
      if (!sb) return;
      var path = window.location.pathname.replace(/^\/[a-z]{2}\//, "/");
      var links = sb.querySelectorAll(".nav-item");
      for (var i = 0; i < links.length; i++) {
        var href = links[i].getAttribute("href") || "";
        href = href.replace(/^\/[a-z]{2}\//, "/");
        var active = href === "/" ? path === "/" : path.startsWith(href);
        links[i].classList.toggle("is-active", active);
      }
      slider = document.getElementById("nav-slider") as HTMLElement | null;
      navList = document.getElementById("nav-list") as HTMLElement | null;
      moveToActive();
    });
  })();
</script>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 7.5rem;
    height: 100vh;
    z-index: 100;
    display: flex;
    flex-direction: column;
    padding: var(--space-6) var(--space-3);
    border-right: 1px solid var(--color-border-light);
    background: var(--color-bg-page);
    overflow: hidden;
    white-space: nowrap;
  }

  /* ── Nav: vertically centered ──────────────────── */
  .sidebar-nav {
    flex: 1;
    display: flex;
    align-items: center;
    position: relative;
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    width: 100%;
    position: relative;
  }

  /* ── Sliding background pill ──────────────────── */
  .nav-slider {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.875rem;
    background: var(--color-accent-subtle);
    border-radius: var(--radius-md);
    transition: transform 350ms cubic-bezier(0.22, 0.61, 0.36, 1);
    z-index: 0;
    pointer-events: none;
  }

  /* ── Nav items ─────────────────────────────────── */
  .nav-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-1);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius-md);
    text-decoration: none;
    position: relative;
    z-index: 1;
    transition: color 200ms;
    background: none;
  }

  .nav-item:hover {
    color: var(--color-text-primary);
  }

  .nav-item.is-active {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* ── Bottom / Settings ──────────────────────────── */
  .sidebar-bottom {
    padding-bottom: 0;
    overflow: visible;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .sidebar {
      display: none;
    }
  }
</style>
