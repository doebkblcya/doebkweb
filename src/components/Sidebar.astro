---
import type { UIStrings } from "../types/i18n";
import LanguageSettings from "./LanguageSettings.astro";

interface Props {
  t: UIStrings;
  currentPath: string;
}

const { t, currentPath } = Astro.props;

const navItems: { label: string; href: string }[] = [
  { label: t.nav.home,   href: "/" },
  { label: t.nav.about,  href: "/about/" },
  { label: t.nav.docs,   href: "/docs/" },
  { label: t.nav.music,  href: "/music/" },
  { label: t.nav.photos, href: "/photos/" },
];

const lang = Astro.currentLocale || "zh";

function isActive(itemHref: string): boolean {
  const path = currentPath.replace(/^\/[a-z]{2}\//, "/");
  if (itemHref === "/") return path === "/";
  return path.startsWith(itemHref);
}
---

<!-- 不 persist:侧栏文案/href 随语言渲染,VT 交换必须重建(切语言后 persist 会保留旧语言 DOM);
     重建后状态由 astro:after-swap 兜底:抽屉复位/滑块定位/主题恢复 -->
<aside class="sidebar" id="sidebar">
  <nav class="sidebar-nav" aria-label={t.nav.menu}>
    <ul class="nav-list" id="nav-list">
      <div class="nav-slider" id="nav-slider"></div>
      {navItems.map((item) => (
        <li>
          <a
            href={`/${lang}${item.href}`}
            class={`nav-item${isActive(item.href) ? " is-active" : ""}`}
          >
              <span class="nav-label">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="sidebar-bottom">
    <LanguageSettings t={t} currentPath={currentPath} />
  </div>
</aside>

<!-- Mobile nav: hamburger trigger + mask (≤640px only; 首页由 CSS 隐藏,自带大按钮) -->
<button
  class="nav-trigger"
  id="nav-trigger"
  aria-label={t.nav.menu}
  aria-expanded="false"
  aria-controls="sidebar"
  onclick="window.__vt_toggleNav()"
>
  <span class="nav-trigger-line"></span>
  <span class="nav-trigger-line"></span>
  <span class="nav-trigger-line"></span>
</button>
<div class="nav-mask" id="nav-mask" onclick="window.__vt_closeNav()" aria-hidden="true"></div>

<script>
  import { animate, spring } from "motion";

  // Mobile drawer 全局函数类型声明(本组件 script 是纯 TS 处理,需显式声明 window 扩展)
  declare global {
    interface Window {
      __vt_toggleNav: () => void;
      __vt_closeNav: (instant?: boolean) => void;
      __vt_drawerLinkClick?: (e: MouseEvent) => void;
      __vt_drawerKeydown?: (e: KeyboardEvent) => void;
      __vt_setTheme: (mode: "light" | "dark" | "auto") => void;
      __vt_applyTheme: () => void;
      __vt_systemThemeListener: () => void;
      __vt_afterSwap: () => void;
      __vt_navHover: (e: MouseEvent) => void;
      __vt_navLeave: (e: MouseEvent) => void;
    }
  }

  (function () {
    var sidebar = document.getElementById("sidebar");
    if (!sidebar) return;

    // 滑块函数内部每次取最新 DOM(document 委托与 after-swap 共用,侧栏重建后闭包变量会过时)
    function getSlider() { return document.getElementById("nav-slider") as HTMLElement | null; }
    function getNavList() { return document.getElementById("nav-list") as HTMLElement | null; }

    function getItemOffset(item: HTMLElement) {
      var slider = getSlider();
      if (!slider) return 0;
      return item.offsetTop + (item.offsetHeight - slider.offsetHeight) / 2;
    }

    function moveSliderTo(item: Element | null) {
      var slider = getSlider();
      if (!slider || !item) return;
      slider.style.transform = "translateY(" + getItemOffset(item as HTMLElement) + "px)";
    }

    function moveToActive(instant?: boolean) {
      var navList = getNavList();
      if (!navList) return;
      var active = navList.querySelector(".nav-item.is-active");
      if (!active) return;
      var slider = getSlider();
      if (!slider) return;
      var y = getItemOffset(active as HTMLElement);
      if (instant) {
        // VT 交换后新 DOM 滑块无 inline transform(CSS 态 = 顶部),
        // 直接赋值会触发 CSS transition 从顶部滑下——先禁过渡定位,reflow 后再恢复
        slider.style.transition = "none";
        slider.style.transform = "translateY(" + y + "px)";
        void slider.offsetHeight;
        slider.style.transition = "";
      } else {
        slider.style.transform = "translateY(" + y + "px)";
      }
    }

    moveToActive(true);

    // ── Mobile drawer (≤640px): hamburger trigger + mask ──
    // VT-safe: inline onclick 入口,window 函数,每次取最新 DOM
    // 抽屉滑入/滑出由 Motion spring 驱动(可中断,连点直接转向):
    //   CSS 的 transform transition 已移除(media query 内),动画结束清 inline 落回 class/CSS 态
    var NAV_SPRING = { type: spring, stiffness: 380, damping: 32, reduceMotion: true };
    var navAnim: ReturnType<typeof animate> | null = null;

    function navTo(sb: HTMLElement | null, target: string) {
      if (!sb) return;
      if (navAnim) navAnim.stop();
      // 显式 from:is-open class 切换无 transition 瞬时生效,CSS 已是目标值,
      // Motion 读当前值会读到目标值导致 from==to 无动画——先设 inline 初值再动画
      sb.style.transform = target === "translateX(0px)" ? "translateX(-100%)" : "translateX(0px)";
      navAnim = animate(sb, { transform: target }, NAV_SPRING);
      navAnim.finished.then(function () {
        // Motion 完成时会把终值写回 inline style(晚于 finished resolve),
        // 延迟一帧再清理,避免残留 translateX(-100%) 在桌面断点(>640px,无 CSS transform)把侧栏移出屏
        requestAnimationFrame(function () {
          if (sb) sb.style.transform = "";
        });
      }).catch(function () {});
    }

    window.__vt_toggleNav = function () {
      var sb = document.getElementById("sidebar");
      if (!sb) return;
      var open = !sb.classList.contains("is-open");
      sb.classList.toggle("is-open", open);
      var mask = document.getElementById("nav-mask");
      var trig = document.getElementById("nav-trigger");
      if (mask) mask.classList.toggle("is-visible", open);
      if (trig) trig.setAttribute("aria-expanded", open ? "true" : "false");
      document.body.classList.toggle("nav-lock", open);
      navTo(sb, open ? "translateX(0px)" : "translateX(-100%)");
    };
    window.__vt_closeNav = function (instant) {
      var sb = document.getElementById("sidebar");
      var mask = document.getElementById("nav-mask");
      var trig = document.getElementById("nav-trigger");
      if (sb) {
        sb.classList.remove("is-open");
        if (instant) {
          // VT 切页复位:不播动画,直接落回 CSS 基础态。
          // 勿用 stop():它把当前中间值异步写回 inline(晚于同步清空,盖回残留,实测侧栏停在中途),
          // 用 cancel()(取消,不写回当前值)再延迟一帧清一次,兜住任何异步写回
          if (navAnim) navAnim.cancel();
          sb.style.transform = "";
          requestAnimationFrame(function () {
            if (sb && !sb.classList.contains("is-open")) sb.style.transform = "";
          });
        } else {
          navTo(sb, "translateX(-100%)");
        }
      }
      if (mask) mask.classList.remove("is-visible");
      if (trig) trig.setAttribute("aria-expanded", "false");
      document.body.classList.remove("nav-lock");
    };
    // 点击导航链接后关闭抽屉(仅移动端)
    if (window.__vt_drawerLinkClick) document.removeEventListener("click", window.__vt_drawerLinkClick);
    window.__vt_drawerLinkClick = function (e: MouseEvent) {
      if (window.innerWidth > 640) return;
      var target = e.target instanceof Element ? e.target : null;
      if (target && target.closest(".nav-item")) window.__vt_closeNav();
    };
    document.addEventListener("click", window.__vt_drawerLinkClick);
    // Escape 关闭抽屉(remove-before-add 防累积)
    if (window.__vt_drawerKeydown) document.removeEventListener("keydown", window.__vt_drawerKeydown);
    window.__vt_drawerKeydown = function (e) {
      if (e.key === "Escape") window.__vt_closeNav();
    };
    document.addEventListener("keydown", window.__vt_drawerKeydown);

    // ── Theme:三段式 浅色/深色/自动 ──
    // 状态模型（与 BaseLayout head 内联脚本一致，见 AGENT.md）：
    //   localStorage["doebk-theme"] = light|dark|auto(缺省 auto,仅用户显式选择时写入)
    //   html[data-theme]      = 有效主题(驱动全部 CSS)
    //   html[data-theme-mode] = 用户模式(驱动 chips 高亮)
    var THEME_KEY = "doebk-theme";

    function resolveEffective(mode: "light" | "dark" | "auto"): "light" | "dark" {
      if (mode === "auto") {
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      return mode;
    }

    function syncThemeUI() {
      var doc = document.documentElement;
      var mode = doc.getAttribute("data-theme-mode") || "auto";
      var chips = document.querySelectorAll<HTMLElement>(".theme-chip");
      for (var i = 0; i < chips.length; i++) {
        var active = chips[i].getAttribute("data-mode") === mode;
        chips[i].classList.toggle("is-active", active);
        chips[i].setAttribute("aria-pressed", active ? "true" : "false");
      }
      // 移动端浏览器地址栏配色跟随主题(VT 交换 head 后 meta 会消失,必要时重建)
      var meta = document.querySelector('meta[name="theme-color"]');
      if (!meta) {
        meta = document.createElement("meta");
        meta.setAttribute("name", "theme-color");
        document.head.appendChild(meta);
      }
      meta.setAttribute("content", doc.dataset.page === "home" ? "#06182d" : doc.getAttribute("data-theme") === "dark" ? "#000000" : "#fcfcfd");
    }

    // 系统主题变化:仅更新有效主题,不动 localStorage 与模式
    window.__vt_systemThemeListener = function () {
      var doc = document.documentElement;
      if (doc.getAttribute("data-theme-mode") !== "auto") return;
      doc.setAttribute("data-theme", resolveEffective("auto"));
      syncThemeUI();
    };

    function attachSystemListener() {
      var mql = window.matchMedia("(prefers-color-scheme: dark)");
      if (mql.addEventListener) {
        mql.removeEventListener("change", window.__vt_systemThemeListener);
        mql.addEventListener("change", window.__vt_systemThemeListener);
      }
    }

    // 唯一状态变更入口:设置面板 chips / head 脚本共用
    window.__vt_setTheme = function (mode) {
      if (mode !== "light" && mode !== "dark" && mode !== "auto") return;
      try {
        localStorage.setItem(THEME_KEY, mode);
      } catch (e) {}
      var doc = document.documentElement;
      doc.setAttribute("data-theme", resolveEffective(mode));
      doc.setAttribute("data-theme-mode", mode);
      syncThemeUI();
      if (mode === "auto") attachSystemListener();
    };

    // 读存储 → 应用(html 属性 + UI 同步)。首帧由 head 内联脚本完成,
    // 这里负责 init 与 VT 交换后恢复——Astro 交换会把 html 属性同步成新文档的,运行时属性会被清掉
    window.__vt_applyTheme = function () {
      var mode: "light" | "dark" | "auto" = "auto";
      try {
        var s = localStorage.getItem(THEME_KEY);
        if (s === "light" || s === "dark") mode = s;
      } catch (e) {}
      var doc = document.documentElement;
      doc.setAttribute("data-theme", resolveEffective(mode));
      doc.setAttribute("data-theme-mode", mode);
      syncThemeUI();
      if (mode === "auto") attachSystemListener();
    };

    window.__vt_applyTheme();

    // Hover: slider follows cursor。document 级委托 + remove-before-add:
    // 侧栏每页重建,元素级 addEventListener 会绑到旧元素(与齿轮同源问题)
    if (window.__vt_navHover) document.removeEventListener("mouseover", window.__vt_navHover);
    window.__vt_navHover = function (e: MouseEvent) {
      var target = e.target instanceof Element ? e.target : null;
      if (!target || !target.closest("#nav-list")) return;
      var item = target.closest(".nav-item");
      if (item) moveSliderTo(item);
    };
    document.addEventListener("mouseover", window.__vt_navHover);
    // mouseout 冒泡(mouseleave 不冒泡,无法委托):relatedTarget 不在列表内才算移出
    if (window.__vt_navLeave) document.removeEventListener("mouseout", window.__vt_navLeave);
    window.__vt_navLeave = function (e: MouseEvent) {
      var target = e.target instanceof Element ? e.target : null;
      if (!target || !target.closest("#nav-list")) return;
      var rt = e.relatedTarget instanceof Element ? e.relatedTarget : null;
      if (rt && rt.closest("#nav-list")) return;
      moveToActive();
    };
    document.addEventListener("mouseout", window.__vt_navLeave);

    // 侧栏不再 persist,脚本每次 VT 交换后重跑(remove-before-add 防监听器累积)
    if (window.__vt_afterSwap) document.removeEventListener("astro:after-swap", window.__vt_afterSwap);
    window.__vt_afterSwap = function () {
      // VT 切页:重置抽屉关闭状态(instant:不播关闭动画)
      window.__vt_closeNav(true);
      // 恢复主题属性(交换清掉了 html 的 data-theme/data-theme-mode)
      window.__vt_applyTheme();
      var sb = document.getElementById("sidebar");
      if (!sb) return;
      var path = window.location.pathname.replace(/^\/[a-z]{2}\//, "/");
      var links = sb.querySelectorAll(".nav-item");
      for (var i = 0; i < links.length; i++) {
        var href = links[i].getAttribute("href") || "";
        href = href.replace(/^\/[a-z]{2}\//, "/");
        var active = href === "/" ? path === "/" : path.startsWith(href);
        links[i].classList.toggle("is-active", active);
      }
      // 新 DOM 滑块无初值,瞬时定位(带过渡会从顶部滑下)
      moveToActive(true);
    };
    document.addEventListener("astro:after-swap", window.__vt_afterSwap);
  })();
</script>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 7.5rem;
    height: 100vh;
    /* iOS Safari:100vh 含地址栏高度,底部(主题切换/设置)被遮不可见。
       dvh 动态视口随地址栏展开/收起实时适配,底部图标始终在可视区内 */
    height: 100dvh;
    z-index: 100;
    display: flex;
    flex-direction: column;
    padding: var(--space-6) var(--space-3);
    /* iPhone 全面屏底部 home indicator 避让(桌面环境 env() = 0,无影响) */
    padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    border-right: 1px solid var(--color-border-light);
    background: var(--color-bg-page);
    overflow: hidden;
    white-space: nowrap;
  }

  /* ── Nav: vertically centered ──────────────────── */
  .sidebar-nav {
    flex: 1;
    display: flex;
    align-items: center;
    position: relative;
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    width: 100%;
    position: relative;
  }

  /* ── Sliding background pill ──────────────────── */
  .nav-slider {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.875rem;
    background: var(--color-accent-subtle);
    border-radius: var(--radius-md);
    transition: transform 350ms cubic-bezier(0.22, 0.61, 0.36, 1);
    z-index: 0;
    pointer-events: none;
  }

  /* ── Nav items ─────────────────────────────────── */
  .nav-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-1);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius-md);
    text-decoration: none;
    position: relative;
    z-index: 1;
    transition: color 200ms;
    background: none;
  }

  .nav-item:hover {
    color: var(--color-text-primary);
  }

  .nav-item.is-active {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* ── Bottom / Settings ──────────────────────────── */
  .sidebar-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: 0;
    overflow: visible;
    flex-shrink: 0;
  }

  /* ── Mobile nav trigger (hamburger) ──────────── */
  .nav-trigger {
    position: fixed;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 120;
    width: 2.75rem;
    height: 2.75rem;
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    cursor: pointer;
    padding: 0;
    /* 抽屉打开时淡出隐藏(见 media query 内 [aria-expanded="true"] 规则) */
    transition: opacity 200ms ease;
  }

  .nav-trigger-line {
    width: 1.25rem;
    height: 1.5px;
    background: var(--color-text-primary);
    border-radius: 1px;
    flex-shrink: 0;
  }

  /* 遮罩:内容之上(z 95)、侧栏(z 100)之下,点击关闭 */
  .nav-mask {
    position: fixed;
    inset: 0;
    z-index: 95;
    background: rgba(0, 0, 0, 0.35);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  .nav-mask.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  body.nav-lock {
    overflow: hidden;
  }

  /* 640 断点:真手机侧栏变抽屉(汉堡接管);iPad 竖屏(768)保留完整侧栏 */
  @media (max-width: 640px) {
    .nav-trigger {
      display: flex;
    }

    /* 抽屉打开时汉堡图标淡出隐藏;关闭时立即恢复(visibility 的延迟 transition
       只写在 true 态:visible→hidden 等淡出完再隐藏,hidden→visible 立即)。
       aria-expanded 由 __vt_toggleNav/__vt_closeNav 维护,VT 切页复位自动还原 */
    .nav-trigger[aria-expanded="true"] {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 200ms ease, visibility 0s linear 200ms;
    }

    .sidebar {
      transform: translateX(-100%);
      /* transform 由 Motion spring 驱动(JS inline),CSS 只留基础态值,勿加 transition */
      box-shadow: 8px 0 30px rgba(0, 0, 0, 0.15);
    }

    .sidebar.is-open {
      transform: translateX(0);
    }
  }

  /* 首页(body 无 has-sidebar):汉堡与遮罩均隐藏——首页自带大按钮导航 */
  body:not(.has-sidebar) .nav-trigger,
  body:not(.has-sidebar) .nav-mask {
    display: none;
  }
</style>

<style>
  /* Archival navigation layer: typographic, ruled and deliberately flat. */
  .sidebar {
    width: 11rem;
    padding: 1.75rem 1.5rem calc(1.75rem + env(safe-area-inset-bottom, 0px));
    border-color: var(--color-border-light);
    background: var(--color-bg-page);
  }

  .sidebar-nav { align-items: center; }

  .nav-list {
    gap: 0;
    border-top: 1px solid var(--color-border-light);
  }

  .nav-list li { border-bottom: 1px solid var(--color-border-light); }

  .nav-slider {
    left: -1.5rem;
    right: -1.5rem;
    height: 2.75rem;
    border-left: 2px solid var(--color-accent);
    border-radius: 0;
    background: var(--color-accent-subtle);
    transition: transform 320ms var(--ease-gallery);
  }

  .nav-item {
    justify-content: flex-start;
    min-height: 2.75rem;
    padding: 0;
    border-radius: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.015em;
  }

  .nav-item.is-active { color: var(--color-text-primary); font-weight: 600; }

  .sidebar-bottom {
    flex-direction: row;
    justify-content: flex-start;
    gap: 0;
    border-top: 1px solid var(--color-border-light);
    padding-top: var(--space-2);
  }

  .nav-trigger {
    top: 1rem;
    left: 1rem;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-border);
    border-radius: 0;
    background: var(--color-bg-page);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .nav-trigger-line { width: 1.15rem; height: 1px; border-radius: 0; }

  .nav-mask { background: rgba(0, 0, 0, 0.55); backdrop-filter: blur(3px); }

  @media (max-width: 640px) {
    .sidebar {
      width: min(78vw, 18rem);
      padding: 1.75rem 1.5rem calc(1.75rem + env(safe-area-inset-bottom, 0px));
      box-shadow: none;
      border-right-color: var(--color-border);
    }
  }
</style>
