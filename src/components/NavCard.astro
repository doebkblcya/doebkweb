---
interface Props {
  href: string;
  title: string;
  description: string;
  icon: string;
}

const { href, title, description, icon } = Astro.props;
---

<a class="nav-card" href={href}>
  <span class="nav-card-icon" aria-hidden="true">{icon}</span>
  <div class="nav-card-text">
    <h3 class="nav-card-title">{title}</h3>
    <p class="nav-card-desc">{description}</p>
  </div>
</a>

<style>
  .nav-card {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
    transition:
      transform var(--duration-fast),
      box-shadow var(--duration-fast),
      border-color var(--duration-fast);
    /* Interactive press: slightly scale down on press */
    transform: scale(1);
  }

  .nav-card:hover {
    transform: scale(1.01);
    box-shadow: var(--shadow-md);
    border-color: var(--color-border);
  }

  .nav-card:active {
    transform: scale(var(--press-scale));
  }

  .nav-card-icon {
    font-size: var(--text-2xl);
    line-height: 1;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-subtle);
    border-radius: var(--radius-lg);
  }

  .nav-card-title {
    font-size: var(--text-base);
    font-weight: 600;
    margin-bottom: var(--space-1);
    letter-spacing: var(--tracking-normal);
    line-height: var(--leading-snug);
  }

  .nav-card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
</style>
