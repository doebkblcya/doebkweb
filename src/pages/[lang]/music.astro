---
export { getStaticPaths } from "./_getStaticPaths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { albums as rawAlbums, getTrackUrl } from "../../data/playlist";

import { ui as zh } from "../../i18n/zh";
import { ui as en } from "../../i18n/en";

const lang = Astro.currentLocale || "zh";
const t = lang === "zh" ? zh : en;

const albums = [...rawAlbums]
  .map((a, i) => ({ ...a, _idx: i }))
  .sort((a, b) => a.name.localeCompare(b.name, "zh"));

const dataJson = JSON.stringify({
  albums: rawAlbums.map((a, i) => ({
    _idx: i,
    name: a.name,
    artist: a.artist,
    cover: a.cover,
    review: a.review || null,
    meta: a.meta || null,
    tracks: a.tracks.map(tr => ({
      title: tr.title,
      album: a.name,
      file: tr.file,
      url: getTrackUrl({ ...tr, album: a.name }),
    })),
  })),
  i18n: {
    searchPlaceholder: t.music.searchPlaceholder,
    sortAlbum: t.music.sortAlbum,
    sortArtist: t.music.sortArtist,
    noResults: t.music.noResults,
  },
});
---

<BaseLayout title={t.music.title} hideFooter>
  <div class="page">
    <h1 class="page-title">{t.music.title}</h1>
    <hr class="page-divider" />

    <div class="toolbar">
      <div class="search-wrap">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          id="search-input"
          class="search-input"
          type="search"
          placeholder={t.music.searchPlaceholder}
          autocomplete="off"
          oninput="window.__vt_musicSearch(this.value)"
        />
      </div>
      <div class="sort-group" role="group" aria-label={lang === "zh" ? "排序方式" : "Sort by"}>
        <svg class="sort-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="6" x2="20" y2="6"/>
          <line x1="4" y1="12" x2="16" y2="12"/>
          <line x1="4" y1="18" x2="12" y2="18"/>
        </svg>
        <button class="sort-option is-active" onclick="window.__vt_musicSort(this, 'album')">{t.music.sortAlbum}</button>
        <span class="sort-sep" aria-hidden="true">·</span>
        <button class="sort-option" onclick="window.__vt_musicSort(this, 'artist')">{t.music.sortArtist}</button>
      </div>
    </div>

    {albums.length === 0 ? (
      <div class="empty-state">
        <p>{t.music.emptyList}</p>
      </div>
    ) : (
      <div class="shelf" id="shelf" onclick="window.__vt_musicAlbumClick(event)">
        {albums.map((album) => (
          <div class="album-sleeve" data-idx={album._idx}>
            <!-- Card: cover + vinyl -->
            <button class="sleeve-card" data-album={album._idx} aria-label={`${album.name} — ${album.artist}`}>
              <div class="sleeve-inner">
                <!-- Vinyl disc behind cover -->
                <div class="vinyl-disc">
                  <div class="vinyl-center"></div>
                </div>
                <!-- Cover on top -->
                <div class="sleeve-cover">
                  <img
                    class="cover-img"
                    src={album.cover}
                    alt={album.name}
                    loading="lazy"
                    onerror={`this.style.display='none';this.parentElement.classList.add('no-img')`}
                  />
                  <div class="cover-fallback">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round">
                      <circle cx="12" cy="12" r="10"/>
                      <circle cx="12" cy="12" r="3"/>
                    </svg>
                  </div>
                </div>
              </div>
            </button>

            <!-- Info -->
            <div class="sleeve-info">
              <h2 class="sleeve-name">{album.name}</h2>
              <p class="sleeve-artist">{album.artist}</p>
            </div>
          </div>
        ))}
      </div>
    )}

    <div class="no-results" id="no-results" style="display:none">
      <p>{t.music.noResults}</p>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ dataJson }}>
  var DATA = JSON.parse(dataJson);
  var ALBUMS = DATA.albums;

  window.__vt_musicSort = function (btn, mode) {
    // Update active state
    document.querySelectorAll(".sort-option").forEach(function (b) { b.classList.remove("is-active"); });
    btn.classList.add("is-active");
    // Save current sort/query
    window.__vt_musicSortMode = mode;
    window.__vt_musicRender();
  };

  window.__vt_musicSearch = function (val) {
    window.__vt_musicQuery = val.trim();
    window.__vt_musicRender();
  };

  window.__vt_musicRender = function () {
    var arr = ALBUMS.slice();
    // Filter
    var q = (window.__vt_musicQuery || "").toLowerCase();
    if (q) {
      arr = arr.filter(function (a) {
        if (a.name.toLowerCase().indexOf(q) !== -1) return true;
        if (a.artist.toLowerCase().indexOf(q) !== -1) return true;
        return a.tracks.some(function (t) { return t.title.toLowerCase().indexOf(q) !== -1; });
      });
    }
    // Sort
    var mode = window.__vt_musicSortMode || "album";
    arr.sort(function (a, b) {
      if (mode === "artist") return a.artist.localeCompare(b.artist, "zh");
      return a.name.localeCompare(b.name, "zh");
    });

    var shelf = document.getElementById("shelf");
    var noResults = document.getElementById("no-results");
    if (!shelf) return;

    if (arr.length === 0) {
      shelf.style.display = "none";
      if (noResults) noResults.style.display = "block";
      return;
    }
    shelf.style.display = "";
    if (noResults) noResults.style.display = "none";

    var visible = {};
    for (var i = 0; i < arr.length; i++) { visible[arr[i]._idx] = true; }
    for (var i = 0; i < arr.length; i++) {
      var sleeve = shelf.querySelector('.album-sleeve[data-idx="' + arr[i]._idx + '"]');
      if (sleeve) { sleeve.style.display = ""; shelf.appendChild(sleeve); }
    }
    var all = shelf.querySelectorAll(".album-sleeve");
    for (var i = 0; i < all.length; i++) {
      var sidx = parseInt(all[i].getAttribute("data-idx") || "-1", 10);
      if (!visible[sidx]) all[i].style.display = "none";
    }
  };

  window.__vt_musicAlbumClick = function (e) {
    var card = e.target.closest(".sleeve-card");
    if (!card) return;
    e.preventDefault();
    // 阻止冒泡到 document：handleDocClick 会把刚打开的面板误关（"点击面板外即关"逻辑）
    e.stopPropagation();
    var ai = parseInt(card.getAttribute("data-album") || "0", 10);
    var a = ALBUMS[ai];
    if (!a) return;
    var audio = document.getElementById("audio");
    if (!audio) return;
    audio.dispatchEvent(new CustomEvent("album-change", {
      detail: { albumName: a.name, artist: a.artist, cover: a.cover, review: a.review, meta: a.meta, tracks: a.tracks },
      bubbles: false,
    }));
  };
</script>

<style>
  /* ── Toolbar ─────────────────────────────────── */
  .toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
    flex-wrap: wrap;
  }

  /* ── Search ──────────────────────────────────── */
  .search-wrap {
    position: relative;
    flex: 1;
    min-width: 180px;
    max-width: 320px;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--color-text-tertiary);
  }

  .search-input {
    width: 100%;
    padding: 8px 14px 8px 36px;
    border: none;
    border-radius: var(--radius-full);
    background: var(--color-bg-page);
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    outline: none;
    transition: background 200ms, box-shadow 200ms;
    font-family: inherit;
  }

  .search-input::placeholder {
    color: var(--color-text-tertiary);
  }

  .search-input:focus {
    background: var(--color-bg-surface);
    box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.15);
  }

  /* WebKit search input reset */
  .search-input::-webkit-search-decoration,
  .search-input::-webkit-search-cancel-button,
  .search-input::-webkit-search-results-button,
  .search-input::-webkit-search-results-decoration {
    -webkit-appearance: none;
  }

  /* ── Sort ─────────────────────────────────────── */
  .sort-group {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .sort-icon {
    color: var(--color-text-tertiary);
    flex-shrink: 0;
    margin-right: 2px;
  }

  .sort-option {
    padding: 4px 6px;
    border: none;
    background: none;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    font-family: inherit;
    color: var(--color-text-tertiary);
    cursor: pointer;
    transition: color 150ms;
    white-space: nowrap;
  }

  .sort-option:hover {
    color: var(--color-text-secondary);
  }

  .sort-option.is-active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .sort-sep {
    color: var(--color-border);
    font-size: var(--text-sm);
    user-select: none;
  }

  /* ── No results ──────────────────────────────── */
  .no-results {
    text-align: center;
    padding: var(--space-16) 0;
    color: var(--color-text-tertiary);
    font-size: var(--text-lg);
  }

  /* ── Page ────────────────────────────────────── */
  .page {
    padding: var(--space-16) var(--space-8) var(--space-24);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-16) 0;
    color: var(--color-text-tertiary);
    font-size: var(--text-lg);
  }

  /* ── Shelf grid ────────────────────────────────── */
  .shelf {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-12) var(--space-8);
  }

  /* ── Album sleeve ──────────────────────────────── */
  .album-sleeve {
    display: flex;
    flex-direction: column;
    padding: 0 var(--space-4);
  }

  /* ── Card (cover + vinyl) ──────────────────────── */
  .sleeve-card {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    background: none;
    border: none;
    cursor: pointer;
    perspective: 800px;
    padding: 0;
  }

  .sleeve-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
  }

  /* ── Vinyl disc behind cover ───────────────────── */
  .vinyl-disc {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle at 35% 35%,
      #2a2a2a 0%, #111 3%, #1a1a1a 5%, #0d0d0d 7%,
      #1a1a1a 9%, #0a0a0a 12%, #181818 14%, #0d0d0d 17%,
      #161616 19%, #0a0a0a 22%, #171717 24%, #0d0d0d 27%,
      #151515 29%, #0a0a0a 32%, #171717 34%, #0d0d0d 37%,
      #141414 39%, #0a0a0a 42%, #161616 44%, #0d0d0d 47%,
      #141414 49%, #0a0a0a 52%, #151515 54%, #0d0d0d 57%,
      #131313 59%, #0a0a0a 62%, #151515 64%, #0d0d0d 67%,
      #131313 69%, #0a0a0a 72%, #141414 74%, #0d0d0d 77%,
      #121212 79%
    );
    box-shadow:
      0 4px 30px rgba(0,0,0,0.3),
      0 0 0 1px rgba(255,255,255,0.03);
    transform: translateX(0);
    opacity: 0;
    transition:
      transform 500ms cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 300ms;
  }

  .vinyl-center {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 22%;
    height: 22%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle at 40% 40%, #e44 0%, #c33 100%);
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.3);
  }

  /* ── Cover on top ──────────────────────────────── */
  .sleeve-cover {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-md);
    transform: translateX(0);
    transition:
      transform 500ms cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 500ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sleeve-cover.no-img {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sleeve-cover.no-img .cover-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-border);
  }

  .cover-fallback {
    display: none;
  }

  /* ── Hover: vinyl slides out ───────────────────── */
  .sleeve-card:hover .vinyl-disc {
    transform: translateX(36%);
    opacity: 1;
  }

  .sleeve-card:hover .sleeve-cover {
    transform: translateX(-14%);
    box-shadow:
      0 8px 40px rgba(0,0,0,0.25),
      0 0 0 1px rgba(0,0,0,0.06);
  }

  .sleeve-card:active .sleeve-cover {
    transform: translateX(-14%) scale(0.98);
    transition: transform 100ms;
  }

  /* ── Info ──────────────────────────────────────── */
  .sleeve-info {
    margin-top: var(--space-4);
    padding: 0 var(--space-1);
  }

  .sleeve-name {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 200ms;
  }

  .sleeve-artist {
    margin-top: 2px;
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 200ms;
  }

  /* ── Mobile ────────────────────────────────────── */
  @media (max-width: 640px) {
    .shelf {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: var(--space-8) var(--space-6);
    }
  }
</style>
