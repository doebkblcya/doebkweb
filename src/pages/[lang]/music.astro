---
export { getStaticPaths } from "./_getStaticPaths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AlbumSelection from "../../components/AlbumSelection.astro";
import { albums as collection } from "../../data/albums";
import { ui as zh } from "../../i18n/zh";
import { ui as en } from "../../i18n/en";
const lang = Astro.currentLocale || "zh";
const t = lang === "zh" ? zh : en;
const albums = [...collection].sort((a, b) => a.name.localeCompare(b.name, lang));
---

<BaseLayout title={t.music.title} description={t.music.description} hideFooter>
  <div class="page records-page" data-locale={lang}>
    <h1 class="page-title">{t.music.title}</h1>
    <hr class="page-divider" />
    {albums.length === 0 ? <p class="empty-state">{t.music.emptyList}</p> : <>
      <div class="toolbar records-view-toolbar">
        <div class="view-toggle" role="group" aria-label={t.music.viewLabel}>
          <button class="view-option" data-record-view="selection" aria-pressed="true" aria-controls="album-selection">{t.music.viewSelection}</button>
          <span class="view-sep" aria-hidden="true">·</span>
          <button class="view-option" data-record-view="shelf" aria-pressed="false" aria-controls="album-shelf-panel">{t.music.viewShelf}</button>
        </div>
      </div>
      <AlbumSelection albums={albums} t={t.music} />
      <section id="album-shelf-panel" class="shelf-panel" aria-label={t.music.viewShelf} hidden>
        <div class="toolbar">
          <div class="search-wrap">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input id="album-search" class="search-input" type="search" placeholder={t.music.searchPlaceholder} aria-label={t.music.searchPlaceholder} autocomplete="off" />
          </div>
          <div class="sort-group" role="group" aria-label={t.music.sortLabel}>
            <svg class="sort-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="16" y2="12"/><line x1="4" y1="18" x2="12" y2="18"/></svg>
            <button class="sort-option" data-sort="name" aria-pressed="true">{t.music.sortAlbum}</button>
            <span class="sort-sep" aria-hidden="true">·</span>
            <button class="sort-option" data-sort="artist" aria-pressed="false">{t.music.sortArtist}</button>
          </div>
        </div>
        <div class="shelf" id="album-shelf">
          {albums.map(album => <article class="album" id={album.id} data-name={album.name} data-artist={album.artist} data-search={`${album.name} ${album.artist} ${album.review} ${(album.genres || []).join(" ")}`}>
            <button class="album-trigger" aria-label={`${album.name} — ${album.artist} · ${t.music.details}`} aria-haspopup="dialog" aria-controls={`album-dialog-${album.id}`}>
              <span class="cover"><img src={album.thumb || album.cover} alt={`${album.name} — ${album.artist}`} width="360" height="360" loading="lazy" decoding="async" /></span>
            </button>
            <div class="album-heading">
              <h2>{album.name}</h2><p>{album.artist}</p>
            </div>
          </article>)}
        </div>
        <p id="album-no-results" class="empty-state" hidden role="status">{t.music.noResults}</p>
      </section>
      <noscript><style is:inline>#album-shelf-panel[hidden] { display: block; } .records-view-toolbar { display: none; }</style></noscript>
      {albums.map(album => <dialog class="album-dialog" id={`album-dialog-${album.id}`} aria-labelledby={`album-title-${album.id}`} autofocus>
        <div class="album-detail">
          <div class="detail-cover"><img data-src={album.cover} alt={`${album.name} — ${album.artist}`} width="1000" height="1000" decoding="async" /></div>
          <div class="detail-body">
            <header class="detail-heading">
              <h2 id={`album-title-${album.id}`}>{album.name}</h2>
              <p class="detail-artist">{album.artist}</p>
            </header>
            <dl class="album-meta">
              {album.released && <div><dt>{t.music.released}</dt><dd><time datetime={album.released}>{album.released}</time></dd></div>}
              {!!album.genres?.length && <div><dt>{t.music.genres}</dt><dd>{album.genres.join(" / ")}</dd></div>}
              {album.label && <div><dt>{t.music.label}</dt><dd>{album.label}</dd></div>}
            </dl>
            {album.review && <section class="review"><h3>{t.music.review}</h3><p>{album.review}</p></section>}
            {album.appleMusicUrl && <footer class="playback"><span>{t.music.play}</span><div><a href={album.appleMusicUrl} target="_blank" rel="noopener noreferrer">Apple Music <span aria-hidden="true">↗</span></a></div></footer>}
          </div>
        </div>
      </dialog>)}
    </>}
  </div>
</BaseLayout>

<script>
  import { createMediaStage } from "../../scripts/media-stage";

  const page = document.querySelector<HTMLElement>(".records-page");
  const shelf = page?.querySelector<HTMLElement>("#album-shelf");
  const shelfPanel = page?.querySelector<HTMLElement>("#album-shelf-panel");
  const cards = [...(page?.querySelectorAll<HTMLElement>(".album") || [])];
  const dialogs = [...(page?.querySelectorAll<HTMLDialogElement>(".album-dialog") || [])];
  const selection = page?.querySelector<HTMLElement>("#album-selection");
  const viewButtons = [...(page?.querySelectorAll<HTMLButtonElement>("[data-record-view]") || [])];
  const selectionStage = selection ? createMediaStage(selection, {
    storageKey: "doebk-album-selection-order",
    onActivate(record) {
      const cover = record.querySelector<HTMLImageElement>(".record-sleeve img");
      if (cover?.dataset.cover && cover.src !== cover.dataset.cover) cover.src = cover.dataset.cover;
      record.classList.add("is-revealed", "is-readable");
    },
    onDeactivate(record) { record.classList.remove("is-revealed", "is-readable"); },
  }) : undefined;

  viewButtons.forEach(button => {
    button.addEventListener("click", () => {
      if (button.getAttribute("aria-pressed") === "true" || !selection || !shelfPanel) return;
      const showSelection = button.dataset.recordView === "selection";
      selectionStage?.suspend();
      selection.hidden = !showSelection;
      shelfPanel.hidden = showSelection;
      viewButtons.forEach(other => other.setAttribute("aria-pressed", String(other === button)));
      if (showSelection) selectionStage?.restart();
    });
  });

  page?.querySelectorAll<HTMLButtonElement>('[aria-controls^="album-dialog-"]').forEach(trigger => {
    trigger.addEventListener("click", () => {
      const dialog = document.getElementById(trigger.getAttribute("aria-controls") || "");
      if (!(dialog instanceof HTMLDialogElement) || dialog.open) return;
      const cover = dialog.querySelector<HTMLImageElement>(".detail-cover img");
      if (cover?.dataset.src) cover.src = cover.dataset.src;
      dialog.showModal();
      document.body.classList.add("album-open");
    });
  });
  dialogs.forEach(dialog => {
    dialog.addEventListener("click", event => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => {
      dialog.querySelector<HTMLImageElement>(".detail-cover img")?.removeAttribute("src");
      document.body.classList.remove("album-open");
    });
  });
  function closeDialogs() {
    dialogs.forEach(dialog => {
      if (dialog.open) dialog.close();
      dialog.querySelector<HTMLImageElement>(".detail-cover img")?.removeAttribute("src");
    });
    document.body.classList.remove("album-open");
  }
  window.addEventListener("pagehide", closeDialogs);
  window.addEventListener("pageshow", closeDialogs);

  const input = page?.querySelector<HTMLInputElement>("#album-search");
  const noResults = page?.querySelector<HTMLElement>("#album-no-results");
  let artistGroups: { element: HTMLElement; cards: HTMLElement[] }[] = [];

  function renderShelf(key: "name" | "artist") {
    if (!shelf) return;
    artistGroups = [];
    if (key === "name") {
      shelf.replaceChildren(...cards);
      return;
    }
    const grouped = new Map<string, HTMLElement[]>();
    cards.forEach(card => {
      const artist = card.dataset.artist || "";
      if (!grouped.has(artist)) grouped.set(artist, []);
      grouped.get(artist)!.push(card);
    });
    const fragment = document.createDocumentFragment();
    grouped.forEach((albums, artist) => {
      const group = document.createElement("section");
      group.className = "artist-group";
      const heading = document.createElement("h2");
      heading.className = "artist-heading";
      heading.id = `album-artist-group-${artistGroups.length}`;
      heading.textContent = artist;
      group.setAttribute("aria-labelledby", heading.id);
      const grid = document.createElement("div");
      grid.className = "artist-albums";
      grid.append(...albums);
      group.append(heading, grid);
      group.hidden = albums.every(card => card.hidden);
      artistGroups.push({ element: group, cards: albums });
      fragment.append(group);
    });
    shelf.replaceChildren(fragment);
  }

  input?.addEventListener("input", () => {
    const query = input.value.trim().toLocaleLowerCase();
    cards.forEach(card => { card.hidden = !card.dataset.search?.toLocaleLowerCase().includes(query); });
    artistGroups.forEach(group => { group.element.hidden = group.cards.every(card => card.hidden); });
    if (noResults) noResults.hidden = cards.some(card => !card.hidden);
  });
  page?.querySelectorAll<HTMLButtonElement>("[data-sort]").forEach(button => {
    button.addEventListener("click", () => {
      const key = button.dataset.sort;
      if (key !== "name" && key !== "artist") return;
      const locale = page.dataset.locale;
      cards.sort((a, b) => (a.dataset[key] || "").localeCompare(b.dataset[key] || "", locale)
        || (a.dataset.name || "").localeCompare(b.dataset.name || "", locale));
      renderShelf(key);
      page.querySelectorAll("[data-sort]").forEach(other => other.setAttribute("aria-pressed", String(other === button)));
    });
  });
</script>

<style>
  .records-view-toolbar:has(~ .shelf-panel:not([hidden])) { margin-bottom: 0; }
  .shelf-panel > .toolbar { border-top: 0; }
  .shelf-panel[hidden] { display: none; }
  .shelf, .shelf :global(.artist-albums) { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 3rem 2rem; align-items: start; }
  .shelf :global(.artist-group) { grid-column: 1 / -1; min-width: 0; }
  .shelf :global(.artist-group[hidden]) { display: none; }
  .shelf :global(.artist-heading) { padding-top: 1rem; margin-bottom: 1.5rem; border-top: 1px solid var(--color-border-light); font-family: var(--font-editorial); font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 400; line-height: 1.25; overflow-wrap: anywhere; }
  .album[hidden] { display: none; }
  .album-trigger { display: block; width: 100%; padding: 0; text-align: left; color: inherit; }
  .album-trigger:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 6px; }
  .cover { display: block; aspect-ratio: 1; background: var(--color-bg-muted); overflow: hidden; }
  .cover img { width: 100%; height: 100%; object-fit: contain; transition: transform 180ms ease; }
  .album-trigger:hover img { transform: scale(1.025); }
  .album-heading { margin-top: 1rem; }
  .album-heading h2 { font-size: clamp(1.25rem, 2vw, 1.8rem); line-height: 1.3; overflow-wrap: anywhere; }
  .album-heading p { margin-top: .35rem; color: var(--color-text-secondary); font-size: var(--text-sm); }
  .album-dialog { position: fixed; inset: 0; margin: 0; width: 100%; height: 100vh; height: 100dvh; max-width: none; max-height: none; padding: max(2rem, env(safe-area-inset-top), env(safe-area-inset-bottom)) max(2rem, env(safe-area-inset-left), env(safe-area-inset-right)); border: 0; background: transparent; box-shadow: none; color: #f4f4f1; }
  .album-dialog[open] { display: flex; align-items: center; justify-content: center; }
  .album-detail { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); align-items: center; gap: clamp(2rem, 5vw, 4.5rem); width: min(100%, 960px); max-height: 100%; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: rgb(255 255 255 / .25) transparent; }
  .detail-cover { width: 100%; max-width: 360px; justify-self: center; }
  .detail-cover img { width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; }
  .detail-body { min-width: 0; padding: .5rem .5rem .5rem 0; }
  .detail-heading h2 { font-family: var(--font-editorial); font-size: clamp(2rem, 4.5vw, 3.5rem); font-weight: 500; line-height: 1.08; overflow-wrap: anywhere; text-wrap: balance; }
  .detail-artist { margin-top: 1rem; font-size: var(--text-lg); color: rgb(255 255 255 / .65); }
  .album-meta { display: flex; flex-wrap: wrap; gap: 1.25rem 2rem; margin-top: 2rem; }
  .album-meta dt, .playback > span, .review h3 { font-size: var(--text-xs); font-weight: 400; letter-spacing: var(--tracking-wide); color: rgb(255 255 255 / .45); }
  .album-meta dd { margin-top: .5rem; font-size: var(--text-sm); color: rgb(255 255 255 / .8); }
  .album-meta time { font-family: var(--font-mono); font-size: var(--text-xs); }
  .review { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / .15); }
  .review h3 { margin-bottom: 1rem; }
  .review p { font-family: var(--font-editorial); font-size: var(--text-lg); white-space: pre-wrap; line-height: 1.9; overflow-wrap: anywhere; color: rgb(255 255 255 / .85); }
  .playback { margin-top: 2rem; font-size: var(--text-xs); }
  .playback > div { margin-top: .65rem; }
  .playback a { color: rgb(255 255 255 / .6); text-decoration: underline; text-decoration-color: rgb(255 255 255 / .2); text-underline-offset: .25em; }
  .playback a:hover { color: white; }
  .album-dialog :focus-visible { outline-color: rgb(255 255 255 / .8); }
  .album-dialog[open] .album-detail { animation: detail-enter 200ms var(--ease-gallery); }
  @keyframes detail-enter { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  :global(html) { scrollbar-gutter: stable; }
  :global(body.album-open) { overflow: hidden; }
  .empty-state { color: var(--color-text-tertiary); }
  @media (max-width: 640px) {
    .shelf, .shelf :global(.artist-albums) { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1rem; }
    .album-dialog { padding: max(1.5rem, env(safe-area-inset-top), env(safe-area-inset-bottom)) max(1.5rem, env(safe-area-inset-left), env(safe-area-inset-right)); }
    .album-detail { grid-template-columns: minmax(0, 1fr); gap: 1.75rem; }
    .detail-cover { max-width: min(60vw, 280px); }
    .detail-body { padding: 0 .25rem .25rem; }
    .detail-heading, .playback { text-align: center; }
    .detail-heading h2 { font-size: clamp(1.75rem, 7vw, 2.5rem); }
    .detail-artist { margin-top: .75rem; font-size: var(--text-base); }
    .album-meta { justify-content: center; }
    .album-meta { margin-top: 1.5rem; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) { .cover img { transition: none; } .album-dialog[open] .album-detail { animation: none; } }
</style>
