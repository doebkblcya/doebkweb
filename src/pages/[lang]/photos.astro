---
export { getStaticPaths } from "./_getStaticPaths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { photos as photosUnsorted } from "../../data/photos";
import { ui as zh } from "../../i18n/zh";
import { ui as en } from "../../i18n/en";

const lang = Astro.currentLocale || "zh";
const t = lang === "zh" ? zh : en;

const photos = [...photosUnsorted].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Group by date for timeline display
interface PhotoGroup { dateLabel: string; photos: { photo: typeof photos[0]; index: number }[] }
const groups: PhotoGroup[] = [];
let lastLabel = "";
for (let i = 0; i < photos.length; i++) {
  const d = new Date(photos[i].date);
  const label = lang === "zh"
    ? `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`
    : d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
  if (label !== lastLabel) { groups.push({ dateLabel: label, photos: [] }); lastLabel = label; }
  groups[groups.length - 1].photos.push({ photo: photos[i], index: i });
}

const photosJson = JSON.stringify(photos);
const noNoteI18n = t.photos.noNote;
---

<BaseLayout title={t.photos.title} hideFooter>
  <div class="page">
    <h1 class="page-title">{t.photos.title}</h1>
    <hr class="page-divider" />

    {photos.length === 0 ? (
      <div class="empty-state">
        <div class="empty-icon">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
        </div>
        <p>{t.photos.emptyList}</p>
      </div>
    ) : (
      <div id="photo-grid">
        {groups.map((group) => (
          <section class="photo-group">
            <h2 class="photo-group-date">{group.dateLabel}</h2>
            <div class="photo-grid-inner">
              {group.photos.map(({ photo, index }) => (
                <a class="photo-item" href={photo.src} data-index={index} onclick="window.__vt_openPhoto(event, this)">
                  <img
                    src={photo.thumb}
                    alt={photo.alt}
                    loading="lazy"
                    width={photo.width}
                    height={photo.height}
                  />
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    )}
  </div>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" aria-hidden="true" onclick="window.__vt_closeIfBackdrop(event, this)">
    <button class="lightbox-close" aria-label="Close" onclick="window.__vt_closePhoto()">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <button class="lightbox-prev" aria-label="Previous" onclick="window.__vt_navPhoto(-1)">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="lightbox-next" aria-label="Next" onclick="window.__vt_navPhoto(1)">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>

    <div class="lightbox-body">
      <div class="lightbox-img-wrap" id="lightbox-img-wrap">
        <img class="lightbox-img" id="lightbox-img" src="" alt="" />
      </div>
      <p class="lightbox-caption" id="lightbox-caption"></p>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ photosJson, noNoteI18n }}>
  var PHOTOS = JSON.parse(photosJson);
  var NO_NOTE = noNoteI18n;

  window.__vt_openPhoto = function (e, link) {
    e.preventDefault();
    var idx = parseInt(link.getAttribute("data-index") || "0", 10);
    var p = PHOTOS[idx];
    if (!p) return;
    window.__vt_photoIdx = idx;
    var lb = document.getElementById("lightbox");
    var lbImg = document.getElementById("lightbox-img");
    var lbCap = document.getElementById("lightbox-caption");
    if (!lb || !lbImg) return;
    lbImg.src = p.src;
    lbImg.alt = p.alt;
    if (lbCap) {
      lbCap.textContent = p.note || NO_NOTE;
      lbCap.classList.toggle("is-placeholder", !p.note);
    }
    lb.classList.add("is-open");
    lb.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  };

  window.__vt_closePhoto = function () {
    var lb = document.getElementById("lightbox");
    if (!lb) return;
    lb.classList.remove("is-open");
    lb.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  };

  window.__vt_closeIfBackdrop = function (e, el) {
    if (e.target === el) window.__vt_closePhoto();
  };

  window.__vt_navPhoto = function (dir) {
    if (!PHOTOS.length) return;
    var cur = window.__vt_photoIdx || 0;
    var idx = dir < 0 ? (cur - 1 + PHOTOS.length) % PHOTOS.length : (cur + 1) % PHOTOS.length;
    window.__vt_photoIdx = idx;
    var lbImg = document.getElementById("lightbox-img");
    var lbCap = document.getElementById("lightbox-caption");
    if (!lbImg) return;
    var photo = PHOTOS[idx];
    lbImg.src = photo.src;
    lbImg.alt = photo.alt;
    if (lbCap) {
      lbCap.textContent = photo.note || NO_NOTE;
      lbCap.classList.toggle("is-placeholder", !photo.note);
    }
  };

  // Keyboard — document listener, remove stale then re-add
  if (window.__vt_photos_onKeydown) {
    document.removeEventListener("keydown", window.__vt_photos_onKeydown);
  }
  window.__vt_photos_onKeydown = function (e) {
    var lb = document.getElementById("lightbox");
    if (!lb || !lb.classList.contains("is-open")) return;
    if (e.key === "Escape") window.__vt_closePhoto();
    if (e.key === "ArrowLeft") window.__vt_navPhoto(-1);
    if (e.key === "ArrowRight") window.__vt_navPhoto(1);
  };
  document.addEventListener("keydown", window.__vt_photos_onKeydown);
</script>

<style>
  .page {
    padding: var(--space-10) var(--space-8) var(--space-24);
  }

  .page-subtitle {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  /* ── Empty ──────────────────────────────────────── */
  .empty-state {
    text-align: center;
    padding: var(--space-20) 0;
    color: var(--color-text-tertiary);
  }

  .empty-icon {
    color: var(--color-border);
    margin-bottom: var(--space-6);
  }

  .empty-state p {
    font-size: var(--text-lg);
  }

  /* ── Photo group ────────────────────────────────── */
  .photo-group {
    margin-bottom: var(--space-12);
  }

  .photo-group-date {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    letter-spacing: var(--tracking-normal);
  }

  /* ── Photo grid ─────────────────────────────────── */
  .photo-grid-inner {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .photo-item {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
    cursor: pointer;
    text-decoration: none;
    aspect-ratio: 4 / 3;
  }

  .photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .photo-item:hover img {
    transform: scale(1.03);
  }

  /* ── Lightbox ───────────────────────────────────── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 500;
    background: rgba(28, 28, 30, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 300ms cubic-bezier(0.22, 0.61, 0.36, 1),
      visibility 0ms 300ms;
  }

  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 300ms cubic-bezier(0.22, 0.61, 0.36, 1),
      visibility 0ms 0ms;
  }

  /* ── Close button ──────────────────────────────── */
  .lightbox-close {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    z-index: 20;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    transition: background 150ms, transform 150ms;
    padding: 0;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.22);
    transform: scale(1.05);
  }

  /* ── Prev / Next ───────────────────────────────── */
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    transition: background 150ms, transform 150ms;
    padding: 0;
  }

  .lightbox-prev { left: var(--space-5); }
  .lightbox-next { right: var(--space-5); }

  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-50%) scale(1.05);
  }

  /* ── Body: image + caption ─────────────────────── */
  .lightbox-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: 85vw;
    max-height: 88vh;
  }

  .lightbox-img-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-height: 0;
  }

  .lightbox-img {
    max-width: 85vw;
    max-height: 72vh;
    object-fit: contain;
    border-radius: var(--radius-lg);
    box-shadow:
      0 4px 40px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.06);
    transition: opacity 250ms;
  }

  .lightbox-caption {
    color: rgba(255, 255, 255, 0.6);
    font-size: var(--text-sm);
    text-align: center;
    line-height: var(--leading-relaxed);
    max-width: 48ch;
    padding: 0 var(--space-4);
    min-height: 1.5em;
  }

  .lightbox-caption.is-placeholder {
    color: rgba(255, 255, 255, 0.2);
    font-style: italic;
  }

  /* ── Mobile ────────────────────────────────────── */
  @media (max-width: 640px) {
    .photo-grid-inner {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: var(--space-2);
    }

    .lightbox-prev { left: var(--space-2); }
    .lightbox-next { right: var(--space-2); }
  }
</style>
