---
export { getStaticPaths } from "./_getStaticPaths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhotoExhibition from "../../components/PhotoExhibition.astro";
import { photos as collection, photoGroups } from "../../data/photos";
import { ui as zh } from "../../i18n/zh";
import { ui as en } from "../../i18n/en";
const lang = Astro.currentLocale || "zh";
const t = lang === "zh" ? zh : en;
const photos = [...collection].sort((a, b) => a.name.localeCompare(b.name, lang, { numeric: true }));
---

<BaseLayout title={t.photos.title} description={t.photos.description} hideFooter>
  <div class="page photos-page" data-locale={lang}>
    <h1 class="page-title">{t.photos.title}</h1>
    <hr class="page-divider" />
    {photos.length === 0 ? <p class="empty-state">{t.photos.emptyList}</p> : <>
      <div class="toolbar photo-view-toolbar">
        <div class="view-toggle" role="group" aria-label={t.photos.viewLabel}>
          <button class="view-option" data-photo-view="exhibition" aria-pressed="true" aria-controls="photo-exhibition">{t.photos.viewExhibition}</button>
          <span class="view-sep" aria-hidden="true">·</span>
          <button class="view-option" data-photo-view="wall" aria-pressed="false" aria-controls="photo-wall-panel">{t.photos.viewWall}</button>
        </div>
      </div>
      <PhotoExhibition photos={photos} groups={photoGroups} t={t.photos} />
      <section id="photo-wall-panel" class="wall-panel" aria-label={t.photos.viewWall} hidden>
        <div class="toolbar">
          <div class="search-wrap">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input id="photo-search" class="search-input" type="search" placeholder={t.photos.searchPlaceholder} aria-label={t.photos.searchPlaceholder} autocomplete="off" />
          </div>
          <div class="sort-group" role="group" aria-label={t.photos.sortLabel}>
            <svg class="sort-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="16" y2="12"/><line x1="4" y1="18" x2="12" y2="18"/></svg>
            <button class="sort-option" data-photo-sort="name" aria-pressed="true">{t.photos.sortName}</button>
            <span class="sort-sep" aria-hidden="true">·</span>
            <button class="sort-option" data-photo-sort="time" aria-pressed="false">{t.photos.sortTime}</button>
          </div>
        </div>
        <div id="photo-wall-grid" class="wall-grid">
          {photos.map(photo => <a class="photo-item wall-photo" href={photo.src} data-photo-id={photo.id} data-name={photo.name} data-date={photo.date || ""} data-caption={photo.note || ""} aria-label={photo.name}>
            <img src={photo.thumb} alt={photo.name} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
          </a>)}
        </div>
        <section id="photos-without-time" class="without-time" aria-labelledby="photos-without-time-title" hidden>
          <h2 id="photos-without-time-title">{t.photos.noTime}</h2>
          <div id="photos-without-time-grid" class="wall-grid"></div>
        </section>
        <p id="photo-no-results" class="empty-state" hidden role="status">{t.photos.noResults}</p>
      </section>
      <noscript><style is:inline>#photo-wall-panel[hidden] { display: block; } .photo-view-toolbar { display: none; }</style></noscript>
      <dialog id="lightbox" class="lightbox" aria-label={t.photos.title} autofocus>
        <div class="lightbox-body">
          <div id="lightbox-stage" class="lightbox-stage" aria-busy="false">
            <img id="lightbox-image" alt="" hidden />
            <p id="lightbox-loading" aria-hidden="true">···</p>
            <p id="lightbox-error" hidden role="status">{t.photos.loadError}</p>
          </div>
          <p id="lightbox-caption" hidden></p>
        </div>
      </dialog>
    </>}
  </div>
</BaseLayout>

<script>
  import { createMediaStage } from "../../scripts/media-stage";

  const page = document.querySelector<HTMLElement>(".photos-page");
  const exhibition = page?.querySelector<HTMLElement>("#photo-exhibition");
  const wallPanel = page?.querySelector<HTMLElement>("#photo-wall-panel");
  const wallGrid = page?.querySelector<HTMLElement>("#photo-wall-grid");
  const noTimeGroup = page?.querySelector<HTMLElement>("#photos-without-time");
  const noTimeGrid = page?.querySelector<HTMLElement>("#photos-without-time-grid");
  const allCards = [...(page?.querySelectorAll<HTMLAnchorElement>(".photo-item") || [])];
  const wallCards = [...(wallPanel?.querySelectorAll<HTMLAnchorElement>(".photo-item") || [])];
  const dialog = page?.querySelector<HTMLDialogElement>("#lightbox");
  const stage = page?.querySelector<HTMLElement>("#lightbox-stage");
  const lightboxBody = page?.querySelector<HTMLElement>(".lightbox-body");
  const image = page?.querySelector<HTMLImageElement>("#lightbox-image");
  const loading = page?.querySelector<HTMLElement>("#lightbox-loading");
  const error = page?.querySelector<HTMLElement>("#lightbox-error");
  const caption = page?.querySelector<HTMLElement>("#lightbox-caption");
  const collator = new Intl.Collator(page?.dataset.locale, { numeric: true });
  const exhibitionStage = exhibition ? createMediaStage(exhibition, {
    storageKey: "doebk-photo-exhibition-order",
    onActivate(photo) { photo.classList.add("is-presented"); },
    onDeactivate(photo) { photo.classList.remove("is-presented"); },
  }) : undefined;
  let view: "exhibition" | "wall" = exhibition?.querySelector("[data-stage-item]") ? "exhibition" : "wall";
  if (view === "wall" && exhibition && wallPanel) {
    exhibition.hidden = true;
    wallPanel.hidden = false;
    page?.querySelectorAll<HTMLElement>("[data-photo-view]").forEach(button => {
      button.setAttribute("aria-pressed", String(button.dataset.photoView === view));
    });
  }
  let sort: "name" | "time" = "name";
  let current = 0;
  let request = 0;
  let pending: HTMLImageElement | undefined;
  const activeCards = () => {
    const cards = [...((view === "wall" ? wallPanel : exhibition)?.querySelectorAll<HTMLAnchorElement>(".photo-item") || [])];
    // The exhibition retains its complete shuffled order for lightbox navigation,
    // including the figures temporarily hidden by the single-work stage.
    return view === "wall" ? cards.filter(card => !card.hidden) : cards;
  };

  function discardLoader() {
    if (!pending) return;
    pending.onload = null;
    pending.onerror = null;
    pending.removeAttribute("src");
    pending = undefined;
  }
  function clearLightbox() {
    request++;
    discardLoader();
    image?.removeAttribute("src");
    if (image) image.hidden = true;
    if (caption) { caption.textContent = ""; caption.hidden = true; }
    dialog?.removeAttribute("aria-describedby");
    stage?.setAttribute("aria-busy", "false");
    document.body.classList.remove("photo-open");
  }
  function show(index: number) {
    const list = activeCards();
    if (!list.length || !image || !loading || !error || !caption || !dialog) return;
    current = (index + list.length) % list.length;
    const card = list[current];
    const token = ++request;
    discardLoader();
    image.hidden = true;
    image.removeAttribute("src");
    image.alt = card.querySelector("img")?.alt || "";
    loading.hidden = false;
    error.hidden = true;
    stage?.setAttribute("aria-busy", "true");
    const note = card.dataset.caption || "";
    caption.textContent = note;
    caption.hidden = !note.trim();
    if (caption.hidden) dialog.removeAttribute("aria-describedby");
    else dialog.setAttribute("aria-describedby", "lightbox-caption");
    const loader = new Image();
    pending = loader;
    loader.onload = () => {
      if (token !== request) return;
      image.src = card.href;
      image.hidden = false;
      loading.hidden = true;
      stage?.setAttribute("aria-busy", "false");
      discardLoader();
    };
    loader.onerror = () => {
      if (token !== request) return;
      loading.hidden = true;
      error.hidden = false;
      stage?.setAttribute("aria-busy", "false");
      discardLoader();
    };
    loader.src = card.href;
  }
  allCards.forEach(card => card.addEventListener("click", event => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || !dialog) return;
    event.preventDefault();
    show(activeCards().indexOf(card));
    dialog.showModal();
    document.body.classList.add("photo-open");
  }));
  dialog?.addEventListener("keydown", event => {
    if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
      event.preventDefault(); show(current + (event.key === "ArrowLeft" ? -1 : 1));
    }
  });
  dialog?.addEventListener("click", event => {
    if (event.target === dialog || event.target === stage || event.target === lightboxBody) dialog.close();
  });
  dialog?.addEventListener("close", clearLightbox);
  function closeLightbox() { if (dialog?.open) dialog.close(); clearLightbox(); }
  window.addEventListener("pagehide", closeLightbox);
  window.addEventListener("pageshow", closeLightbox);

  page?.querySelectorAll<HTMLButtonElement>("[data-photo-view]").forEach(button => button.addEventListener("click", () => {
    if (!exhibition || !wallPanel) return;
    const nextView = button.dataset.photoView === "wall" ? "wall" : "exhibition";
    if (nextView === view) return;
    if (nextView === "wall") exhibitionStage?.suspend();
    view = nextView;
    exhibition.hidden = view !== "exhibition";
    wallPanel.hidden = view !== "wall";
    if (view === "exhibition") exhibitionStage?.restart();
    page.querySelectorAll("[data-photo-view]").forEach(other => other.setAttribute("aria-pressed", String(other === button)));
  }));

  function updateSearch() {
    const query = page?.querySelector<HTMLInputElement>("#photo-search")?.value.trim().toLocaleLowerCase() || "";
    wallCards.forEach(card => { card.hidden = !(card.dataset.caption || "").toLocaleLowerCase().includes(query); });
    if (noTimeGroup) noTimeGroup.hidden = sort !== "time" || !wallCards.some(card => !card.dataset.date && !card.hidden);
    const noResults = page?.querySelector<HTMLElement>("#photo-no-results");
    if (noResults) noResults.hidden = wallCards.some(card => !card.hidden);
  }
  page?.querySelector<HTMLInputElement>("#photo-search")?.addEventListener("input", updateSearch);
  page?.querySelectorAll<HTMLButtonElement>("[data-photo-sort]").forEach(button => button.addEventListener("click", () => {
    if (!wallGrid || !noTimeGrid) return;
    sort = button.dataset.photoSort === "time" ? "time" : "name";
    const ordered = [...wallCards].sort((a, b) => {
      const nameOrder = collator.compare(a.dataset.name || "", b.dataset.name || "");
      return sort === "name" ? nameOrder : (b.dataset.date || "").localeCompare(a.dataset.date || "") || nameOrder;
    });
    ordered.forEach(card => (sort === "time" && !card.dataset.date ? noTimeGrid : wallGrid).append(card));
    page.querySelectorAll("[data-photo-sort]").forEach(other => other.setAttribute("aria-pressed", String(other === button)));
    updateSearch();
  }));
</script>

<style>
  .photo-view-toolbar:has(~ .wall-panel:not([hidden])) { margin-bottom: 0; }
  .wall-panel > .toolbar { border-top: 0; }
  .wall-panel[hidden], .without-time[hidden], .wall-photo[hidden] { display: none; }
  .wall-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: clamp(1rem, 2vw, 2rem); align-items: start; }
  .wall-photo { display: block; aspect-ratio: 3 / 2; overflow: hidden; text-decoration: none; }
  .wall-photo img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .wall-photo:focus-visible { outline-offset: 6px; }
  .without-time { margin-top: clamp(3rem, 5vw, 5rem); }
  .without-time h2 { padding-top: 1rem; margin-bottom: 1.5rem; border-top: 1px solid var(--color-border-light); font-family: var(--font-editorial); font-size: 1.5rem; font-weight: 400; }
  .empty-state { color: var(--color-text-tertiary); }
  .lightbox { position: fixed; inset: 0; margin: 0; width: 100%; height: 100vh; height: 100dvh; max-width: none; max-height: none; padding: max(2rem, env(safe-area-inset-top), env(safe-area-inset-bottom)) max(3.5rem, env(safe-area-inset-right), env(safe-area-inset-left)); border: 0; background: transparent; box-shadow: none; color: rgb(255 255 255 / .85); }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lightbox-body { display: flex; flex-direction: column; align-items: center; gap: 1rem; width: min(76vw, 1000px); max-width: 100%; }
  .lightbox-stage { width: 100%; min-height: 3rem; display: grid; grid-template: auto / minmax(0, 1fr); place-items: center; }
  .lightbox-stage > * { grid-area: 1 / 1; min-width: 0; min-height: 0; }
  .lightbox-stage img { width: auto; height: auto; max-width: 100%; max-height: 64vh; max-height: 64dvh; object-fit: contain; border: 0; box-shadow: none; }
  .lightbox-stage [hidden], #lightbox-caption[hidden] { display: none; }
  #lightbox-caption { max-width: 48ch; max-height: 18vh; max-height: 18dvh; overflow-y: auto; margin: 0 auto; padding: 0 var(--space-4); text-align: center; white-space: pre-wrap; font-family: var(--font-editorial); font-style: italic; font-size: var(--text-lg); line-height: var(--leading-relaxed); color: rgb(255 255 255 / .7); }
  #lightbox-caption::before { content: "“"; }
  #lightbox-caption::after { content: "”"; }
  :global(body.photo-open) { overflow: hidden; }
  @media (max-width: 640px) {
    .wall-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
    .lightbox { padding-inline: max(3rem, env(safe-area-inset-left), env(safe-area-inset-right)); }
    .lightbox-body { width: 100%; }
    #lightbox-caption { padding: 0; font-size: var(--text-base); }
  }
</style>
