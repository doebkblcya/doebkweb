---
export { getStaticPaths } from "./_getStaticPaths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { photos as collection } from "../../data/photos";
import { ui as zh } from "../../i18n/zh";
import { ui as en } from "../../i18n/en";
const lang = Astro.currentLocale || "zh";
const t = lang === "zh" ? zh : en;
const photos = [...collection].sort((a, b) => b.date.localeCompare(a.date));
const groups = Map.groupBy(photos, photo => photo.date.slice(0, 10));
const dateLabel = (date: string) => new Date(`${date}T00:00:00Z`).toLocaleDateString(lang === "zh" ? "zh-CN" : "en-US", {
  year: "numeric", month: "long", day: "numeric", timeZone: "UTC",
});
---

<BaseLayout title={t.photos.title} description={t.photos.description} hideFooter>
  <div class="page photos-page">
    <h1 class="page-title">{t.photos.title}</h1>
    <hr class="page-divider" />
    {photos.length === 0 ? <p class="empty-state">{t.photos.emptyList}</p> : <>
      <div class="toolbar">
        <div class="search-wrap">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            id="photo-search"
            class="search-input"
            type="search"
            placeholder={t.photos.searchPlaceholder}
            autocomplete="off"
            aria-label={t.photos.searchPlaceholder}
          />
        </div>
        <div class="view-toggle" role="group" aria-label={t.photos.viewLabel}>
          <svg class="view-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
          </svg>
          <button class="view-option is-active" data-view="wall" aria-pressed="true">{t.photos.viewWall}</button>
          <span class="view-sep" aria-hidden="true">·</span>
          <button class="view-option" data-view="timeline" aria-pressed="false">{t.photos.viewTimeline}</button>
        </div>
      </div>

      <div id="photo-grid" class="is-wall">
        {[...groups].map(([date, group]) => <section class="photo-group">
          <h2 class="photo-group-date"><time datetime={date}>{dateLabel(date)}</time></h2>
          <div class="photo-grid-inner">
            {group.map(photo => <a class="photo-item" href={photo.src} data-caption={photo.note || ""} data-search={`${photo.alt} ${photo.note || ""} ${photo.date}`}>
              <img src={photo.thumb} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" />
            </a>)}
          </div>
        </section>)}
      </div>
      <p id="photo-no-results" class="empty-state" hidden role="status">{t.photos.noResults}</p>
      <dialog id="lightbox" class="lightbox" aria-label={t.photos.title} aria-describedby="lightbox-caption" data-no-note={t.photos.noNote} autofocus>
        <span id="lightbox-counter"></span>
        <button id="lightbox-prev" class="lightbox-control" aria-label={t.photos.previous}>←</button>
        <button id="lightbox-next" class="lightbox-control" aria-label={t.photos.next}>→</button>
        <div class="lightbox-body">
          <div id="lightbox-stage" class="lightbox-stage" aria-busy="false">
            <img id="lightbox-image" alt="" hidden />
            <p id="lightbox-loading" aria-hidden="true">···</p>
            <p id="lightbox-error" hidden role="status">{t.photos.loadError}</p>
          </div>
          <p id="lightbox-caption"></p>
        </div>
      </dialog>
    </>}
  </div>
</BaseLayout>

<script>
  const grid = document.querySelector<HTMLElement>("#photo-grid");
  const cards = [...document.querySelectorAll<HTMLAnchorElement>(".photo-item")];
  const dialog = document.querySelector<HTMLDialogElement>("#lightbox");
  const stage = document.querySelector<HTMLElement>("#lightbox-stage");
  const lightboxBody = document.querySelector<HTMLElement>(".lightbox-body");
  const image = document.querySelector<HTMLImageElement>("#lightbox-image");
  const loading = document.querySelector<HTMLElement>("#lightbox-loading");
  const error = document.querySelector<HTMLElement>("#lightbox-error");
  const caption = document.querySelector<HTMLElement>("#lightbox-caption");
  const counter = document.querySelector<HTMLElement>("#lightbox-counter");
  const prev = document.querySelector<HTMLButtonElement>("#lightbox-prev");
  const next = document.querySelector<HTMLButtonElement>("#lightbox-next");
  let current = 0;
  let request = 0;
  const visible = () => cards.filter(card => !card.hidden);
  function show(index: number) {
    const list = visible();
    if (!list.length || !image || !loading || !error || !caption || !counter) return;
    current = (index + list.length) % list.length;
    const card = list[current];
    const token = ++request;
    image.hidden = true;
    image.removeAttribute("src");
    loading.hidden = false;
    error.hidden = true;
    stage?.setAttribute("aria-busy", "true");
    const note = card.dataset.caption || "";
    caption.textContent = note || dialog?.dataset.noNote || "";
    caption.classList.toggle("is-placeholder", !note);
    counter.textContent = `${current + 1} / ${list.length}`;
    if (prev) prev.disabled = list.length < 2;
    if (next) next.disabled = list.length < 2;
    // An independent loader prevents a slow previous request from replacing the current image.
    const pending = new Image();
    pending.onload = () => {
      if (token !== request) return;
      image.src = card.href;
      image.alt = card.querySelector("img")?.alt || "";
      image.hidden = false;
      loading.hidden = true;
      stage?.setAttribute("aria-busy", "false");
    };
    pending.onerror = () => {
      if (token !== request) return;
      loading.hidden = true;
      error.hidden = false;
      stage?.setAttribute("aria-busy", "false");
    };
    pending.src = card.href;
  }
  cards.forEach(card => card.addEventListener("click", event => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || !dialog) return;
    event.preventDefault();
    show(visible().indexOf(card));
    dialog.showModal();
    document.body.classList.add("photo-open");
  }));
  prev?.addEventListener("click", () => show(current - 1));
  next?.addEventListener("click", () => show(current + 1));
  dialog?.addEventListener("keydown", event => {
    if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
      event.preventDefault(); show(current + (event.key === "ArrowLeft" ? -1 : 1));
    }
  });
  dialog?.addEventListener("click", event => {
    if (event.target === dialog || event.target === stage || event.target === lightboxBody) dialog.close();
  });
  dialog?.addEventListener("close", () => { request++; document.body.classList.remove("photo-open"); });
  window.addEventListener("pageshow", () => dialog?.close());
  const input = document.querySelector<HTMLInputElement>("#photo-search");
  input?.addEventListener("input", () => {
    const query = input.value.trim().toLocaleLowerCase();
    cards.forEach(card => { card.hidden = !card.dataset.search?.toLocaleLowerCase().includes(query); });
    document.querySelectorAll<HTMLElement>(".photo-group").forEach(group => {
      group.hidden = ![...group.querySelectorAll<HTMLElement>(".photo-item")].some(card => !card.hidden);
    });
    const noResults = document.querySelector<HTMLElement>("#photo-no-results");
    if (noResults) noResults.hidden = visible().length > 0;
  });
  function setView(view: string) {
    grid?.classList.toggle("is-wall", view !== "timeline");
    document.querySelectorAll<HTMLElement>("[data-view]").forEach(button => {
      const active = button.dataset.view === view;
      button.setAttribute("aria-pressed", String(active));
      button.classList.toggle("is-active", active);
    });
  }
  try { setView(localStorage.getItem("doebk-photo-view") === "timeline" ? "timeline" : "wall"); } catch { setView("wall"); }
  document.querySelectorAll<HTMLElement>("[data-view]").forEach(button => button.addEventListener("click", () => {
    const view = button.dataset.view!;
    setView(view);
    try { localStorage.setItem("doebk-photo-view", view); } catch { /* The current view remains usable. */ }
  }));
</script>

<style>
  #photo-grid.is-wall, .photo-grid-inner { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: clamp(0.75rem, 1.6vw, 1.5rem); }
  #photo-grid.is-wall .photo-group, #photo-grid.is-wall .photo-grid-inner { display: contents; }
  #photo-grid.is-wall .photo-group-date { display: none; }
  .photo-group { margin-bottom: clamp(4rem, 8vw, 7rem); }
  .photo-group-date { margin-bottom: 1rem; padding-top: .75rem; border-top: 1px solid var(--color-border); color: var(--color-text-tertiary); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 500; letter-spacing: .035em; }
  .photo-item { position: relative; display: block; overflow: hidden; aspect-ratio: 4 / 3; border: 1px solid var(--color-border-light); background: var(--color-bg-muted); cursor: pointer; text-decoration: none; }
  .photo-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 500ms var(--ease-gallery), filter 500ms ease; }
  .photo-item:hover img { transform: scale(1.018); }
  #photo-grid .photo-item[hidden], #photo-grid .photo-group[hidden] { display: none; }
  .empty-state { color: var(--color-text-tertiary); }
  .lightbox { position: fixed; inset: 0; margin: 0; width: 100%; height: 100vh; height: 100dvh; max-width: none; max-height: none; padding: max(2rem, env(safe-area-inset-top), env(safe-area-inset-bottom)) max(3.5rem, env(safe-area-inset-right), env(safe-area-inset-left)); border: 0; background: transparent; box-shadow: none; color: rgb(255 255 255 / .85); }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lightbox-body { display: flex; flex-direction: column; align-items: center; gap: 1rem; width: min(76vw, 1000px); max-width: 100%; }
  #lightbox-counter { position: absolute; top: max(1rem, env(safe-area-inset-top)); left: max(1.5rem, env(safe-area-inset-left)); line-height: 44px; color: rgb(255 255 255 / .5); font-family: var(--font-mono); font-size: var(--text-xs); }
  .lightbox-control { position: absolute; width: 44px; height: 44px; padding: 0; border: 0; background: transparent; color: inherit; cursor: pointer; font-size: 1.75rem; }
  .lightbox-control:hover { color: white; }
  .lightbox-control:focus-visible { outline: 1px solid currentColor; outline-offset: 3px; }
  .lightbox-control:disabled { opacity: .25; cursor: default; }
  #lightbox-prev, #lightbox-next { top: 50%; transform: translateY(-50%); }
  #lightbox-prev { left: max(.5rem, env(safe-area-inset-left)); }
  #lightbox-next { right: max(.5rem, env(safe-area-inset-right)); }
  .lightbox-stage { width: 100%; min-height: 3rem; display: grid; grid-template: auto / minmax(0, 1fr); place-items: center; }
  .lightbox-stage > * { grid-area: 1 / 1; min-width: 0; min-height: 0; }
  .lightbox-stage img { width: auto; height: auto; max-width: 100%; max-height: 64vh; max-height: 64dvh; object-fit: contain; border: 0; box-shadow: none; }
  .lightbox-stage [hidden] { display: none; }
  #lightbox-caption { max-width: 48ch; max-height: 18vh; max-height: 18dvh; overflow-y: auto; margin: 0 auto; padding: 0 var(--space-4); min-height: 1.5em; text-align: center; white-space: pre-wrap; font-family: var(--font-editorial); font-style: italic; font-size: var(--text-lg); line-height: var(--leading-relaxed); color: rgb(255 255 255 / .7); }
  #lightbox-caption:not(.is-placeholder)::before { content: "“"; }
  #lightbox-caption:not(.is-placeholder)::after { content: "”"; }
  #lightbox-caption.is-placeholder { color: rgb(255 255 255 / .35); }
  :global(body.photo-open) { overflow: hidden; }
  @media (max-width: 640px) {
    #photo-grid.is-wall, .photo-grid-inner { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; }
    .lightbox { padding-inline: max(3rem, env(safe-area-inset-left), env(safe-area-inset-right)); }
    .lightbox-body { width: 100%; }
    #lightbox-caption { padding: 0; font-size: var(--text-base); }
  }
  @media (prefers-reduced-motion: reduce) { .photo-item img { transition: none; } }
</style>
