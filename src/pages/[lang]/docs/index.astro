---
export { getStaticPaths } from "../_getStaticPaths";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

import { ui as zh } from "../../../i18n/zh";
import { ui as en } from "../../../i18n/en";

const lang = Astro.currentLocale || "zh";
const t = lang === "zh" ? zh : en;

const allDocs = await getCollection("docs", ({ data }) => !data.draft && data.listed !== false);
allDocs.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const pagefindEnabled = import.meta.env.PROD;
---

<BaseLayout title={t.docs.title} description={t.docs.description} hideFooter>
  <div class="page docs-index">
    <h1 class="page-title">{t.docs.title}</h1>
    <hr class="page-divider" />

    {allDocs.length === 0 ? (
      <p class="empty">{t.docs.emptyList}</p>
    ) : (
      <>
        <div class="toolbar">
          <div class="search-wrap" id="search-wrap">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input
              id="search-input"
              class="search-input"
              type="search"
              placeholder={t.docs.searchPlaceholder}
              aria-label={t.docs.searchPlaceholder}
              autocomplete="off"
            />
            <div class="search-results" id="search-results" hidden></div>
          </div>
          <div class="sort-group" role="group" aria-label={lang === "zh" ? "排序方式" : "Sort by"}>
            <svg class="sort-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
              <line x1="4" y1="6" x2="20" y2="6"/>
              <line x1="4" y1="12" x2="16" y2="12"/>
              <line x1="4" y1="18" x2="12" y2="18"/>
            </svg>
            <button class="sort-option is-active" data-sort="desc" aria-pressed="true">{t.docs.sortNewest}</button>
            <span class="sort-sep" aria-hidden="true">·</span>
            <button class="sort-option" data-sort="asc" aria-pressed="false">{t.docs.sortOldest}</button>
          </div>
        </div>

        <div class="doc-list" id="doc-list">
          {allDocs.map((doc) => (
            <a href={`/${lang}/docs/${doc.slug}/`} class="doc-card" data-date={doc.data.date.toISOString()}>
              <h2 class="doc-title">{doc.data.title}</h2>
              <p class="doc-summary">{doc.data.summary}</p>
              <div class="doc-meta">
                <time datetime={doc.data.date.toISOString()}>
                  {doc.data.date.toLocaleDateString(lang === "zh" ? "zh-CN" : "en-US", {
                    year: "numeric", month: "long", day: "numeric",
                  })}
                </time>
              </div>
            </a>
          ))}
        </div>
      </>
    )}
  </div>
</BaseLayout>

<style is:global>
.docs-index {
  .page {
    padding: var(--space-16) var(--space-8) var(--space-24);
  }

  .empty {
    font-size: var(--text-lg);
    color: var(--color-text-tertiary);
  }

}
</style>
<style is:global>
  /* ── Results dropdown ───────────────────────── */
  .search-results {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg), 0 0 0 1px rgba(0,0,0,0.04);
    max-height: 26rem;
    overflow-y: auto;
    z-index: 50;
    opacity: 0;
    transform: translateY(-6px) scale(0.98);
    transition: opacity 200ms ease-out, transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .search-results:not([hidden]) {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  /* ── Results header ─────────────────────────── */
  .search-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  .search-header-count {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ── Results list ───────────────────────────── */
  .search-results-list {
    padding: var(--space-1);
  }

  .search-result-item {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    transition: background 120ms;
    text-decoration: none;
    cursor: pointer;
    outline: none;
    scroll-margin: var(--space-1);
  }

  .search-result-item + .search-result-item {
    margin-top: 1px;
  }

  .search-result-item:hover,
  .search-result-item.is-active {
    background: var(--color-accent-subtle);
  }

  .search-result-item.is-active {
    box-shadow: inset 0 0 0 2px var(--color-accent);
  }

  /* ── Result content ─────────────────────────── */
  .search-result-title {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: var(--leading-snug);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-result-excerpt {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-result-excerpt mark {
    background: rgba(0, 113, 227, 0.12);
    color: #0071e3;
    border-radius: 2px;
    padding: 0 1px;
    font-weight: 500;
  }

  .search-result-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  /* ── Empty state ────────────────────────────── */
  .search-empty {
    padding: var(--space-8) var(--space-4);
    text-align: center;
  }

  .search-empty-icon {
    width: 36px;
    height: 36px;
    margin: 0 auto var(--space-3);
    color: var(--color-text-tertiary);
    opacity: 0.5;
  }

  .search-empty-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
  }

  .search-empty-hint {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  /* ── Loading state ──────────────────────────── */
  .search-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-8) var(--space-4);
  }

  .search-loading-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-text-tertiary);
    animation: searchDotPulse 1.2s ease-in-out infinite;
  }

  .search-loading-dot:nth-child(2) {
    animation-delay: 0.15s;
  }

  .search-loading-dot:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes searchDotPulse {
    0%, 80%, 100% { opacity: 0.15; transform: scale(0.75); }
    40% { opacity: 1; transform: scale(1); }
  }
</style>
<style>
  /* ── Doc cards ──────────────────────────────── */
  .doc-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .doc-card {
    display: block;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
    transition: background 150ms, transform 200ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .doc-card:hover {
    background: var(--color-bg-surface-hover);
    transform: scale(1.008);
    box-shadow: var(--shadow-sm);
  }

  .doc-title {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: var(--tracking-normal);
    line-height: var(--leading-snug);
  }

  .doc-summary {
    margin-top: var(--space-2);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }

</style>

<script is:inline define:vars={{ lang, pagefindEnabled }}>
  (() => {
    const input = document.getElementById("search-input");
    const results = document.getElementById("search-results");
    const wrap = document.getElementById("search-wrap");
    const list = document.getElementById("doc-list");
    document.querySelectorAll("[data-sort]").forEach(button => {
      button.addEventListener("click", () => {
        const direction = button.dataset.sort === "asc" ? 1 : -1;
        [...list.querySelectorAll(".doc-card")].sort((a, b) => direction * a.dataset.date.localeCompare(b.dataset.date)).forEach(card => list.append(card));
        document.querySelectorAll("[data-sort]").forEach(other => {
          other.classList.toggle("is-active", other === button);
          other.setAttribute("aria-pressed", String(other === button));
        });
      });
    });
    if (!input || !results || !wrap) return;
    let sequence = 0, timer, selected = -1;
    let ready;
    function hide() {
      sequence++; clearTimeout(timer); results.hidden = true; results.replaceChildren(); selected = -1;
    }
    function message(text) {
      const node = document.createElement("p");
      node.className = "search-empty"; node.textContent = text;
      results.replaceChildren(node); results.hidden = false;
    }
    async function search() {
      const query = input.value.trim();
      if (!query) { hide(); return; }
      const token = ++sequence;
      clearTimeout(timer); selected = -1;
      message(lang === "zh" ? "正在搜索…" : "Searching…");
      timer = setTimeout(async () => {
        try {
          ready ||= import("/pagefind/pagefind.js").then(async module => { await module.init(); return module; }).catch(error => { ready = undefined; throw error; });
          const pagefind = await ready;
          const found = await pagefind.search(query);
          const matches = [];
          for (const result of found.results) {
            if (token !== sequence) return;
            const data = await result.data();
            if (data.url.startsWith(`/${lang}/docs/`) && data.url !== `/${lang}/docs/`) matches.push(data);
            if (matches.length === 8) break;
          }
          if (token !== sequence) return;
          if (!matches.length) { message(lang === "zh" ? "未找到匹配的文档" : "No matching documents"); return; }
          results.replaceChildren();
          for (const data of matches) {
            const link = document.createElement("a"); link.className = "search-result-item"; link.href = data.url;
            const body = document.createElement("div"); body.className = "search-result-body";
            const title = document.createElement("div"); title.className = "search-result-title"; title.textContent = data.meta.title || data.url;
            const excerpt = document.createElement("div"); excerpt.className = "search-result-excerpt";
            // Pagefind generates these excerpts from our own built content.
            excerpt.innerHTML = data.excerpt || "";
            body.append(title, excerpt); link.append(body); results.append(link);
          }
          results.hidden = false;
        } catch {
          if (token === sequence) message(lang === "zh" ? "搜索暂时不可用，请稍后重试" : "Search is unavailable. Please try again.");
        }
      }, 200);
    }
    if (pagefindEnabled) {
      input.addEventListener("input", search); input.addEventListener("focus", search);
    } else {
      input.disabled = true;
      input.title = lang === "zh" ? "全文搜索需构建后预览" : "Search is available in the built preview";
    }
    document.addEventListener("click", event => { if (!wrap.contains(event.target)) hide(); });
    input.addEventListener("keydown", event => {
      if (results.hidden) return;
      const links = [...results.querySelectorAll("a")];
      if (event.key === "Escape") { event.preventDefault(); hide(); }
      if ((event.key === "ArrowDown" || event.key === "ArrowUp") && links.length) {
        event.preventDefault();
        selected = (selected + (event.key === "ArrowDown" ? 1 : selected < 0 ? 0 : -1) + links.length) % links.length;
        links.forEach((link, index) => link.classList.toggle("is-active", index === selected));
        links[selected].scrollIntoView({ block: "nearest" });
      }
      if (event.key === "Enter" && selected >= 0) { event.preventDefault(); location.assign(links[selected].href); }
    });
    window.addEventListener("pageshow", hide);
  })();
</script>

<style is:global>
  .docs-index .toolbar {
    margin-bottom: 0;
  }

  .docs-index .search-results {
    top: calc(100% + 1px);
    border: 1px solid var(--color-border);
    border-radius: 0;
    background: var(--glass-bg);
    box-shadow: var(--shadow-lg);
  }

  .docs-index .search-result-item { border-radius: 0; border-bottom: 1px solid var(--color-border-light); }
  .docs-index .search-result-item.is-active { box-shadow: inset 2px 0 0 var(--color-accent); }

  .docs-index .doc-list { gap: 0; border-bottom: 1px solid var(--color-border-light); }

  .docs-index .doc-card {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(12rem, 1fr);
    grid-template-areas: "title meta" "summary meta";
    gap: 0.4rem 2rem;
    padding: clamp(1.5rem, 3vw, 2.5rem) 0;
    border-top: 1px solid var(--color-border-light);
    border-radius: 0;
    background: transparent;
    transition: background var(--duration-fast), padding var(--duration-normal) var(--ease-gallery);
  }

  .docs-index .doc-card:first-child { border-top: 0; }

  .docs-index .doc-card:hover {
    padding-inline: 1rem;
    background: var(--color-bg-muted);
    box-shadow: none;
    transform: none;
  }

  .docs-index .doc-title {
    grid-area: title;
    font-family: var(--font-editorial);
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    font-weight: 400;
    line-height: 1.18;
  }

  .docs-index .doc-summary {
    grid-area: summary;
    max-width: 62ch;
    margin: 0.4rem 0 0;
    line-height: 1.7;
  }

  .docs-index .doc-meta {
    grid-area: meta;
    align-self: start;
    justify-content: flex-end;
    margin: 0;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.025em;
  }

  @media (max-width: 700px) {
    .docs-index .doc-card { grid-template-columns: 1fr; grid-template-areas: "meta" "title" "summary"; gap: 0.65rem; }
    .docs-index .doc-meta { justify-content: flex-start; }
  }
</style>
