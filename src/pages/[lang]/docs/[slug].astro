---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

import { ui as zh } from "../../../i18n/zh";
import { ui as en } from "../../../i18n/en";

export async function getStaticPaths() {
  const docs = await getCollection("docs", ({ data }) => !data.draft && data.listed !== false);
  return ["zh", "en"].flatMap((lang) =>
    docs.map((doc) => ({ params: { lang, slug: doc.slug } }))
  );
}

const { slug } = Astro.params;
const lang = Astro.currentLocale || "zh";
const t = lang === "zh" ? zh : en;

const docs = await getCollection("docs", ({ data }) => !data.draft && data.listed !== false);
const doc = docs.find((d) => d.slug === slug);

if (!doc) return Astro.redirect(`/${lang}/404/`);

const { Content } = await doc.render();

const wordCount = doc.body.split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 300));
---

<BaseLayout title={doc.data.title} hideFooter>
  <div class="page">
    <a href={`/${lang}/docs/`} class="back-link">{t.docs.backToDocs}</a>

    <h1 class="page-title">{doc.data.title}</h1>

    <div class="page-meta">
      <time datetime={doc.data.date.toISOString()}>
        {t.docs.published} {doc.data.date.toLocaleDateString(lang === "zh" ? "zh-CN" : "en-US", {
          year: "numeric", month: "long", day: "numeric",
        })}
      </time>
      {doc.data.updated && (
        <time datetime={doc.data.updated.toISOString()}>
          · {t.docs.updated} {doc.data.updated.toLocaleDateString(lang === "zh" ? "zh-CN" : "en-US", {
            year: "numeric", month: "long", day: "numeric",
          })}
        </time>
      )}
      <span>· {readingTime} {t.docs.readingTime}</span>
      <a href={`/${lang}/docs/category/${doc.data.category}/`} class="meta-cat">
        {doc.data.category}
      </a>
    </div>

    <hr class="page-divider" />

    <div class="page-body">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 48rem;
    padding: var(--space-16) var(--space-8) var(--space-24);
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    transition: color 150ms;
  }

  .back-link:hover {
    color: var(--color-text-secondary);
  }

  .page-title {
    font-size: var(--text-5xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }

  .meta-cat {
    margin-left: var(--space-2);
    padding: 0 var(--space-2);
    font-size: var(--text-xs);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-full);
    transition: background 150ms;
  }

  .meta-cat:hover {
    background: var(--color-bg-surface-hover);
  }

  .page-divider {
    width: 100%;
    height: 1px;
    border: none;
    background: var(--color-border);
    margin: var(--space-10) 0;
  }

  .page-body {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  .page-body :global(h2) {
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .page-body :global(h3) {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .page-body :global(p) {
    margin-bottom: var(--space-4);
  }

  .page-body :global(ul),
  .page-body :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
    list-style: disc;
  }

  .page-body :global(li) {
    margin-bottom: var(--space-2);
  }

  /* ── Code blocks (Shiki highlighted) ──────── */
  .page-body :global(pre) {
    margin: var(--space-6) 0;
    padding: var(--space-5) var(--space-6);
    background: #f6f8fa;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    overflow-x: auto;
    font-size: 0.875em;
    line-height: 1.6;
  }

  .page-body :global(pre code) {
    font-family: var(--font-mono);
    background: none;
    border: none;
    padding: 0;
  }

  /* ── Inline code ───────────────────────────── */
  .page-body :global(p code),
  .page-body :global(li code) {
    padding: 0.15em 0.4em;
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--color-text-primary);
    background: var(--color-bg-surface-hover);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
  }

  /* ── Blockquote ────────────────────────────── */
  .page-body :global(blockquote) {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-6);
    background: var(--color-bg-surface-hover);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--color-text-secondary);
  }

  .page-body :global(blockquote p) {
    margin-bottom: 0;
  }

  /* ── Links ─────────────────────────────────── */
  .page-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity 150ms;
  }

  .page-body :global(a:hover) {
    opacity: 0.7;
  }

  /* ── Images ────────────────────────────────── */
  .page-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin: var(--space-6) 0;
  }

  /* ── Tables ────────────────────────────────── */
  .page-body :global(table) {
    width: 100%;
    margin: var(--space-6) 0;
    border-collapse: collapse;
    font-size: 0.9375em;
  }

  .page-body :global(th),
  .page-body :global(td) {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--color-border-light);
  }

  .page-body :global(th) {
    font-weight: 600;
    color: var(--color-text-primary);
    background: var(--color-bg-surface-hover);
  }

  .page-body :global(hr) {
    width: 100%;
    height: 1px;
    border: none;
    background: var(--color-border);
    margin: var(--space-10) 0;
  }
</style>
