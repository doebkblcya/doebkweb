---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/prose.css";

import { ui as zh } from "../../../i18n/zh";
import { ui as en } from "../../../i18n/en";

export async function getStaticPaths() {
  const docs = await getCollection("docs", ({ data }) => !data.draft && data.listed !== false);
  return ["zh", "en"].flatMap((lang) =>
    docs.map((doc) => ({ params: { lang, slug: doc.slug } }))
  );
}

const { slug } = Astro.params;
const lang = Astro.currentLocale || "zh";
const t = lang === "zh" ? zh : en;

const docs = await getCollection("docs", ({ data }) => !data.draft && data.listed !== false);
const doc = docs.find((d) => d.slug === slug);

if (!doc) return Astro.redirect(`/${lang}/404/`);

const { Content, headings } = await doc.render();
const toc = (headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={doc.data.title} description={doc.data.summary} hideFooter>
  <div class="page doc-detail">

    <h1 class="page-title">{doc.data.title}</h1>
    <hr class="page-divider" />

    <div class="page-meta" data-pagefind-ignore>
      <time datetime={doc.data.date.toISOString()}>
        {t.docs.published} {doc.data.date.toLocaleDateString(lang === "zh" ? "zh-CN" : "en-US", {
          year: "numeric", month: "long", day: "numeric",
        })}
      </time>
      {doc.data.updated && (
        <time datetime={doc.data.updated.toISOString()}>
          · {t.docs.updated} {doc.data.updated.toLocaleDateString(lang === "zh" ? "zh-CN" : "en-US", {
            year: "numeric", month: "long", day: "numeric",
          })}
        </time>
      )}
    </div>

    <div class="docs-layout">
      <div class="page-body">
        <Content />
      </div>

      {toc.length > 0 && (
        <nav class="toc" id="toc" aria-label={t.docs.toc} data-pagefind-ignore>
          <p class="toc-title">{t.docs.toc}</p>
          <ul class="toc-list">
            {toc.map((h) => (
              <li class={`toc-item toc-depth-${h.depth}`}>
                <a class="toc-link" href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>

    <!-- Pagefind metadata (hidden, for search indexing) -->
    <span data-pagefind-meta="date" style="display:none">{doc.data.date.toISOString()}</span>
  </div>
</BaseLayout>

<style>
  .page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    margin: 0 0 var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }

  /* 正文 80rem + 目录 18rem 组合靠左，rail 紧贴正文，大屏右侧留白 */
  .docs-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: var(--space-8);
    max-width: calc(80rem + 18rem + var(--space-8));
  }

  /* 排版样式见 prose.css */
  .page-body {
    min-width: 0;
  }

  /* ── TOC rail（毛玻璃卡片）───────────────────── */
  .toc {
    position: sticky;
    top: var(--space-10);
    align-self: start;
    /* iOS Safari:100vh 含地址栏,改用 dvh 动态视口(旧浏览器 fallback 在前) */
    max-height: calc(100vh - var(--space-20));
    max-height: calc(100dvh - var(--space-20));
    overflow-y: auto;
    padding: var(--space-4);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
  }

  /* 减少透明度偏好：玻璃降级为纯色卡片 */
  @media (prefers-reduced-transparency: reduce) {
    .toc {
      background: var(--color-bg-surface);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .toc-title {
    margin-bottom: var(--space-3);
    padding: 0 var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc-link {
    display: block;
    padding: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition:
      color 150ms,
      background 150ms;
  }

  .toc-link:hover {
    color: var(--color-text-primary);
    background: var(--color-accent-subtle);
  }

  .toc-link.is-active {
    color: var(--color-accent);
    font-weight: 600;
    background: var(--color-accent-subtle);
  }

  .toc-depth-3 .toc-link {
    padding-left: var(--space-6);
  }

  /* 锚点跳转偏移 + 平滑滚动（scroll-margin 见 prose.css） */
  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }

  @media (max-width: 1100px) {
    .docs-layout {
      grid-template-columns: 1fr;
    }
    .toc {
      display: none;
    }
  }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc-link")];
  const headings = [...document.querySelectorAll<HTMLElement>(".page-body h2[id], .page-body h3[id]")];
  let pending = false;
  let timer: ReturnType<typeof setTimeout>;
  function activate(id: string) {
    links.forEach(link => {
      const active = link.getAttribute("href") === `#${id}`;
      link.classList.toggle("is-active", active);
      if (active) link.setAttribute("aria-current", "location"); else link.removeAttribute("aria-current");
    });
  }
  function update() {
    if (pending || !headings.length) return;
    const current = [...headings].reverse().find(heading => heading.getBoundingClientRect().top <= innerHeight * .3) || headings[0];
    const atBottom = scrollY + innerHeight >= document.documentElement.scrollHeight - 4;
    activate(atBottom ? headings[headings.length - 1].id : current.id);
  }
  links.forEach(link => link.addEventListener("click", () => {
    pending = true; clearTimeout(timer); activate(link.getAttribute("href")!.slice(1));
    timer = setTimeout(() => { pending = false; update(); }, 1000);
  }));
  let scheduled = false;
  window.addEventListener("scroll", () => {
    if (scheduled) return;
    scheduled = true; requestAnimationFrame(() => { scheduled = false; update(); });
  }, { passive: true });
  window.addEventListener("wheel", () => { pending = false; }, { passive: true });
  window.addEventListener("touchstart", () => { pending = false; }, { passive: true });
  window.addEventListener("pageshow", update);
  update();
</script>

<style is:global>
  .doc-detail .page-meta {
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.025em;
  }

  .doc-detail .docs-layout {
    grid-template-columns: minmax(0, 48rem) minmax(12rem, 18rem);
    justify-content: space-between;
    gap: clamp(3rem, 7vw, 8rem);
    max-width: 82rem;
  }

  .doc-detail .toc {
    top: 2rem;
    padding: 1rem 0;
    border: 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border-light);
    border-radius: 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .doc-detail .toc-title {
    margin: 0 0 1rem;
    padding: 0;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
  }

  .doc-detail .toc-list { gap: 0; }

  .doc-detail .toc-link {
    padding: 0.5rem 0;
    border-radius: 0;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .doc-detail .toc-link:hover { background: transparent; color: var(--color-text-primary); }
  .doc-detail .toc-link.is-active { padding-left: 0.75rem; border-left: 2px solid var(--color-accent); background: transparent; }
  .doc-detail .toc-depth-3 .toc-link { padding-left: 1.25rem; }

  @media (max-width: 1100px) {
    .doc-detail .docs-layout { grid-template-columns: minmax(0, 48rem); }
  }
</style>
