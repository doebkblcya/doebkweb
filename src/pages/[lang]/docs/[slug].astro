---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

import { ui as zh } from "../../../i18n/zh";
import { ui as en } from "../../../i18n/en";

export async function getStaticPaths() {
  const docs = await getCollection("docs", ({ data }) => !data.draft && data.listed !== false);
  return ["zh", "en"].flatMap((lang) =>
    docs.map((doc) => ({ params: { lang, slug: doc.slug } }))
  );
}

const { slug } = Astro.params;
const lang = Astro.currentLocale || "zh";
const t = lang === "zh" ? zh : en;

const docs = await getCollection("docs", ({ data }) => !data.draft && data.listed !== false);
const doc = docs.find((d) => d.slug === slug);

if (!doc) return Astro.redirect(`/${lang}/404/`);

const { Content } = await doc.render();

const wordCount = doc.body.split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 300));
---

<BaseLayout title={doc.data.title} hideFooter>
  <div class="page">

    <h1 class="page-title">{doc.data.title}</h1>

    <div class="page-meta" data-pagefind-ignore>
      <time datetime={doc.data.date.toISOString()}>
        {t.docs.published} {doc.data.date.toLocaleDateString(lang === "zh" ? "zh-CN" : "en-US", {
          year: "numeric", month: "long", day: "numeric",
        })}
      </time>
      {doc.data.updated && (
        <time datetime={doc.data.updated.toISOString()}>
          · {t.docs.updated} {doc.data.updated.toLocaleDateString(lang === "zh" ? "zh-CN" : "en-US", {
            year: "numeric", month: "long", day: "numeric",
          })}
        </time>
      )}
    </div>

    <hr class="page-divider" />

    <div class="page-body">
      <Content />
    </div>

    <!-- Pagefind metadata (hidden, for search indexing) -->
    <span data-pagefind-meta="date" style="display:none">{doc.data.date.toISOString()}</span>
  </div>
</BaseLayout>

<style>
  .page {
    padding: var(--space-16) var(--space-8) var(--space-24);
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
  }

  .page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }

  .page-divider {
    width: 100%;
    height: 1px;
    border: none;
    background: var(--color-border);
    margin: var(--space-10) 0;
  }

  .page-body {
    max-width: var(--content-width, 64rem);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  .page-body :global(h2) {
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .page-body :global(h3) {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .page-body :global(p) {
    margin-bottom: var(--space-4);
  }

  .page-body :global(ul),
  .page-body :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
    list-style: disc;
  }

  .page-body :global(li) {
    margin-bottom: var(--space-2);
  }

  /* ── Code blocks (Shiki highlighted) ──────── */
  .page-body :global(pre) {
    margin: var(--space-6) 0;
    padding: var(--space-5) var(--space-6);
    background: #f6f8fa;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    overflow-x: auto;
    font-size: 0.875em;
    line-height: 1.6;
  }

  .page-body :global(pre code) {
    font-family: var(--font-mono);
    background: none;
    border: none;
    padding: 0;
  }

  /* ── Inline code ───────────────────────────── */
  .page-body :global(p code),
  .page-body :global(li code) {
    padding: 0.15em 0.4em;
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--color-text-primary);
    background: var(--color-bg-surface-hover);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
  }

  /* ── Blockquote ────────────────────────────── */
  .page-body :global(blockquote) {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-6);
    background: var(--color-bg-surface-hover);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--color-text-secondary);
  }

  .page-body :global(blockquote p) {
    margin-bottom: 0;
  }

  /* ── Links ─────────────────────────────────── */
  .page-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity 150ms;
  }

  .page-body :global(a:hover) {
    opacity: 0.7;
  }

  /* ── Images ────────────────────────────────── */
  .page-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin: var(--space-6) 0;
  }

  /* ── Tables ────────────────────────────────── */
  .page-body :global(table) {
    width: 100%;
    margin: var(--space-6) 0;
    border-collapse: collapse;
    font-size: 0.9375em;
  }

  .page-body :global(th),
  .page-body :global(td) {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--color-border-light);
  }

  .page-body :global(th) {
    font-weight: 600;
    color: var(--color-text-primary);
    background: var(--color-bg-surface-hover);
  }

  .page-body :global(h4) {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .page-body :global(h5) {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-top: var(--space-5);
    margin-bottom: var(--space-1);
  }

  .page-body :global(h6) {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: var(--space-5);
    margin-bottom: var(--space-1);
  }

  /* ── Keyboard keys ──────────────────────────── */
  .page-body :global(kbd) {
    display: inline-block;
    padding: 0.1em 0.45em;
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--color-text-primary);
    background: var(--color-bg-page);
    border: 1px solid var(--color-border);
    border-bottom-width: 2px;
    border-radius: var(--radius-sm);
    line-height: 1.5;
  }

  /* ── Table zebra ────────────────────────────── */
  .page-body :global(tr:nth-child(even)) {
    background: var(--color-bg-page);
  }

  /* ── External links ─────────────────────────── */
  .page-body :global(a[href^="http"]:not([href*="doebkblcya.com"]))::after {
    content: " ↗";
    font-size: 0.75em;
    opacity: 0.5;
  }

  /* ── Heading anchor ─────────────────────────── */
  .page-body :global(h2),
  .page-body :global(h3),
  .page-body :global(h4) {
    position: relative;
    scroll-margin-top: var(--space-4);
  }

  .page-body :global(h2)::before,
  .page-body :global(h3)::before,
  .page-body :global(h4)::before {
    content: "#";
    position: absolute;
    left: -1.2em;
    color: var(--color-text-tertiary);
    opacity: 0;
    transition: opacity 150ms;
    font-weight: 400;
    font-size: 0.85em;
  }

  .page-body :global(h2):hover::before,
  .page-body :global(h3):hover::before,
  .page-body :global(h4):hover::before {
    opacity: 0.4;
  }

  /* ── Details / Summary ──────────────────────── */
  .page-body :global(details) {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
  }

  .page-body :global(summary) {
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--color-text-primary);
    cursor: pointer;
    padding: var(--space-2) 0;
    list-style: none;
  }

  .page-body :global(summary)::-webkit-details-marker {
    display: none;
  }

  .page-body :global(summary)::before {
    content: "▸";
    display: inline-block;
    margin-right: var(--space-2);
    transition: transform 150ms;
    font-size: 0.75em;
    color: var(--color-text-tertiary);
  }

  .page-body :global(details[open]) summary::before {
    transform: rotate(90deg);
  }

  .page-body :global(details) > :not(summary) {
    margin-top: var(--space-3);
  }

  .page-body :global(hr) {
    width: 100%;
    height: 1px;
    border: none;
    background: var(--color-border);
    margin: var(--space-10) 0;
  }
</style>
