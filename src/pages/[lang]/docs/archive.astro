---
export { getStaticPaths } from "../_getStaticPaths";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

import { ui as zh } from "../../../i18n/zh";
import { ui as en } from "../../../i18n/en";

const lang = Astro.currentLocale || "zh";
const t = lang === "zh" ? zh : en;

const allDocs = await getCollection("docs", ({ data }) => !data.draft && data.listed !== false);
allDocs.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Group by year-month
const grouped = new Map<string, typeof allDocs>();
for (const doc of allDocs) {
  const key = doc.data.date.toLocaleDateString(lang === "zh" ? "zh-CN" : "en-US", {
    year: "numeric", month: "long",
  });
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(doc);
}
---

<BaseLayout title={`${t.docs.archive} — ${t.docs.title}`} hideFooter>
  <div class="page">
    <h1 class="page-title">{t.docs.archive}</h1>
    <hr class="page-divider" />

    {allDocs.length === 0 ? (
      <p class="empty">{t.docs.emptyArchive}</p>
    ) : (
      <div class="archive-list">
        {[...grouped.entries()].map(([period, docs]) => (
          <section class="archive-group">
            <h2 class="archive-period">{period}</h2>
            <ul class="archive-items">
              {docs.map((doc) => (
                <li>
                  <a href={`/${lang}/docs/${doc.slug}/`} class="archive-link">
                    <span class="archive-title">{doc.data.title}</span>
                    <span class="archive-cat">{doc.data.category}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page {
    padding: var(--space-16) var(--space-8) var(--space-24);
  }

  .page-title {
    font-size: var(--text-5xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    max-width: 40rem;
  }

  .page-divider {
    width: 100%;
    height: 1px;
    border: none;
    background: var(--color-border);
    margin: var(--space-10) 0;
  }

  .empty {
    font-size: var(--text-lg);
    color: var(--color-text-tertiary);
  }

  /* ── Archive ────────────────────────────────── */
  .archive-group {
    margin-bottom: var(--space-8);
  }

  .archive-period {
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-4);
  }

  .archive-items {
    list-style: none;
  }

  .archive-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border-light);
    transition: background 150ms;
  }

  .archive-link:hover {
    background: var(--color-bg-surface-hover);
    margin: 0 calc(-1 * var(--space-3));
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    border-radius: var(--radius-md);
  }

  .archive-title {
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .archive-cat {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }
</style>
