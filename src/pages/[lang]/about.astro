---
export { getStaticPaths } from "./_getStaticPaths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import "../../styles/prose.css";

import { ui as zh } from "../../i18n/zh";
import { ui as en } from "../../i18n/en";

const lang = Astro.currentLocale || "zh";
const t = lang === "zh" ? zh : en;

const about = await getEntry("docs", "about");
const { Content } = await about!.render();
---

<BaseLayout title={t.about.title} hideFooter>
  <div class="page">
    <div class="page-header">
      <h1 class="page-title">{t.about.title}</h1>
      <hr class="page-divider" />
    </div>
    <div class="page-body">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  /* 布局与文档详情页一致：80rem 左对齐（排版样式见 prose.css） */
  .page {
    padding: var(--space-16) var(--space-8) var(--space-24);
  }

  .page-header {
    max-width: 80rem;
  }

  .page-body {
    max-width: 80rem;
    min-width: 0;
  }
</style>
