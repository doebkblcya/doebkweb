---
export { getStaticPaths } from "./_getStaticPaths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { about } from "../../data/about";
import pets from "../../data/pets.json";

import { ui as zh } from "../../i18n/zh";
import { ui as en } from "../../i18n/en";

const lang = Astro.currentLocale || "zh";
const t = lang === "zh" ? zh : en;
const cats = pets;
---

<BaseLayout title={t.about.title} description={t.about.description} hideFooter>
  <div class="page about-page">
    <header class="page-header">
      <h1 class="page-title">{t.about.title}</h1>
      <hr class="page-divider" />
    </header>

    <div class="page-body">
      <section class="about-hero" aria-labelledby="about-name">
        <h2 id="about-name" class="hero-name">{about.hero.name}</h2>

        <div class="about-copy">
          <div class="about-intro">
            {about.hero.intro.split("\n").map(paragraph => <p>{paragraph}</p>)}
          </div>
        </div>

        <div class="cats-grid">
          {cats.map(cat => <figure class="cat">
            <div class="cat-media" data-about-cat data-clips={JSON.stringify(cat.clips)}>
              <button class="cat-stage" type="button" disabled
                aria-label={lang === 'zh' ? `${cat.name}：点击打哈欠` : `${cat.name}: click to yawn`}>
                <img src={cat.poster} alt={cat.name} width={cat.width} height={cat.height} decoding="async" draggable="false"
                  style={`left:${cat.clips.idle.layout.left / 360 * 100}%;top:${cat.clips.idle.layout.top / 480 * 100}%;width:${cat.width / 360 * 100}%;height:${cat.height / 480 * 100}%;`} />
                <canvas width="360" height="480" aria-hidden="true"></canvas>
              </button>
            </div>
            <figcaption>{cat.name}</figcaption>
          </figure>)}
        </div>
      </section>

      <section class="contact-section" aria-labelledby="about-contact-title">
        <h2 id="about-contact-title" class="contact-title">{about.contact.title}</h2>
        <div class="contact-links">
          <a href={about.contact.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={`mailto:${about.contact.email}`}>{about.contact.email}</a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { initAboutCats } from "../../scripts/about-cats";
  initAboutCats();
</script>

<style>
  .page-body { min-width: 0; }

  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    column-gap: clamp(2.5rem, 5vw, 5rem);
    row-gap: clamp(2rem, 4vw, 3rem);
    padding-top: var(--space-4);
  }

  .hero-name {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(3.25rem, 7vw, 6.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -.045em;
    overflow-wrap: anywhere;
  }

  .about-copy { min-width: 0; align-self: center; }

  .about-intro {
    max-width: 26ch;
    font-family: var(--font-editorial);
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    line-height: 1.9;
    text-wrap: pretty;
  }

  .about-intro p { margin: 0; }
  .about-intro p + p { margin-top: var(--space-2); }

  .cats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(.75rem, 1.5vw, 1.5rem);
    align-self: center;
    width: 100%;
    max-width: 660px;
    justify-self: end;
  }

  .cat {
    --cat-row-height: clamp(12rem, 20vw, 18rem);
    display: grid;
    grid-template-rows: var(--cat-row-height) auto;
    gap: var(--space-4);
    min-width: 0;
    margin: 0;
  }

  .cat-media { position: relative; min-height: 0; }

  /* Shared 360×480 canvas; Y=455 is the paw baseline for every action. */
  .cat-stage {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: min(100%, calc(var(--cat-row-height) * .75));
    aspect-ratio: 3 / 4;
    transform: translate(-50%, calc(25 / 480 * 100%));
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .cat-stage:disabled { cursor: default; }
  .cat-stage:focus-visible { outline: 1px solid var(--color-accent); outline-offset: 4px; }

  .cat img, .cat canvas {
    position: absolute;
    display: block;
    pointer-events: none;
  }
  .cat canvas {
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }
  .cat-media :global(video) {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .cat-media[data-ready] canvas { opacity: 1; }
  .cat-media[data-ready] img { visibility: hidden; }

  .cat figcaption {
    color: var(--color-text-secondary);
    font-family: var(--font-editorial);
    font-size: var(--text-base);
    font-style: italic;
    text-align: center;
  }

  .contact-section {
    display: grid;
    gap: var(--space-4);
    margin-top: clamp(3rem, 5vw, 4rem);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-light);
  }

  .contact-title {
    margin: 0;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: var(--tracking-wide);
    line-height: var(--leading-normal);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
  }

  .contact-links a {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-decoration-thickness: 1px;
    text-underline-offset: .3em;
    transition: color var(--duration-fast), text-decoration-color var(--duration-fast);
  }

  .contact-links a:hover {
    color: var(--color-text-primary);
    text-decoration-color: currentColor;
  }

  .hero-name,
  .about-copy,
  .cats-grid,
  .contact-section { animation: about-enter 480ms var(--ease-gallery) both; }
  .about-copy { animation-delay: 60ms; }
  .cats-grid { animation-delay: 120ms; }
  .contact-section { animation-delay: 180ms; }

  @keyframes about-enter {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 1024px) {
    .about-hero { grid-template-columns: minmax(0, 1fr); }
    .about-intro { max-width: 32ch; }
    .cat { --cat-row-height: clamp(12rem, 25vw, 18rem); }
  }

  @media (max-width: 640px) {
    .about-hero { row-gap: var(--space-8); padding-top: 0; }
    .hero-name { font-size: clamp(2.75rem, 12vw, 4rem); }
    .about-intro { font-size: var(--text-lg); }
    .cats-grid { gap: var(--space-3); }
    .cat { --cat-row-height: clamp(7rem, 30vw, 11rem); gap: var(--space-3); }
    .cat figcaption { font-size: var(--text-sm); }
    .contact-section { margin-top: var(--space-12); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-name,
    .about-copy,
    .cats-grid,
    .contact-section { animation: none; }
    .contact-links a { transition: none; }
  }
</style>
