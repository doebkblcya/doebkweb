---
export { getStaticPaths } from "./_getStaticPaths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { about } from "../../data/about";

import { ui as zh } from "../../i18n/zh";
import { ui as en } from "../../i18n/en";

const lang = Astro.currentLocale || "zh";
const t = lang === "zh" ? zh : en;
---

<BaseLayout title={t.about.title} description={t.about.description} hideFooter>
  <div class="page">
    <!-- 标准页头：与其他页面一致（.page-title / .page-divider 为 global.css 共享样式） -->
    <div class="page-header">
      <h1 class="page-title">{t.about.title}</h1>
      <hr class="page-divider" />
    </div>

    <div class="page-body">
      <!-- 引导区：展示名 + 一句话（内容） -->
      <header class="hero">
        <p class="hero-name">{about.hero.name}</p>
        <p class="hero-tagline">{about.hero.tagline}</p>
      </header>

      <!-- 自述 -->
      <section class="section">
        <h2 class="section-title">{about.intro.title}</h2>
        <div class="intro-text">
          {about.intro.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </section>

      <!-- 联系 -->
      <section class="section">
        <h2 class="section-title">{about.contact.title}</h2>
        <div class="contact-row">
          <a
            class="contact-btn"
            href={about.contact.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
          <a class="contact-btn" href={`mailto:${about.contact.email}`}>
            {about.contact.email}
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* 布局与文档详情页一致：80rem 左对齐 */
  .page {
    padding: var(--space-16) var(--space-8) var(--space-24);
  }

  .page-header {
    max-width: 80rem;
  }

  .page-body {
    max-width: 80rem;
    min-width: 0;
  }

  /* ── 入场动画：整页一次、分区级联（轻量，无 JS / 无滚动触发） ──
     页面级样式随 VT 换页重建 DOM，切页回来动画自然重放 */
  .page-header,
  .page-body > * {
    animation: fadeUp 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .page-body > *:nth-child(2) { animation-delay: 100ms; }
  .page-body > *:nth-child(3) { animation-delay: 200ms; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── 引导区 ────────────────────────────────── */
  .hero {
    margin-bottom: var(--space-16);
  }

  .hero-name {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
  }

  .hero-tagline {
    margin-top: var(--space-4);
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
  }

  /* ── 分区 ──────────────────────────────────── */
  .section {
    margin-top: var(--space-16);
  }

  .section-title {
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-tertiary);
  }

  .intro-text p {
    max-width: 65ch;
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-primary);
  }

  /* ── 联系 ──────────────────────────────────── */
  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .contact-btn {
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    transition:
      background-color var(--duration-fast),
      border-color var(--duration-fast);
  }

  .contact-btn:hover {
    background: var(--color-bg-surface-hover);
    border-color: var(--color-text-tertiary);
  }

  .contact-btn:active {
    transform: scale(0.98);
  }

  /* ── 响应式（640px 手机分界） ─────────────── */
  @media (max-width: 640px) {
    .page {
      padding: var(--space-10) var(--space-6) var(--space-16);
    }

    .contact-row {
      flex-direction: column;
    }

    .contact-btn {
      text-align: center;
    }
  }

  /* ── 系统偏好降级 ─────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .page-header,
    .page-body > * {
      animation: none;
    }

    .contact-btn {
      transition: none;
    }
  }
</style>
