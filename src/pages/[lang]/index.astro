---
export { getStaticPaths } from "./_getStaticPaths";
import BaseLayout from "../../layouts/BaseLayout.astro";

import { ui as zh } from "../../i18n/zh";
import { ui as en } from "../../i18n/en";

const lang = Astro.currentLocale || "zh";
const t = lang === "zh" ? zh : en;

const navButtons = [
  { label: t.nav.about,  href: `/${lang}/about/` },
  { label: t.nav.docs,   href: `/${lang}/docs/` },
  { label: t.nav.music,  href: `/${lang}/music/` },
  { label: t.nav.photos, href: `/${lang}/photos/` },
  { label: t.nav.github, href: "https://github.com/doebkblcya", external: true },
];
---

<BaseLayout hideHeader hideFooter>
  <div class="welcome">
    <div class="welcome-inner">
      <!-- 主标题 -->
      <h1 class="quote">{t.home.quote}</h1>

      <!-- 分隔线 -->
      <hr class="divider" />

      <!-- 自我介绍 -->
      <div class="intro">
        <p class="intro-greeting">{t.home.welcome}</p>
      </div>

      <!-- 功能按钮 -->
      <nav class="actions">
        {navButtons.map((btn, i) => (
          <a
            href={btn.href}
            class="btn"
            style={`animation-delay: ${600 + i * 100}ms`}
            {...(btn.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            {btn.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .welcome {
    display: flex;
    align-items: center;
    min-height: 100vh;
    padding: var(--space-16) var(--space-8);
  }

  .welcome-inner {
    width: 100%;
    /* 与宽度 token 统一(64rem == --max-width-wide) */
    max-width: var(--max-width-wide);
    margin: 0 auto;
  }

  /* ── Quote ──────────────────────────────────── */
  .quote {
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    white-space: pre-line;
    animation: fadeUp 800ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* ── Divider ────────────────────────────────── */
  .divider {
    width: 100%;
    height: 1px;
    border: none;
    background: var(--color-border);
    margin: clamp(var(--space-16), 6vh, var(--space-24)) 0;
    animation: fadeIn 600ms 200ms both;
  }

  /* ── Intro ──────────────────────────────────── */
  .intro {
    animation: fadeUp 600ms cubic-bezier(0.16, 1, 0.3, 1) 400ms both;
  }

  .intro-greeting {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  /* ── Buttons ────────────────────────────────── */
  .actions {
    display: flex;
    gap: var(--space-4);
    width: 100%;
    margin-top: clamp(var(--space-16), 6vh, var(--space-24));
  }

  .btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-5) var(--space-6);
    font-size: clamp(0.9375rem, 1.3vw, 1.125rem);
    font-weight: 500;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    animation: fadeUp 500ms cubic-bezier(0.16, 1, 0.3, 1) 700ms both;
    transition:
      background-color var(--duration-fast),
      border-color var(--duration-fast);
  }

  .btn:hover {
    background: var(--color-bg-surface-hover);
    border-color: var(--color-text-tertiary);
  }

  .btn:active {
    transform: scale(0.98);
  }

  /* ── Keyframes ──────────────────────────────── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ── Responsive ─────────────────────────────── */
  @media (max-width: 640px) {
    .welcome {
      padding: var(--space-8) var(--space-6);
    }

    /* 仅手机端:问候语居中(座右铭保持左对齐) */
    .intro-greeting {
      text-align: center;
    }

    .actions {
      flex-direction: column;
    }
  }
</style>
