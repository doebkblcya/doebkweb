---
export { getStaticPaths } from "./_getStaticPaths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeSignature from "../../components/HomeSignature.astro";
import { ui as zh } from "../../i18n/zh";
import { ui as en } from "../../i18n/en";

const lang = Astro.currentLocale || "zh";
const t = lang === "zh" ? zh : en;
const navItems = [
  { label: t.nav.about, href: `/${lang}/about/` },
  { label: t.nav.docs, href: `/${lang}/docs/` },
  { label: t.nav.music, href: `/${lang}/music/` },
  { label: t.nav.photos, href: `/${lang}/photos/` },
];
---

<BaseLayout hideHeader hideFooter>
  <div class="home">
    <div class="home-composition">
      <div class="home-copy">
        <h1 class="identity"><span class="sr-only">doebkblcya</span><HomeSignature /></h1>
        <nav class="portal" aria-label={t.nav.home}>
          {navItems.map(item => <a class="portal-link" href={item.href}>{item.label}</a>)}
        </nav>
      </div>
      <div class="flowers" aria-hidden="true">
        <img src="/images/home-flowers.webp" alt="" width="1254" height="1254" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  :global(html[data-page="home"]),
  :global(html[data-page="home"] body) { background: var(--color-bg-page); }
  :global(html[data-page="home"] main) { min-height: 100vh; min-height: 100svh; }

  .home { overflow: clip; min-height: 100vh; min-height: 100svh; }
  .home-composition {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
    gap: var(--home-column-gap);
    align-items: center;
    width: min(100%, 105rem);
    min-height: 100vh;
    min-height: 100svh;
    margin-inline: auto;
    padding: var(--home-block-space) var(--home-inline-space);
    isolation: isolate;
  }
  .home-copy { position: relative; z-index: 1; min-width: 0; padding-block: var(--space-6); }
  .identity { width: 112%; max-width: 43rem; margin: 0; color: var(--color-text-primary); }
  .portal {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-8);
    width: min(100%, 34rem);
    margin-top: clamp(3rem, 8svh, 6rem);
  }
  .portal-link {
    display: block;
    min-height: 44px;
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-border-light);
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: var(--home-link-size);
    font-weight: 400;
    text-decoration: none;
    transition: color 150ms ease, background 150ms ease;
  }
  .portal-link:hover,
  .portal-link:focus-visible {
    color: var(--color-accent);
    background: var(--color-bg-muted);
  }
  .portal-link:focus-visible { outline-offset: 6px; }
  .flowers {
    position: relative;
    z-index: 0;
    align-self: end;
    justify-self: end;
    width: min(52vw, 80svh, 50rem);
    margin-right: calc(-1 * var(--home-inline-space));
    margin-bottom: calc(-1 * var(--home-block-space) - 3svh);
    pointer-events: none;
    animation: flowers-enter 800ms var(--ease-gallery) 220ms backwards;
  }
  .flowers img { display: block; width: 100%; height: auto; user-select: none; }
  @keyframes flowers-enter {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 900px) {
    .home-composition {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      gap: var(--space-6);
      padding-top: max(var(--space-16), env(safe-area-inset-top));
    }
    .home-copy { width: min(100%, 38rem); padding: 0; }
    .identity { width: 100%; }
    .portal { width: min(100%, 32rem); margin-top: var(--space-8); }
    .flowers { width: min(78vw, 42svh, 30rem); margin-right: calc(-.5 * var(--home-inline-space)); }
  }
  @media (max-width: 640px) {
    .home-composition { padding-inline: var(--space-6); }
    .portal { column-gap: var(--space-6); }
    .portal-link { padding-block: var(--space-4); }
    .flowers { margin-right: calc(-1 * var(--space-6)); }
  }
  @media (max-height: 540px) and (max-width: 900px) {
    .home-composition { padding-top: var(--space-6); gap: var(--space-4); }
    .identity { max-width: 24rem; }
    .portal { margin-top: var(--space-4); }
    .portal-link { padding-block: var(--space-3); }
    .flowers { width: min(60vw, 32svh); }
  }
  @media (prefers-reduced-motion: reduce) {
    .flowers { animation: none; }
    .portal-link { transition: none; }
  }
</style>
