---
export { getStaticPaths } from "./_getStaticPaths";
import BaseLayout from "../../layouts/BaseLayout.astro";

import { ui as zh } from "../../i18n/zh";
import { ui as en } from "../../i18n/en";

const lang = Astro.currentLocale || "zh";
const t = lang === "zh" ? zh : en;

const navItems = [
  { label: t.nav.about, href: `/${lang}/about/` },
  { label: t.nav.docs, href: `/${lang}/docs/` },
  { label: t.nav.music, href: `/${lang}/music/` },
  { label: t.nav.photos, href: `/${lang}/photos/` },
];
---

<BaseLayout hideHeader hideFooter>
  <home-hero class="home" id="home">
    <section class="hero-shell" id="home-hero">
      <div class="hero-stage" id="home-stage">
        <h1 class="identity">doebkblcya</h1>

        <nav class="portal" id="home-portal" aria-label={t.nav.home}>
          {navItems.map((item) => (
            <a class="portal-link" href={item.href}>{item.label}</a>
          ))}
        </nav>

        <div class="portrait" id="home-portrait" aria-hidden="true">
          <img
            src="/images/home-figure.webp"
            alt=""
            width="1122"
            height="1402"
            fetchpriority="high"
            decoding="async"
          />
        </div>

      </div>
    </section>
  </home-hero>
</BaseLayout>

<script>
  import { animate } from "motion";

  class HomeHero extends HTMLElement {
    private dispose?: () => void;

    connectedCallback() {
      this.dispose?.();

      const hero = this.querySelector<HTMLElement>("#home-hero");
      const title = this.querySelector<HTMLElement>(".identity");
      const portrait = this.querySelector<HTMLElement>("#home-portrait");
      const portal = this.querySelector<HTMLElement>("#home-portal");
      if (!hero || !title || !portrait || !portal) return;
      const activeTitle: HTMLElement = title;
      const activePortrait: HTMLElement = portrait;
      const activePortal: HTMLElement = portal;

      var controller = new AbortController();
      var pointerX = 0;
      var pointerY = 0;
      var touchStartY = 0;
      var progressValue = 0;
      var stateTarget: number | null = null;
      var frame: number | undefined;
      var pointerOnlyFrame = false;
      var scrollAnimation: ReturnType<typeof animate> | undefined;
      var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function clamp(value: number, min: number, max: number) {
        return Math.min(Math.max(value, min), max);
      }

      function smoothstep(value: number) {
        var x = clamp(value, 0, 1);
        return x * x * (3 - 2 * x);
      }

      function render(pointerOnly = false) {
        if (frame !== undefined) cancelAnimationFrame(frame);
        frame = undefined;
        var progress = reduceMotion ? 1 : progressValue;
        var reveal = smoothstep((progress - 0.2) / 0.56);
        var compact = window.innerWidth <= 900;
        var small = window.innerWidth <= 520;
        var titleShiftX = small ? -17 : compact ? -17 : -22;
        var titleShiftY = compact ? -18 : -16;
        var titleEndScale = small ? 0.52 : compact ? 0.56 : 0.6;
        var portraitShiftX = small ? 0 : compact ? 6 : 18;
        var portraitShiftY = small ? -28 : compact ? -31 : -3;
        var portraitEndScale = small ? 0.45 : compact ? 0.4 : 0.76;

        activeTitle.style.transform = `translate3d(calc(-50% + ${titleShiftX * progress - pointerX * 0.22}vw), calc(-50% + ${titleShiftY * progress - pointerY * 0.1}vh), -80px) scale(${1 - progress * (1 - titleEndScale)})`;
        activePortrait.style.transform = `translate3d(calc(-50% + ${portraitShiftX * progress + pointerX * 0.65}vw), ${portraitShiftY * progress + pointerY * 0.25}vh, 110px) rotateX(${pointerY * -1.35}deg) rotateY(${pointerX * 1.8 - progress * 1.25}deg) scale(${1 - progress * (1 - portraitEndScale)})`;
        if (pointerOnly) return;

        activeTitle.style.opacity = `${1 - progress * 0.06}`;
        activePortal.style.transform = `translate3d(${(1 - reveal) * (compact ? 42 : 30)}vw, ${(1 - reveal) * 5}rem, -20px)`;
        activePortal.style.opacity = `${reveal}`;
        activePortal.style.pointerEvents = reveal > 0.72 ? "auto" : "none";
      }

      function scheduleRender(pointerOnly: boolean) {
        if (scrollAnimation) return;
        if (frame !== undefined) {
          if (!pointerOnly) pointerOnlyFrame = false;
          return;
        }
        pointerOnlyFrame = pointerOnly;
        frame = requestAnimationFrame(() => render(pointerOnlyFrame));
      }

      function requestRender() {
        scheduleRender(false);
      }

      function requestPointerRender() {
        scheduleRender(true);
      }

      function animateTo(target: number) {
        target = clamp(target, 0, 1);
        if (stateTarget !== null && Math.abs(stateTarget - target) < 0.001) return;
        if (stateTarget === null && Math.abs(progressValue - target) < 0.001) return;
        scrollAnimation?.stop();
        scrollAnimation = undefined;
        if (Math.abs(progressValue - target) < 0.001) {
          progressValue = target;
          stateTarget = null;
          render();
          return;
        }
        if (reduceMotion) {
          progressValue = target;
          render();
          stateTarget = null;
          return;
        }

        stateTarget = target;
        var start = progressValue;
        var distance = Math.abs(target - start);
        var duration = clamp(0.62 + distance * 0.22, 0.62, 0.84);
        var animation = animate(start, target, {
          duration,
          ease: [0.22, 1, 0.36, 1],
          onUpdate: function (value) {
            progressValue = value;
            render();
          },
        });
        scrollAnimation = animation;
        animation.finished.then(function () {
          if (scrollAnimation === animation) {
            scrollAnimation = undefined;
            progressValue = target;
            stateTarget = null;
            render();
          }
        }).catch(function () {});
      }

      function onWheel(event: WheelEvent) {
        if (Math.abs(event.deltaY) < 2) return;
        event.preventDefault();
        animateTo(event.deltaY > 0 ? 1 : 0);
      }

      function onTouchStart(event: TouchEvent) {
        touchStartY = event.touches[0]?.clientY || 0;
      }

      function onTouchEnd(event: TouchEvent) {
        var endY = event.changedTouches[0]?.clientY || touchStartY;
        var delta = touchStartY - endY;
        if (Math.abs(delta) >= 18) animateTo(delta > 0 ? 1 : 0);
      }

      function onKeydown(event: KeyboardEvent) {
        var target = event.target instanceof HTMLElement ? event.target : null;
        if (target && (target.matches("input, textarea, select, button") || target.isContentEditable)) return;
        if (event.key === "ArrowDown" || event.key === "PageDown" || event.key === " ") {
          event.preventDefault();
          animateTo(1);
        } else if (event.key === "ArrowUp" || event.key === "PageUp") {
          event.preventDefault();
          animateTo(0);
        }
      }

      function onPointerMove(event: PointerEvent) {
        if (reduceMotion || event.pointerType === "touch") return;
        pointerX = clamp((event.clientX / window.innerWidth - 0.5) * 2, -1, 1);
        pointerY = clamp((event.clientY / window.innerHeight - 0.5) * 2, -1, 1);
        requestPointerRender();
      }

      function onPointerLeave() {
        pointerX = 0;
        pointerY = 0;
        requestPointerRender();
      }

      function onClick(event: MouseEvent) {
        var target = event.target instanceof Element ? event.target : null;
        if (target && target.closest("a, button, input, textarea, select, [contenteditable]")) return;
        if (progressValue < 0.5) animateTo(1);
      }

      window.addEventListener("resize", requestRender, { passive: true, signal: controller.signal });
      window.addEventListener("wheel", onWheel, { passive: false, signal: controller.signal });
      window.addEventListener("touchstart", onTouchStart, { passive: true, signal: controller.signal });
      window.addEventListener("touchend", onTouchEnd, { passive: true, signal: controller.signal });
      window.addEventListener("keydown", onKeydown, { signal: controller.signal });
      window.addEventListener("pointermove", onPointerMove, { passive: true, signal: controller.signal });
      document.documentElement.addEventListener("pointerleave", onPointerLeave, { signal: controller.signal });
      hero.addEventListener("click", onClick, { signal: controller.signal });

      this.dispose = () => {
        controller.abort();
        if (frame !== undefined) cancelAnimationFrame(frame);
        scrollAnimation?.stop();
        frame = undefined;
        scrollAnimation = undefined;
        stateTarget = null;
        this.dispose = undefined;
      };

      render();
    }

    disconnectedCallback() {
      this.dispose?.();
    }
  }

  if (!customElements.get("home-hero")) {
    customElements.define("home-hero", HomeHero);
  }
</script>

<style>
  :global(html[data-page="home"]),
  :global(html[data-page="home"] body) {
    width: 100%;
    height: 100vh;
    height: 100svh;
    min-height: 100vh;
    min-height: 100svh;
    max-height: 100vh;
    max-height: 100svh;
    overflow: hidden;
    overscroll-behavior: none;
    background: var(--color-bg-page);
  }

  :global(html[data-page="home"] .content-area),
  :global(html[data-page="home"] main) {
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    background: var(--color-bg-page);
  }

  .home {
    display: block;
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: clip;
    background: var(--color-bg-page);
  }

  .hero-shell {
    position: relative;
    height: 100%;
  }

  .hero-stage {
    --title-x: 0vw;
    --title-y: 0vh;
    --title-scale: 1;
    --title-opacity: 1;
    --portrait-x: 0vw;
    --portrait-y: 0vh;
    --portrait-scale: 1;
    --portrait-rotate-x: 0deg;
    --portrait-rotate-y: 0deg;
    --portal-x: 0vw;
    --portal-y: 0rem;
    --portal-opacity: 1;
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    perspective: 1200px;
    isolation: isolate;
  }

  .identity {
    position: absolute;
    z-index: 1;
    top: 47%;
    left: 50%;
    width: max-content;
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-editorial);
    font-size: clamp(8rem, 16.5vw, 20rem);
    font-weight: 400;
    line-height: 0.82;
    letter-spacing: -0.065em;
    white-space: nowrap;
    opacity: var(--title-opacity);
    text-align: center;
    transform:
      translate3d(calc(-50% + var(--title-x)), calc(-50% + var(--title-y)), -80px)
      scale(var(--title-scale));
    transform-origin: center;
    will-change: transform, opacity;
  }

  .portrait {
    position: absolute;
    z-index: 3;
    left: 57.5%;
    /* 让伞顶完整进入画面，同时保持人物原有尺度。 */
    bottom: -22svh;
    width: 97.65svh;
    height: 122svh;
    transform:
      translate3d(calc(-50% + var(--portrait-x)), var(--portrait-y), 110px)
      rotateX(var(--portrait-rotate-x))
      rotateY(var(--portrait-rotate-y))
      scale(var(--portrait-scale));
    transform-origin: 56% 100%;
    transform-style: preserve-3d;
    filter:
      saturate(0.9)
      contrast(1.02)
      drop-shadow(0 2rem 3rem rgba(0, 8, 20, 0.16));
    pointer-events: none;
    will-change: transform;
  }

  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    user-select: none;
  }

  .portal {
    position: absolute;
    z-index: 4;
    left: clamp(1.25rem, 5vw, 6rem);
    bottom: clamp(2rem, 7svh, 5.5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(8rem, 1fr));
    column-gap: clamp(1.5rem, 3vw, 3.5rem);
    width: min(44vw, 39rem);
    opacity: var(--portal-opacity);
    transform: translate3d(var(--portal-x), var(--portal-y), -20px);
    will-change: transform, opacity;
  }

  .portal-link {
    display: block;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.15vw, 1.1rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .portal-link:hover,
  .portal-link:focus-visible {
    color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  .portal:focus-within {
    opacity: 1 !important;
    transform: translate3d(0, 0, -20px) !important;
    pointer-events: auto !important;
  }

  /* <home-hero> 升级前（见 BaseLayout 的 data-hero 标记）先画出收起态：
     取值与 render() 在 progress = 0 时写入的导航变换一致。 */
  :global(html[data-hero="pending"]) .hero-stage {
    --portal-x: 30vw;
    --portal-y: 5rem;
    --portal-opacity: 0;
  }

  :global(html[data-hero="pending"]) .portal {
    pointer-events: none;
  }

  .portal-link:focus-visible {
    outline: 1px solid var(--color-accent-hover);
    outline-offset: 0.35rem;
  }

  @media (max-width: 900px) {
    .identity {
      top: 42%;
      font-size: clamp(6rem, 19vw, 11rem);
    }

    .portrait {
      bottom: -16svh;
      width: 92.75svh;
      height: 116svh;
    }

    .portal {
      left: 1.25rem;
      right: auto;
      bottom: max(2rem, calc(1.25rem + env(safe-area-inset-bottom, 0px)));
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
      width: min(54vw, 25rem);
    }

    .portal-link {
      font-size: 1rem;
    }

    :global(html[data-hero="pending"]) .hero-stage {
      --portal-x: 42vw;
    }
  }

  @media (max-width: 520px) {
    .identity {
      top: 40%;
      font-size: 19.5vw;
      letter-spacing: -0.072em;
    }

    .portrait {
      bottom: -3svh;
      width: 76.95svh;
      height: 96svh;
    }

    .portal {
      width: calc(58vw - 1.25rem);
      column-gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portal-link {
      transition: none;
    }
  }
</style>
