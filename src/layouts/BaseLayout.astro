---
import type { UIStrings } from "../types/i18n";

import { ui as zh } from "../i18n/zh";
import { ui as en } from "../i18n/en";
import Sidebar from "../components/Sidebar.astro";
import VinylPlayer from "../components/VinylPlayer.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";
import { getFlatTracks } from "../data/playlist";

import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const { title, description, hideHeader = false, hideFooter = false } = Astro.props;
const lang = Astro.currentLocale || "zh";
const t: UIStrings = lang === "zh" ? zh : en;
const pageTitle = title ? `${title} — ${t.site.title}` : t.site.title;
const pageDescription = description || t.site.description;

const flatTracksJson = JSON.stringify(getFlatTracks());
const r2Base = "https://cdn.doebkblcya.com/music";

// ── 页面切换过渡:方向感知 slide+fade(Astro 编译为 ::view-transition-* 动画) ──
// 前进:新页自右 24px 滑入、旧页向左滑出;后退镜像。keyframes 定义见本文件 <style is:global>。
// persist 元素(sidebar/vinyl/audio)有独立 view-transition-name,不参与 root 动画。
// 类型由 transition:animate 指令属性结构性检查(astro:transitions 未导出类型名)。
const vtTransition = {
  forwards: {
    old: { name: "vt-out-forward", duration: 0.28, easing: "cubic-bezier(0.4, 0, 0.2, 1)", fillMode: "both" },
    new: { name: "vt-in-forward", duration: 0.38, easing: "cubic-bezier(0.16, 1, 0.3, 1)", fillMode: "both" },
  },
  backwards: {
    old: { name: "vt-out-backward", duration: 0.28, easing: "cubic-bezier(0.4, 0, 0.2, 1)", fillMode: "both" },
    new: { name: "vt-in-backward", duration: 0.38, easing: "cubic-bezier(0.16, 1, 0.3, 1)", fillMode: "both" },
  },
};
---

<!doctype html>
<html lang={lang} transition:animate={vtTransition}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- SEO:canonical 防重复收录;og 基础 meta(无图,分享卡片显示标题+描述) -->
    <link rel="canonical" href={Astro.url.origin + Astro.url.pathname} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={Astro.url.origin + Astro.url.pathname} />
    <meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"} />
    <!-- Theme bootstrap — FOUC 防护：首帧渲染前同步设置 html[data-theme]。
         只读 localStorage + matchMedia，幂等，VT 下重复执行无害。
         localStorage key 与 __vt_setTheme 保持一致（见 CLAUDE.md 约定）。 -->
    <script is:inline>
      (function () {
        var key = "doebk-theme";
        var stored = null;
        try {
          stored = localStorage.getItem(key);
        } catch (e) {}
        var mode = stored === "light" || stored === "dark" ? stored : "auto";
        var theme =
          mode === "auto"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : mode;
        var doc = document.documentElement;
        doc.setAttribute("data-theme", theme);
        doc.setAttribute("data-theme-mode", mode);
        var meta = document.createElement("meta");
        meta.name = "theme-color";
        meta.content = theme === "dark" ? "#000000" : "#f5f5f7";
        document.head.appendChild(meta);
      })();
    </script>
    <ViewTransitions />
  </head>
  <body class={!hideHeader ? "has-sidebar" : ""}>
    <a class="skip-link" href="#main-content">
      {t.common.skipToContent}
    </a>
    <!-- Shared audio element — persisted across page navigations -->
    <audio id="audio" preload="none" data-astro-transition-persist="audio"></audio>
    <VinylPlayer flatTracks={flatTracksJson} r2Base={r2Base} />
    <Sidebar t={t} currentPath={Astro.url.pathname} />
    <div class="content-area">
      <main id="main-content" data-pagefind-body>
        <slot />
      </main>
      {!hideFooter && <Footer t={t} />}
    </div>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    z-index: 1000;
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent);
    color: var(--color-text-on-accent);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
    transition: top var(--duration-fast);
  }

  .skip-link:focus {
    top: var(--space-2);
  }

  :root {
    --sidebar-width: 7.5rem;
  }

  .has-sidebar .content-area {
    margin-left: var(--sidebar-width);
  }

  @media (max-width: 640px) {
    .has-sidebar .content-area {
      margin-left: 0;
      margin-right: 0;
      transition: none;
    }
  }

  /* ── 页面切换过渡 keyframes(vtTransition 引用,见 frontmatter) ──
     reduced-motion:覆盖为无动画(过渡由 Astro 注入,显式禁用避免位移) */
  @keyframes vt-in-forward {
    from { opacity: 0; transform: translateX(24px); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes vt-out-forward {
    from { opacity: 1; transform: translateX(0); }
    to { opacity: 0; transform: translateX(-16px); }
  }
  @keyframes vt-in-backward {
    from { opacity: 0; transform: translateX(-24px); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes vt-out-backward {
    from { opacity: 1; transform: translateX(0); }
    to { opacity: 0; transform: translateX(16px); }
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none !important;
    }
  }
</style>

<style is:global>
  /* Hide sidebar on home page — kept in DOM for View Transition persistence */
  body:not(.has-sidebar) .sidebar {
    display: none;
  }
</style>
