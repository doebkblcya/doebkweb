---
import type { UIStrings } from "../types/i18n";

import { ui as zh } from "../i18n/zh";
import { ui as en } from "../i18n/en";
import Sidebar from "../components/Sidebar.astro";
import VinylPlayer from "../components/VinylPlayer.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { getFlatTracks } from "../data/playlist";

import "@fontsource-variable/newsreader/wght.css";
import "@fontsource-variable/hanken-grotesk/wght.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@fontsource-variable/noto-sans-sc/wght.css";
import "@fontsource-variable/noto-serif-sc/wght.css";

import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const { title, description, hideHeader = false, hideFooter = false } = Astro.props;
const lang = Astro.currentLocale || "zh";
const t: UIStrings = lang === "zh" ? zh : en;
const pageTitle = title ? `${title} — ${t.site.title}` : t.site.title;
const pageDescription = description || t.site.description;

const flatTracksJson = JSON.stringify(getFlatTracks());
const r2Base = "https://cdn.doebkblcya.com/music";

---

<!doctype html>
<html lang={lang} data-page={hideHeader ? "home" : "inner"} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- SEO:canonical 防重复收录;og 基础 meta(无图,分享卡片显示标题+描述) -->
    <link rel="canonical" href={Astro.url.origin + Astro.url.pathname} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={Astro.url.origin + Astro.url.pathname} />
    <meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"} />
    <!-- Theme bootstrap — FOUC 防护：首帧渲染前同步设置 html[data-theme]。
         只读 localStorage + matchMedia，幂等，VT 下重复执行无害。
         localStorage key 与 __vt_setTheme 保持一致（见 AGENT.md 约定）。 -->
    <script is:inline>
      (function () {
        var key = "doebk-theme";
        var stored = null;
        try {
          stored = localStorage.getItem(key);
        } catch (e) {}
        var mode = stored === "light" || stored === "dark" ? stored : "auto";
        var theme =
          mode === "auto"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : mode;
        var doc = document.documentElement;
        doc.setAttribute("data-theme", theme);
        doc.setAttribute("data-theme-mode", mode);
        var meta = document.createElement("meta");
        meta.name = "theme-color";
        meta.content = doc.dataset.page === "home" ? "#06182d" : theme === "dark" ? "#000000" : "#fcfcfd";
        document.head.appendChild(meta);
      })();
    </script>
    <!-- 首页首帧防闪：模块脚本是 deferred 的，首帧可能早于 <home-hero> 升级。
         这里在解析期先把首页标记为“导航还在终态之外”，让 CSS 直接画出收起态；
         index.astro 的 render() 接管后该标记即失效。
         reduced-motion 要求直接呈现可操作终态，因此不设置标记；
         模块脚本若加载失败，deferred 脚本全部结束后由 DOMContentLoaded 兜底恢复终态。 -->
    {hideHeader && (
      <script is:inline>
        (function () {
          var doc = document.documentElement;
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          doc.dataset.hero = "pending";
          window.addEventListener("DOMContentLoaded", function () {
            if (doc.dataset.hero === "pending") delete doc.dataset.hero;
          });
        })();
      </script>
    )}
    <!-- ClientRouter 只承担客户端导航与跨页播放器持久化；页面自身管理自己的动效。 -->
    <ClientRouter fallback="swap" />
  </head>
  <body class={!hideHeader ? "has-sidebar" : ""}>
    <a class="skip-link" href="#main-content">
      {t.common.skipToContent}
    </a>
    <!-- Shared audio element — persisted across page navigations -->
    <audio id="audio" preload="none" data-astro-transition-persist="audio"></audio>
    <VinylPlayer flatTracks={flatTracksJson} r2Base={r2Base} />
    <Sidebar t={t} currentPath={Astro.url.pathname} />
    <div class="content-area">
      <main id="main-content" data-pagefind-body>
        <slot />
      </main>
      {!hideFooter && <Footer t={t} />}
    </div>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    z-index: 1000;
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent);
    color: var(--color-text-on-accent);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
    transition: top var(--duration-fast);
  }

  .skip-link:focus {
    top: var(--space-2);
  }

  :root {
    --sidebar-width: 11rem;
  }

  .has-sidebar .content-area {
    margin-left: var(--sidebar-width);
  }

  @media (max-width: 640px) {
    .has-sidebar .content-area {
      margin-left: 0;
      margin-right: 0;
      transition: none;
    }
  }

</style>

<style is:global>
  /* 首页沿用共享布局，但不显示站内页侧栏。 */
  body:not(.has-sidebar) .sidebar {
    display: none;
  }
</style>
